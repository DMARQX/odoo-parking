<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="parking_contract_tree" model="ir.ui.view">
        <field name="name">parking.contract.tree</field>
        <field name="model">parking.contract</field>
        <field name="arch" type="xml">
            <list decoration-muted="state in ('expired', 'cancelled')"
                  decoration-warning="is_expiring_soon"
                  decoration-info="state == 'draft'">
                <field name="is_expiring_soon" column_invisible="1"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="vehicle_ids" widget="many2many_tags" optional="show"/>
                <field name="spot_id"/>
                <field name="location_id" optional="show"/>
                <field name="subscription_type" optional="hide"/>
                <field name="start_date" optional="show"/>
                <field name="end_date"/>
                <field name="days_remaining" optional="show"
                       decoration-danger="days_remaining &lt; 0"
                       decoration-warning="days_remaining &gt;= 0 and days_remaining &lt;= 7"/>
                <field name="amount_total" widget="monetary" sum="Total"/>
                <field name="amount_due" widget="monetary" sum="Due" optional="show"
                       groups="parking_management.group_parking_invoicing"/>
                <field name="invoice_status" widget="badge" optional="show"
                       decoration-success="invoice_status == 'paid'"
                       decoration-warning="invoice_status == 'to_invoice'"
                       decoration-info="invoice_status == 'invoiced'"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-info="state == 'confirmed'"
                       decoration-danger="state == 'cancelled'"
                       decoration-muted="state == 'expired'"/>
                <field name="user_id" optional="hide" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <record id="parking_contract_kanban" model="ir.ui.view">
        <field name="name">parking.contract.kanban</field>
        <field name="model">parking.contract</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" sample="1" quick_create="false"
                    group_create="false" group_delete="false" group_edit="false" records_draggable="false">
                <field name="state"/>
                <field name="is_expiring_soon"/>
                <field name="days_remaining"/>
                <field name="company_currency_id"/>
                <templates>
                    <t t-name="card">
                        <div class="d-flex justify-content-between">
                            <field name="name" class="fw-bold"/>
                            <field name="invoice_status" widget="badge"
                                   decoration-success="invoice_status == 'paid'"
                                   decoration-warning="invoice_status == 'to_invoice'"/>
                        </div>
                        <field name="partner_id" class="fw-bold"/>
                        <div class="text-muted small">
                            <i class="fa fa-map-marker me-1" title="Spot"/><field name="spot_id"/>
                        </div>
                        <field name="vehicle_ids" widget="many2many_tags"/>
                        <div class="d-flex justify-content-between align-items-center mt-1">
                            <field name="amount_total" widget="monetary"/>
                            <span t-if="record.state.raw_value in ['active', 'confirmed']"
                                  t-attf-class="badge #{record.days_remaining.raw_value &lt; 0 ? 'text-bg-danger' : (record.is_expiring_soon.raw_value ? 'text-bg-warning' : 'text-bg-light')}">
                                <t t-esc="record.days_remaining.raw_value"/> d
                            </span>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>


    <record id="parking_contract_form" model="ir.ui.view">
        <field name="name">parking.contract.form</field>
        <field name="model">parking.contract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"
                            invisible="state != 'draft'" groups="parking_management.group_parking_contract"/>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary"
                            invisible="state != 'confirmed'" groups="parking_management.group_parking_contract"/>
                    <button name="action_sign" string="Sign Contract" type="object" class="btn-success"
                            invisible="state not in ('draft', 'confirmed') or signature_date"
                            groups="parking_management.group_parking_contract"/>
                    <button name="action_create_invoice" string="Create Invoice" type="object" class="btn-primary"
                            invisible="state not in ('confirmed', 'active')"
                            groups="parking_management.group_parking_invoicing"/>
                    <button name="action_register_payment" string="Register Payment" type="object" class="btn-primary"
                            invisible="invoice_status != 'invoiced'"
                            groups="parking_management.group_parking_invoicing"/>
                    <button name="action_add_charge" string="Sell / Add Charge" type="object" icon="fa-shopping-cart"
                            class="btn-secondary" invisible="state not in ('confirmed', 'active')"
                            groups="parking_management.group_parking_contract,parking_management.group_parking_checkinout"/>
                    <button name="action_add_washes" string="Add Washes" type="object" icon="fa-tint"
                            class="btn-secondary" invisible="state not in ('confirmed', 'active')"
                            groups="parking_management.group_parking_contract,parking_management.group_parking_checkinout"/>
                    <button name="action_bill_remaining_term" string="Bill Remaining Term" type="object" icon="fa-calendar-check-o"
                            class="btn-secondary"
                            invisible="state not in ('confirmed', 'active') or subscription_type == 'daily' or prepaid_until"
                            groups="parking_management.group_parking_invoicing"/>
                    <button name="action_renew" string="Renew" type="object" icon="fa-refresh"
                            class="btn-secondary" invisible="state not in ('active', 'expired')"
                            groups="parking_management.group_parking_contract"/>
                    <button name="%(action_report_parking_contract)d" string="Print" type="action"
                            icon="fa-print" class="btn-secondary"/>
                    <button name="action_expire" string="Expire" type="object" class="btn-warning"
                            invisible="state not in ('confirmed', 'active')"
                            confirm="Expire this contract and release the spot?"
                            groups="parking_management.group_parking_contract"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state not in ('draft', 'confirmed', 'active')"
                            confirm="Cancel this contract?"
                            groups="parking_management.group_parking_contract"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,active,expired"/>
                </header>
                <div class="alert alert-warning mb-0 text-center" role="alert" invisible="not is_expiring_soon">
                    <i class="fa fa-clock-o me-1" title="Expiring soon"/>
                    This contract ends in <field name="days_remaining" class="fw-bold"/> day(s).
                    Use <strong>Renew</strong> to prepare the next term.
                </div>
                <div class="alert alert-danger mb-0 text-center" role="alert"
                     invisible="state not in ('active', 'confirmed') or days_remaining &gt;= 0">
                    <i class="fa fa-exclamation-triangle me-1" title="Overdue"/>
                    The end date has passed; the contract will be expired automatically.
                </div>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_movements" type="object" class="oe_stat_button" icon="fa-exchange">
                            <field name="movement_count" widget="statinfo" string="Movements"/>
                        </button>
                        <button name="action_view_washes" type="object" class="oe_stat_button" icon="fa-tint">
                            <field name="wash_count" widget="statinfo" string="Washes"/>
                        </button>
                        <button name="action_view_invoices" type="object" class="oe_stat_button" icon="fa-file-text-o"
                                groups="parking_management.group_parking_invoicing">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-secondary" invisible="state != 'expired'"/>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                    <field name="is_expiring_soon" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>
                    <field name="deposit_invoiced" invisible="1"/>
                    <field name="invoice_status" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Customer &amp; Vehicles">
                            <field name="partner_id" widget="res_partner_many2one"
                                   context="{'res_partner_search_mode': 'customer', 'show_vat': True}"
                                   readonly="state in ('expired', 'cancelled')"/>
                            <field name="vehicle_ids" widget="many2many_tags"
                                   context="{'default_owner_id': partner_id}"
                                   readonly="state in ('expired', 'cancelled')"/>
                            <field name="vehicle_details" readonly="1" invisible="not vehicle_ids"/>
                            <field name="user_id" widget="many2one_avatar_user"/>
                        </group>
                        <group string="Spot &amp; Period">
                            <field name="spot_id" options="{'no_create': True}"
                                   readonly="state in ('active', 'expired', 'cancelled')"/>
                            <field name="location_id"/>
                            <field name="subscription_type" readonly="state in ('expired', 'cancelled')"/>
                            <label for="start_date" string="Period"/>
                            <div class="o_row">
                                <field name="start_date" readonly="state in ('expired', 'cancelled')"/>
                                <i class="fa fa-long-arrow-right mx-2" title="to"/>
                                <field name="end_date" readonly="state in ('expired', 'cancelled')"/>
                            </div>
                            <field name="booking_days"/>
                            <field name="days_remaining" invisible="state not in ('active', 'confirmed')"/>
                            <field name="renewed_from_id" invisible="not renewed_from_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="pricing" string="Pricing &amp; Invoicing">
                            <group>
                                <group string="Pricing">
                                    <field name="price_tmpl_id" options="{'no_create': True}"/>
                                    <field name="price_per_day" widget="monetary" invisible="subscription_type != 'daily'"/>
                                    <field name="price_per_month" widget="monetary" invisible="subscription_type == 'daily'"/>
                                    <field name="tax_ids" widget="many2many_tags" options="{'no_create': True}"/>
                                    <field name="deposit_amount" widget="monetary"/>
                                </group>
                                <group string="Invoicing">
                                    <field name="auto_invoice"/>
                                    <field name="invoice_period" invisible="not auto_invoice" required="auto_invoice"/>
                                    <field name="parking_product_id" options="{'no_create': True}"/>
                                    <field name="payment_term_id" options="{'no_create': True}"/>
                                    <field name="recurring_next_date" invisible="not auto_invoice or prepaid_until"/>
                                    <field name="prepaid_until" invisible="not prepaid_until"/>
                                    <field name="last_invoiced_date"/>
                                    <field name="amount_due" widget="monetary"
                                           groups="parking_management.group_parking_invoicing"/>
                                </group>
                            </group>
                        </page>
                        <page name="services" string="Services">
                            <field name="service_line_ids" readonly="state in ('expired', 'cancelled')">
                                <list editable="bottom" decoration-muted="invoice_id">
                                    <field name="service_id" options="{'no_create': True}"/>
                                    <field name="product_id" optional="hide"/>
                                    <field name="billing_type"/>
                                    <field name="quantity"/>
                                    <field name="price_unit" widget="monetary"/>
                                    <field name="price_subtotal" widget="monetary" sum="Total"/>
                                    <field name="invoice_id" readonly="1" optional="show"
                                           groups="parking_management.group_parking_invoicing"/>
                                    <field name="company_currency_id" column_invisible="1"/>
                                </list>
                            </field>
                            <div class="text-muted small mt-2">
                                "Every invoice" lines are billed with each subscription invoice; "Once" lines on the next invoice only.
                                To sell a product on its own invoice use <strong>Sell / Add Charge</strong>.
                            </div>
                        </page>
                        <page name="washes" string="Car Washes">
                            <group>
                                <group>
                                    <field name="free_wash_count"/>
                                    <field name="wash_interval_days"/>
                                </group>
                                <group>
                                    <field name="washes_credited"/>
                                    <field name="washes_used"/>
                                    <field name="remaining_washes" class="fw-bold"/>
                                </group>
                            </group>
                            <separator string="Wash Balance History"/>
                            <field name="wash_credit_ids" readonly="1">
                                <list>
                                    <field name="date"/>
                                    <field name="kind" widget="badge"
                                           decoration-success="quantity &gt; 0" decoration-danger="quantity &lt; 0"/>
                                    <field name="quantity" sum="Total"/>
                                    <field name="invoice_id" groups="parking_management.group_parking_invoicing"/>
                                    <field name="note"/>
                                </list>
                            </field>
                            <separator string="Washes Done"/>
                            <field name="wash_ids" readonly="1">
                                <list>
                                    <field name="wash_date"/>
                                    <field name="vehicle_id"/>
                                    <field name="washed_by"/>
                                    <field name="wash_number"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'"
                                           decoration-muted="state == 'cancelled'"/>
                                </list>
                            </field>
                        </page>
                        <page name="statement" string="Account Statement"
                              groups="parking_management.group_parking_invoicing">
                            <div class="mb-2">
                                <button name="action_print_statement" type="object" string="Print Statement"
                                        icon="fa-print" class="btn-secondary"/>
                                <button name="action_register_payment" type="object" string="Register Payment"
                                        icon="fa-money" class="btn-link" invisible="amount_due &lt;= 0"/>
                            </div>
                            <field name="statement_html" nolabel="1" readonly="1"/>
                        </page>
                        <page name="terms" string="Terms &amp; Signatures">
                            <group>
                                <field name="terms_id" options="{'no_create': True}"/>
                            </group>
                            <field name="terms_conditions" widget="html"/>
                            <group string="Signatures">
                                <group>
                                    <field name="customer_signature" widget="signature"/>
                                    <field name="signature_date"/>
                                </group>
                                <group>
                                    <field name="authorized_signature" widget="signature"/>
                                </group>
                            </group>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="notes" placeholder="Internal notes about this contract..."/>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer">
                        <field name="services_total" widget="monetary"/>
                        <field name="amount_total" widget="monetary" class="oe_subtotal_footer_separator"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="parking_contract_search" model="ir.ui.view">
        <field name="name">parking.contract.search</field>
        <field name="model">parking.contract</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', ('name', 'ilike', self), ('partner_id', 'ilike', self)]"
                       string="Contract / Customer"/>
                <field name="vehicle_ids" string="Vehicle / Plate"/>
                <field name="partner_id"/>
                <field name="spot_id"/>
                <field name="location_id"/>
                <field name="user_id"/>
                <filter name="draft_contracts" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed_contracts" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="active_contracts" string="Active" domain="[('state','=','active')]"/>
                <separator/>
                <filter name="expiring_soon" string="Expiring within 7 days" domain="[('is_expiring_soon', '=', True)]"/>
                <filter name="expiring_30" string="Expiring within 30 days"
                        domain="[('state', 'in', ('active', 'confirmed')), ('end_date', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter name="overdue_end" string="Past end date"
                        domain="[('state', 'in', ('active', 'confirmed')), ('end_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter name="auto_invoice_filter" string="Auto Invoice" domain="[('auto_invoice','=',True)]"/>
                <filter name="unpaid_filter" string="Unpaid" domain="[('invoice_status','in',('to_invoice','invoiced'))]"/>
                <filter name="my_contracts" string="My Contracts" domain="[('user_id', '=', uid)]"/>
                <separator/>
                <filter name="filter_start_date" string="Start Date" date="start_date"/>
                <filter name="filter_end_date" string="End Date" date="end_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_location" string="Branch" context="{'group_by':'location_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
                    <filter name="group_partner" string="Customer" context="{'group_by':'partner_id'}"/>
                    <filter name="group_user" string="Employee" context="{'group_by':'user_id'}"/>
                    <filter name="group_end_month" string="End Month" context="{'group_by':'end_date:month'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
