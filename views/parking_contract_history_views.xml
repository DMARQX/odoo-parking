<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_parking_contract_invoices" model="ir.actions.act_window">
        <field name="name">Contract Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_partner': 1}</field>
        <field name="domain">[('parking_contract_id', '!=', False)]</field>
    </record>

    <record id="action_parking_spot_status_log" model="ir.actions.act_window">
        <field name="name">Status Log</field>
        <field name="res_model">parking.spot.status.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>