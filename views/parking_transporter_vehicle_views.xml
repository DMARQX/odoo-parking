<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="parking_transporter_vehicle_tree" model="ir.ui.view">
        <field name="name">parking.transporter.vehicle.tree</field>
        <field name="model">parking.transporter.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="license_plate"/>
                <field name="vehicle_type"/>
                <field name="driver_id"/>
                <field name="company_name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="parking_transporter_vehicle_form" model="ir.ui.view">
        <field name="name">parking.transporter.vehicle.form</field>
        <field name="model">parking.transporter.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Vehicle Info">
                            <field name="license_plate" required="1"/>
                            <field name="vehicle_type"/>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="color"/>
                        </group>
                        <group string="Company &amp; Driver">
                            <field name="company_name"/>
                            <field name="company_phone"/>
                            <field name="driver_id"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="parking_transporter_vehicle_search" model="ir.ui.view">
        <field name="name">parking.transporter.vehicle.search</field>
        <field name="model">parking.transporter.vehicle</field>
        <field name="arch" type="xml">
            <search>
                <field name="license_plate"/>
                <field name="vehicle_type"/>
                <field name="company_name"/>
                <field name="driver_id"/>
                <filter name="active" string="Active" domain="[('active', '=', True)]"/>
                <filter name="inactive" string="Inactive" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_parking_transporter_vehicle" model="ir.actions.act_window">
        <field name="name">Transporter Vehicles</field>
        <field name="res_model">parking.transporter.vehicle</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="parking_transporter_vehicle_search"/>
        <field name="help">Manage transporter vehicles used for vehicle transfers.</field>
    </record>

    <menuitem id="menu_parking_transporter_vehicle"
        name="Transporter Vehicles"
        parent="menu_parking_config"
        action="action_parking_transporter_vehicle"
        sequence="45"/>

</odoo>
