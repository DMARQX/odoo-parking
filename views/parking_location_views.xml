<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="parking_location_tree" model="ir.ui.view">
        <field name="name">parking.location.tree</field>
        <field name="model">parking.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="city"/>
                <field name="phone"/>
                <field name="manager_id"/>
                <field name="available_count"/>
                <field name="spot_count"/>
            </list>
        </field>
    </record>
    <record id="parking_location_form" model="ir.ui.view">
        <field name="name">parking.location.form</field>
        <field name="model">parking.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="name"/>
                            <field name="city"/>
                            <field name="address"/>
                            <field name="phone"/>
                        </group>
                        <group>
                            <field name="manager_id"/>
                            <field name="spot_count"/>
                            <field name="available_count"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="spots" string="Spots">
                            <field name="spot_ids">
                                <list>
                                    <field name="sequence" optional="show"/>
                                    <field name="name"/>
                                    <field name="spot_type"/>
                                    <field name="status"/>
                                    <field name="floor"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="parking_location_search" model="ir.ui.view">
        <field name="name">parking.location.search</field>
        <field name="model">parking.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
            </search>
        </field>
    </record>
</odoo>
