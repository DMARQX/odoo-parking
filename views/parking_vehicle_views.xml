<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="parking_vehicle_tree" model="ir.ui.view">
        <field name="name">parking.vehicle.tree</field>
        <field name="model">parking.vehicle</field>
        <field name="arch" type="xml">
            <list>
                <field name="license_plate"/>
                <field name="brand"/>
                <field name="model"/>
                <field name="color"/>
                <field name="owner_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="parking_vehicle_form" model="ir.ui.view">
        <field name="name">parking.vehicle.form</field>
        <field name="model">parking.vehicle</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <header>
                        <button name="action_register_wash" string="Car Wash" type="object" class="btn-primary"
                                invisible="wash_count == 0"/>
                    </header>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_inspections" type="object" class="oe_stat_button"
                            icon="fa-check-circle" help="Inspections">
                            <div class="o_stat_info">
                                <field name="inspection_count"/>
                                <span class="o_stat_text">Inspections</span>
                            </div>
                        </button>
                        <button name="action_open_movements" type="object" class="oe_stat_button"
                            icon="fa-exchange" help="Movements">
                            <div class="o_stat_info">
                                <field name="movement_count"/>
                                <span class="o_stat_text">Movements</span>
                            </div>
                        </button>
                        <button name="action_open_transfers" type="object" class="oe_stat_button"
                            icon="fa-truck" help="Transfers">
                            <div class="o_stat_info">
                                <field name="transfer_count"/>
                                <span class="o_stat_text">Transfers</span>
                            </div>
                        </button>
                    </div>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="license_plate"/>
                            <field name="brand"/>
                            <field name="model"/>
                        </group>
                        <group>
                            <field name="color"/>
                            <field name="year"/>
                            <field name="owner_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="images" string="Images">
                            <group>
                                <group string="Front">
                                    <field name="image_front" widget="image"/>
                                </group>
                                <group string="Rear">
                                    <field name="image_back" widget="image"/>
                                </group>
                            </group>
                            <group>
                                <group string="Left Side">
                                    <field name="image_left" widget="image"/>
                                </group>
                                <group string="Right Side">
                                    <field name="image_right" widget="image"/>
                                </group>
                            </group>
                            <group>
                                <group string="Interior">
                                    <field name="image_interior" widget="image"/>
                                </group>
                            </group>
                            <group>
                                <group string="License Document">
                                    <field name="image_license_doc" widget="image"/>
                                </group>
                                <group string="Owner ID">
                                    <field name="image_owner_id_doc" widget="image"/>
                                </group>
                            </group>
                        </page>
                        <page name="movements" string="Movements">
                            <field name="movement_ids">
                                <list>
                                    <field name="spot_id"/>
                                    <field name="check_out_time"/>
                                    <field name="check_in_time"/>
                                    <field name="duration_hours"/>
                                    <field name="operator_out_id"/>
                                </list>
                            </field>
                        </page>
                        <page name="inspections" string="Inspections">
                            <field name="inspection_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="inspector_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page name="transfers" string="Transfers">
                            <field name="transfer_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="transfer_date"/>
                                    <field name="transfer_type_id"/>
                                    <field name="source_location_id"/>
                                    <field name="destination_location_id"/>
                                    <field name="driver_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="notes"/>
                        </page>
                        <page name="car_washes" string="Car Washes">
                            <group>
                                <group>
                                    <field name="wash_count"/>
                                    <field name="last_wash_date"/>
                                    <field name="next_allowed_wash"/>
                                </group>
                            </group>
                            <field name="wash_ids">
                                <list>
                                    <field name="wash_number"/>
                                    <field name="wash_date"/>
                                    <field name="washed_by"/>
                                    <field name="state" widget="badge"/>
                                </list>
                            </field>
                        </page>

                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
