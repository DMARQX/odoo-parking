<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="parking_spot_type_tree" model="ir.ui.view">
        <field name="name">parking.spot.type.tree</field>
        <field name="model">parking.spot.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="parking_spot_type_form" model="ir.ui.view">
        <field name="name">parking.spot.type.form</field>
        <field name="model">parking.spot.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="active"/>
                            <field name="description"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="parking_spot_type_search" model="ir.ui.view">
        <field name="name">parking.spot.type.search</field>
        <field name="model">parking.spot.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
            </search>
        </field>
    </record>

    <record id="action_parking_spot_type" model="ir.actions.act_window">
        <field name="name">Spot Types</field>
        <field name="res_model">parking.spot.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_parking_spot_type"
              name="Spot Types"
              parent="menu_parking_config"
              action="action_parking_spot_type"
              sequence="5"/>
</odoo>