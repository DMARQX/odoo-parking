<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_parking" model="ir.ui.view">
        <field name="name">account.move.form.parking</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_parking_picking" type="object" class="oe_stat_button" icon="fa-truck"
                        invisible="not parking_picking_id" groups="stock.group_stock_user">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Stock Transfer</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='invoice_origin']" position="after">
                <field name="parking_contract_id" readonly="1" invisible="not parking_contract_id"/>
                <field name="parking_picking_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
