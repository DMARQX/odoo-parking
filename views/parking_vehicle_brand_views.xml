<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="parking_vehicle_brand_list" model="ir.ui.view">
        <field name="name">parking.vehicle.brand.list</field>
        <field name="model">parking.vehicle.brand</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="logo" widget="image" options="{'size': [32, 32]}"/>
                <field name="name"/>
                <field name="name_ar"/>
                <field name="aliases" optional="show"/>
                <field name="color" widget="color" optional="hide"/>
                <field name="vehicle_count"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="parking_vehicle_brand_form" model="ir.ui.view">
        <field name="name">parking.vehicle.brand.form</field>
        <field name="model">parking.vehicle.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_vehicles" type="object" class="oe_stat_button" icon="fa-car">
                            <field name="vehicle_count" widget="statinfo" string="Vehicles"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="logo" widget="image" class="oe_avatar" options="{'preview_image': 'logo'}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Toyota"/></h1>
                        <field name="name_ar" placeholder="Arabic name"/>
                    </div>
                    <group>
                        <group>
                            <field name="aliases"/>
                            <field name="color" widget="color"/>
                        </group>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Upload the brand logo (PNG or SVG with a transparent background looks best). Until a logo is
                        set, cards show the brand initials on the badge colour.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="parking_vehicle_brand_search" model="ir.ui.view">
        <field name="name">parking.vehicle.brand.search</field>
        <field name="model">parking.vehicle.brand</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" filter_domain="['|', '|', ('name', 'ilike', self), ('name_ar', 'ilike', self), ('aliases', 'ilike', self)]"/>
                <filter name="no_logo" string="Without logo" domain="[('logo', '=', False)]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_parking_vehicle_brand" model="ir.actions.act_window">
        <field name="name">Vehicle Brands</field>
        <field name="res_model">parking.vehicle.brand</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_parking_vehicle_brand" name="Vehicle Brands" parent="menu_parking_config"
              action="action_parking_vehicle_brand" sequence="6"/>
</odoo>
