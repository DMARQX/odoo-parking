<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Search View -->
    <record id="parking_spot_search_checkin_checkout" model="ir.ui.view">
        <field name="name">parking.spot.search.checkin.checkout</field>
        <field name="model">parking.spot</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Spot"/>
                <field name="current_vehicle_plate" string="License Plate"/>
                <field name="current_vehicle_brand" string="Brand"/>
                <field name="current_owner_mobile" string="Owner Mobile"/>
                <field name="location_id" string="Branch"/>
                <field name="floor" string="Floor"/>
                <filter name="filter_outside" string="Outside" domain="[('status', '=', 'client_out')]"/>
                <filter name="filter_parked" string="Parked" domain="[('status', '=', 'occupied')]"/>
                <filter name="filter_waiting_long" string="Waiting &gt; 4h"
                        domain="[('status', '=', 'client_out'), ('waiting_hours', '&gt;', 4)]"/>
                <filter name="filter_waiting_medium" string="Waiting 1-4h"
                        domain="[('status', '=', 'client_out'), ('waiting_hours', '&gt;', 1), ('waiting_hours', '&lt;=', 4)]"/>
                <filter name="filter_waiting_short" string="Waiting &lt; 1h"
                        domain="[('status', '=', 'client_out'), ('waiting_hours', '&gt;=', 0), ('waiting_hours', '&lt;=', 1)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_branch" string="Branch" context="{'group_by': 'location_id'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Dashboard Kanban -->
    <delete id="parking_spot_kanban_dashboard" model="ir.ui.view"/>
    <record id="parking_spot_kanban_dashboard" model="ir.ui.view">
        <field name="name">parking.spot.kanban.dashboard</field>
        <field name="model">parking.spot</field>
        <field name="arch" type="xml">
            <kanban class="o_pm_spot_kanban" default_group_by="location_id">
                <field name="name"/>
                <field name="full_name"/>
                <field name="status"/>
                <field name="location_id"/>
                <field name="spot_type_id"/>
                <field name="floor"/>
                <field name="current_contract_id"/>
                <field name="current_contract_end"/>
                <field name="current_days_left"/>
                <field name="current_vehicle_plate"/>
                <field name="current_vehicle_brand"/>
                <field name="current_vehicle_model"/>
                <field name="current_vehicle_count"/>
                <field name="current_brand_logo"/>
                <field name="current_brand_color"/>
                <field name="current_brand_initials"/>
                <field name="current_owner_id"/>
                <field name="current_owner_mobile"/>
                <field name="last_movement_out"/>
                <field name="waiting_hours"/>
                <field name="waiting_label"/>
                <templates>
                    <t t-name="card">
                        <t t-set="st" t-value="record.status.raw_value"/>
                        <div t-attf-class="o_pm_spot o_pm_spot_{{st}}">
                            <div class="o_pm_spot_head">
                                <div class="o_pm_spot_code"><field name="name"/></div>
                                <span class="o_pm_spot_status"><field name="status"/></span>
                            </div>
                            <div class="o_pm_spot_meta">
                                <span><i class="fa fa-map-marker me-1" title="Branch"/><field name="location_id"/></span>
                                <span t-if="record.spot_type_id.raw_value"><i class="fa fa-tag me-1" title="Spot type"/><field name="spot_type_id"/></span>
                                <span t-if="record.floor.raw_value"><i class="fa fa-building-o me-1" title="Floor"/><field name="floor"/></span>
                            </div>

                            <t t-if="record.current_vehicle_plate.raw_value">
                                <div class="o_pm_spot_vehicle">
                                    <div class="o_pm_brand">
                                        <field t-if="record.current_brand_logo.raw_value" name="current_brand_logo" widget="image"
                                               options="{'size': [44, 44], 'img_class': 'o_pm_brand_img'}"/>
                                        <span t-elif="record.current_brand_initials.raw_value" class="o_pm_brand_badge"
                                              t-attf-style="background-color: {{record.current_brand_color.raw_value}};"
                                              t-esc="record.current_brand_initials.raw_value"/>
                                        <i t-else="" class="fa fa-car text-muted" title="Vehicle"/>
                                    </div>
                                    <div class="o_pm_vehicle_text">
                                        <div class="o_pm_plate"><t t-esc="record.current_vehicle_plate.raw_value"/></div>
                                        <div class="o_pm_vehicle_name">
                                            <t t-esc="(record.current_vehicle_brand.raw_value || '') + ' ' + (record.current_vehicle_model.raw_value || '')"/>
                                            <span t-if="record.current_vehicle_count.raw_value &gt; 1" class="text-muted">
                                                +<t t-esc="record.current_vehicle_count.raw_value - 1"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </t>

                            <div t-if="record.current_owner_id.raw_value" class="o_pm_spot_line">
                                <i class="fa fa-user me-1" title="Customer"/>
                                <span class="text-truncate"><field name="current_owner_id"/></span>
                                <a t-if="record.current_owner_mobile.raw_value" class="o_pm_phone"
                                   t-attf-href="tel:{{record.current_owner_mobile.raw_value}}">
                                    <i class="fa fa-phone" title="Call"/>
                                </a>
                            </div>
                            <div t-if="record.current_contract_id.raw_value" class="o_pm_spot_line">
                                <i class="fa fa-file-text-o me-1" title="Contract"/>
                                <span><field name="current_contract_id"/></span>
                                <span t-if="record.current_contract_end.raw_value"
                                      t-attf-class="o_pm_days {{record.current_days_left.raw_value &lt; 0 ? 'o_pm_days_late' : (record.current_days_left.raw_value &lt;= 7 ? 'o_pm_days_soon' : '')}}">
                                    <t t-if="record.current_days_left.raw_value &lt; 0">Ended</t>
                                    <t t-else=""><t t-esc="record.current_days_left.raw_value"/> <span>days</span></t>
                                </span>
                            </div>
                            <div t-if="st == 'client_out' and record.last_movement_out.raw_value"
                                 t-attf-class="o_pm_spot_out {{record.waiting_hours.raw_value &gt; 4 ? 'o_pm_out_long' : ''}}">
                                <i class="fa fa-road me-1" title="With the customer"/>
                                <span>With the customer for</span>
                                <strong t-esc="record.waiting_label.raw_value"/>
                            </div>

                            <div t-if="st == 'available'" class="o_pm_spot_empty">
                                <i class="fa fa-check-circle" title="Available"/>
                                <span>Free spot</span>
                            </div>
                            <div t-if="st == 'maintenance'" class="o_pm_spot_empty">
                                <i class="fa fa-wrench" title="Maintenance"/>
                                <span>Under maintenance</span>
                            </div>
                            <div t-if="st == 'reserved' and !record.current_vehicle_plate.raw_value" class="o_pm_spot_empty">
                                <i class="fa fa-bookmark" title="Reserved"/>
                                <span>Reserved, vehicle not arrived yet</span>
                            </div>

                            <div t-if="st == 'occupied' or st == 'client_out'" class="o_pm_spot_actions">
                                <button t-if="st == 'occupied'" name="action_vehicle_checkout" type="object"
                                        groups="parking_management.group_parking_checkinout"
                                        class="btn btn-sm btn-outline-primary">
                                    <i class="fa fa-sign-out me-1" title="Deliver"/>Deliver to customer
                                </button>
                                <button t-if="st == 'client_out'" name="action_vehicle_checkin" type="object"
                                        groups="parking_management.group_parking_checkinout"
                                        class="btn btn-sm btn-success">
                                    <i class="fa fa-sign-in me-1" title="Receive"/>Receive back
                                </button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Movement Log List -->
    <record id="parking_vehicle_movement_list" model="ir.ui.view">
        <field name="name">parking.vehicle.movement.list</field>
        <field name="model">parking.vehicle.movement</field>
        <field name="arch" type="xml">
            <list create="0" decoration-warning="state == 'out'" decoration-danger="needs_review">
                <field name="needs_review" column_invisible="1"/>
                <field name="name" string="Ref"/>
                <field name="vehicle_id"/>
                <field name="partner_id"/>
                <field name="spot_id"/>
                <field name="check_out_time"/>
                <field name="check_in_time"/>
                <field name="duration_hours" widget="float_time" optional="show"/>
                <field name="distance_km" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-warning="state == 'out'" decoration-success="state == 'returned'"
                       decoration-info="state == 'arrival'"/>
                <field name="operator_out_id" optional="hide" widget="many2one_avatar_user"/>
                <field name="operator_in_id" optional="hide" widget="many2one_avatar_user"/>
            </list>
        </field>
    </record>

    <!-- Movement Log Form: one trip, delivery on one side and return on the other -->
    <record id="parking_vehicle_movement_form" model="ir.ui.view">
        <field name="name">parking.vehicle.movement.form</field>
        <field name="model">parking.vehicle.movement</field>
        <field name="arch" type="xml">
            <form create="0">
                <header>
                    <button name="action_register_check_in" string="Receive Vehicle Back" type="object"
                            class="btn-primary" icon="fa-sign-in" invisible="state != 'out'"
                            groups="parking_management.group_parking_checkinout"/>
                    <button name="action_print_handover" string="Print Handover Record" type="object"
                            icon="fa-print"/>
                    <field name="state" widget="statusbar" statusbar_visible="out,returned"/>
                </header>
                <div class="alert alert-danger mb-0 text-center" role="alert" invisible="not needs_review">
                    The recorded times of this movement are inconsistent (recorded before times were validated). Please review it.
                </div>
                <sheet>
                    <field name="needs_review" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <field name="movement_type" readonly="1" class="text-muted"/>
                    </div>
                    <group>
                        <group>
                            <field name="vehicle_id"/>
                            <field name="contract_id"/>
                            <field name="partner_id"/>
                        </group>
                        <group>
                            <field name="spot_id"/>
                            <field name="location_id"/>
                            <field name="inspection_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page name="out" string="Delivery to Customer" invisible="movement_type == 'arrival'">
                            <group>
                                <group>
                                    <field name="check_out_time"/>
                                    <field name="operator_out_id" widget="many2one_avatar_user"/>
                                    <field name="out_handover_to"/>
                                </group>
                                <group>
                                    <field name="out_odometer"/>
                                    <field name="out_fuel"/>
                                </group>
                            </group>
                            <group>
                                <field name="out_attachment_ids" widget="many2many_binary"/>
                                <field name="out_signature" widget="signature"/>
                            </group>
                        </page>
                        <page name="in" string="Return">
                            <group>
                                <group>
                                    <field name="check_in_time"/>
                                    <field name="operator_in_id" widget="many2one_avatar_user"/>
                                    <field name="in_received_from"/>
                                    <field name="key_slot"/>
                                </group>
                                <group>
                                    <field name="in_odometer"/>
                                    <field name="in_fuel"/>
                                    <field name="duration_hours" widget="float_time"/>
                                    <field name="distance_km"/>
                                </group>
                            </group>
                            <group>
                                <field name="in_attachment_ids" widget="many2many_binary"/>
                                <field name="in_signature" widget="signature"/>
                            </group>
                        </page>
                        <page name="notes" string="Notes">
                            <field name="notes" placeholder="Remarks about the vehicle condition..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="parking_vehicle_movement_search" model="ir.ui.view">
        <field name="name">parking.vehicle.movement.search</field>
        <field name="model">parking.vehicle.movement</field>
        <field name="arch" type="xml">
            <search>
                <field name="vehicle_id" string="Vehicle / Plate"/>
                <field name="partner_id"/>
                <field name="spot_id"/>
                <field name="location_id"/>
                <field name="name"/>
                <filter name="filter_out" string="With the customer" domain="[('state', '=', 'out')]"/>
                <filter name="filter_returned" string="Returned" domain="[('state', '=', 'returned')]"/>
                <filter name="filter_arrival" string="First arrivals" domain="[('state', '=', 'arrival')]"/>
                <separator/>
                <filter name="filter_review" string="Needs review" domain="[('needs_review', '=', True)]"/>
                <separator/>
                <filter name="filter_out_date" string="Delivered" date="check_out_time"/>
                <filter name="filter_in_date" string="Returned" date="check_in_time"/>
                <group expand="0" string="Group By">
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_branch" string="Branch" context="{'group_by': 'location_id'}"/>
                    <filter name="group_vehicle" string="Vehicle" context="{'group_by': 'vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_parking_vehicle_movement" model="ir.actions.act_window">
        <field name="name">Vehicle Movements</field>
        <field name="res_model">parking.vehicle.movement</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="parking_vehicle_movement_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No vehicle movements yet</p>
            <p>Movements are recorded from "Receive Vehicle" / "Deliver Vehicle": each one is a trip from delivery to return.</p>
        </field>
    </record>

    <!-- Menu Items -->
    <menuitem id="menu_parking_vehicle_movement"
              name="Vehicle Movements"
              parent="parking_management.menu_parking_operations"
              action="action_parking_vehicle_movement"
              sequence="45"
              groups="parking_management.group_parking_user"/>

</odoo>
