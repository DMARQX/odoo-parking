<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ================= Gateways ================= -->
    <record id="parking_messaging_gateway_list" model="ir.ui.view">
        <field name="name">parking.messaging.gateway.list</field>
        <field name="model">parking.messaging.gateway</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="channel" widget="badge"/>
                <field name="provider"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="parking_messaging_gateway_form" model="ir.ui.view">
        <field name="name">parking.messaging.gateway.form</field>
        <field name="model">parking.messaging.gateway</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Unifonic SMS"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="channel" widget="radio" options="{'horizontal': true}"/>
                            <field name="provider"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert" invisible="provider != 'odoo_sms'">
                        Uses Odoo's own SMS service and its prepaid IAP credits. No other settings are needed.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="provider != 'meta_whatsapp'">
                        Messages that start a conversation with a customer must use a template approved by Meta.
                        Set the template name on each notification rule.
                    </div>
                    <group string="Connection" invisible="provider == 'odoo_sms'">
                        <group>
                            <field name="account_sid" invisible="provider not in ('twilio', 'unifonic')"
                                   required="provider in ('twilio', 'unifonic')"/>
                            <field name="api_key" password="True"
                                   invisible="provider == 'unifonic' or (provider == 'generic_http' and auth_type == 'none')"
                                   required="provider in ('twilio', 'meta_whatsapp')"/>
                            <field name="sender" invisible="provider == 'meta_whatsapp'"/>
                            <field name="phone_number_id" invisible="provider != 'meta_whatsapp'"
                                   required="provider == 'meta_whatsapp'"/>
                            <field name="api_version" invisible="provider != 'meta_whatsapp'"/>
                        </group>
                        <group invisible="provider not in ('generic_http', 'unifonic')">
                            <field name="endpoint" required="provider == 'generic_http'"
                                   placeholder="https://api.provider.com/send"/>
                            <field name="http_method" invisible="provider != 'generic_http'"/>
                            <field name="auth_type" invisible="provider != 'generic_http'"/>
                            <field name="auth_header_name" invisible="provider != 'generic_http' or auth_type != 'header'"/>
                            <field name="username" invisible="provider != 'generic_http' or auth_type != 'basic'"/>
                            <field name="payload_type" invisible="provider != 'generic_http'"/>
                            <field name="success_codes" invisible="provider != 'generic_http'"/>
                        </group>
                    </group>
                    <group string="Request Body" invisible="provider != 'generic_http'">
                        <field name="payload_template" nolabel="1" colspan="2" widget="code" options="{'mode': 'javascript'}"/>
                        <div class="text-muted small" colspan="2">
                            A JSON object. <code>{to}</code>, <code>{message}</code> and <code>{sender}</code> are replaced when a message is sent.
                        </div>
                    </group>
                    <group string="Test">
                        <group>
                            <field name="test_number" placeholder="05XXXXXXXX"/>
                            <button name="action_send_test" type="object" string="Send Test Message"
                                    class="btn-secondary" icon="fa-paper-plane"/>
                        </group>
                        <group>
                            <field name="last_test_result" nolabel="1" colspan="2"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_parking_messaging_gateway" model="ir.actions.act_window">
        <field name="name">Messaging Gateways</field>
        <field name="res_model">parking.messaging.gateway</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect an SMS or WhatsApp provider</p>
            <p>Odoo SMS, Twilio, Unifonic, Meta WhatsApp Cloud API or any HTTP API your provider offers.</p>
        </field>
    </record>

    <!-- ================= Notification rules ================= -->
    <record id="parking_notification_rule_list" model="ir.ui.view">
        <field name="name">parking.notification.rule.list</field>
        <field name="model">parking.notification.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="event"/>
                <field name="name"/>
                <field name="channel" widget="badge"/>
                <field name="body" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="parking_notification_rule_form" model="ir.ui.view">
        <field name="name">parking.notification.rule.form</field>
        <field name="model">parking.notification.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_logs" type="object" class="oe_stat_button" icon="fa-history">
                            <field name="log_count" widget="statinfo" string="Messages"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Off" bg_color="text-bg-secondary" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="event"/>
                            <field name="channel" widget="radio"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="body" nolabel="1" colspan="2"/>
                        <div class="text-muted small" colspan="2">
                            Placeholders: {customer} {plate} {vehicle} {spot} {branch} {contract} {end_date} {days} {amount} {invoice} {company} {date}
                        </div>
                    </group>
                    <group string="WhatsApp Template (Meta)" invisible="channel == 'sms'">
                        <field name="wa_template"/>
                        <field name="wa_lang"/>
                        <field name="wa_params"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_parking_notification_rule" model="ir.actions.act_window">
        <field name="name">Notification Rules</field>
        <field name="res_model">parking.notification.rule</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False}</field>
    </record>

    <!-- ================= Message log ================= -->
    <record id="parking_message_log_list" model="ir.ui.view">
        <field name="name">parking.message.log.list</field>
        <field name="model">parking.message.log</field>
        <field name="arch" type="xml">
            <list create="0" decoration-danger="state == 'failed'" decoration-muted="state == 'skipped'"
                  decoration-success="state == 'sent'">
                <field name="create_date" string="Date"/>
                <field name="event"/>
                <field name="channel" widget="badge"/>
                <field name="partner_id"/>
                <field name="number"/>
                <field name="body" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'sent'" decoration-danger="state == 'failed'"
                       decoration-info="state == 'queued'"/>
                <field name="attempts" optional="hide"/>
                <field name="error" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="parking_message_log_form" model="ir.ui.view">
        <field name="name">parking.message.log.form</field>
        <field name="model">parking.message.log</field>
        <field name="arch" type="xml">
            <form create="0" edit="0">
                <header>
                    <button name="action_retry" type="object" string="Retry" class="btn-primary"
                            invisible="state not in ('failed', 'skipped')"/>
                    <button name="action_open_record" type="object" string="Open Related Record"
                            invisible="not res_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="queued,sent"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="event"/>
                            <field name="rule_id"/>
                            <field name="channel"/>
                            <field name="gateway_id"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="number"/>
                            <field name="create_date" string="Created"/>
                            <field name="sent_date"/>
                            <field name="attempts"/>
                            <field name="res_model" invisible="1"/>
                            <field name="res_id" invisible="1"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="body" nolabel="1" colspan="2"/>
                    </group>
                    <group string="Provider Response">
                        <field name="error" nolabel="1" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="parking_message_log_search" model="ir.ui.view">
        <field name="name">parking.message.log.search</field>
        <field name="model">parking.message.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="number"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <filter name="queued" string="Queued" domain="[('state', '=', 'queued')]"/>
                <filter name="skipped" string="Skipped" domain="[('state', '=', 'skipped')]"/>
                <filter name="sent" string="Sent" domain="[('state', '=', 'sent')]"/>
                <separator/>
                <filter name="filter_date" string="Date" date="create_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_event" string="Event" context="{'group_by': 'event'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_channel" string="Channel" context="{'group_by': 'channel'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_parking_message_log" model="ir.actions.act_window">
        <field name="name">Message Log</field>
        <field name="res_model">parking.message.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="parking_message_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No messages yet</p>
            <p>Every SMS and WhatsApp message sent to customers is listed here with the provider's answer.</p>
        </field>
    </record>

    <!-- ================= Menus ================= -->
    <menuitem id="menu_parking_integrations" name="Integrations" parent="menu_parking_config" sequence="90"
              groups="parking_management.group_parking_manager"/>
    <menuitem id="menu_parking_messaging_gateway" name="Messaging Gateways" parent="menu_parking_integrations"
              action="action_parking_messaging_gateway" sequence="10"/>
    <menuitem id="menu_parking_notification_rule" name="Notification Rules" parent="menu_parking_integrations"
              action="action_parking_notification_rule" sequence="20"/>
    <menuitem id="menu_parking_message_log" name="Message Log" parent="menu_parking_integrations"
              action="action_parking_message_log" sequence="30"/>
</odoo>
