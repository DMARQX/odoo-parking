<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="parking_transfer_type_tree" model="ir.ui.view">
        <field name="name">parking.transfer.type.tree</field>
        <field name="model">parking.transfer.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="parking_transfer_type_form" model="ir.ui.view">
        <field name="name">parking.transfer.type.form</field>
        <field name="model">parking.transfer.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="code" required="1"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Description">
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="parking_transfer_type_search" model="ir.ui.view">
        <field name="name">parking.transfer.type.search</field>
        <field name="model">parking.transfer.type</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
            </search>
        </field>
    </record>

    <record id="action_parking_transfer_type" model="ir.actions.act_window">
        <field name="name">Transfer Types</field>
        <field name="res_model">parking.transfer.type</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="parking_transfer_type_search"/>
        <field name="help">Define the types of vehicle transfers (e.g. Branch to Branch, Branch to Customer, etc.).</field>
    </record>

    <menuitem id="menu_parking_transfer_type"
        name="Transfer Types"
        parent="menu_parking_config"
        action="action_parking_transfer_type"
        sequence="25"/>

</odoo>
