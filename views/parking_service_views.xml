<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="parking_service_tree" model="ir.ui.view">
        <field name="name">parking.service.tree</field>
        <field name="model">parking.service</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="name"/>
                <field name="category"/>
                <field name="product_id"/>
                <field name="price" widget="monetary"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="parking_service_form" model="ir.ui.view">
        <field name="name">parking.service.form</field>
        <field name="model">parking.service</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="active" invisible="1"/>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="category"/>
                            <field name="product_id"/>
                        </group>
                        <group>
                            <field name="price" widget="monetary"/>
                        </group>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>