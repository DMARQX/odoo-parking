<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Product Request Sequence -->
        <record id="seq_product_request" model="ir.sequence">
            <field name="name">Product Request / طلب المنتجات</field>
            <field name="code">product.request</field>
            <field name="prefix">PR</field>
            <field name="suffix">%(y)s%(month)s</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="use_date_range">False</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>