<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Report for Rental Quotation -->
    <template id="report_rental_quotation_document">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)" />
            <div class="page">
                <div class="oe_structure"/>
                
                <!-- Header -->
                <div class="row">
                    <div class="col-6">
                        <h2>
                            <span t-if="doc.state == 'draft'">مسودة عرض سعر</span>
                            <span t-elif="doc.state == 'pending'">عرض سعر في الانتظار</span>
                            <span t-elif="doc.state == 'approved'">عرض سعر معتمد</span>
                            <span t-elif="doc.state == 'rejected'">عرض سعر مرفوض</span>
                            <span t-else="">عرض سعر</span>
                        </h2>
                        <p>
                            <strong>رقم العرض:</strong> <span t-field="doc.name"/>
                        </p>
                    </div>
                    <div class="col-6 text-right">
                        <p>
                            <strong>التاريخ:</strong> <span t-field="doc.quotation_date"/>
                        </p>
                        <p t-if="doc.validity_date">
                            <strong>صالح حتى:</strong> <span t-field="doc.validity_date"/>
                        </p>
                    </div>
                </div>
                
                <!-- Customer Info -->
                <div class="row mt-4">
                    <div class="col-6">
                        <strong>العميل:</strong>
                        <div t-field="doc.partner_id" 
                             t-options='{"widget": "contact", "fields": ["address", "name", "phone", "email"], "no_marker": True, "phone_icons": True}'/>
                    </div>
                    <div class="col-6">
                        <p><strong>البائع:</strong> <span t-field="doc.user_id.name"/></p>
                        <p t-if="doc.reference"><strong>المرجع:</strong> <span t-field="doc.reference"/></p>
                        <p t-if="doc.payment_terms"><strong>شروط الدفع:</strong> <span t-field="doc.payment_terms"/></p>
                    </div>
                </div>
                
                <!-- Description -->
                <div class="row mt-4" t-if="doc.description">
                    <div class="col-12">
                        <strong>الوصف:</strong>
                        <div t-field="doc.description"/>
                    </div>
                </div>
                
                <!-- Quotation Lines -->
                <table class="table table-sm mt-4" t-if="doc.line_ids">
                    <thead>
                        <tr>
                            <th class="text-left">العنصر</th>
                            <th class="text-center">الكمية</th>
                            <th class="text-right">السعر الأساسي</th>
                            <th class="text-right">الخصم (%)</th>
                            <th class="text-right">المجموع</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="doc.line_ids" t-as="line">
                            <tr>
                                <td>
                                    <span t-field="line.product_id.name"/>
                                    <div t-if="line.description" class="text-muted">
                                        <span t-field="line.description"/>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <span t-field="line.quantity"/>
                                    <span t-field="line.uom_id.name" groups="uom.group_uom"/>
                                </td>
                                <td class="text-right">
                                    <span t-field="line.unit_price" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                                <td class="text-right">
                                    <span t-field="line.discount"/>%
                                </td>
                                <td class="text-right">
                                    <span t-field="line.total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>
                
                <!-- Totals -->
                <div class="row">
                    <div class="col-6 ml-auto">
                        <table class="table table-sm">
                            <tr>
                                <td><strong>المجموع الفرعي:</strong></td>
                                <td class="text-right">
                                    <span t-field="doc.subtotal" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                            <tr t-if="doc.tax_amount">
                                <td><strong>الضرائب:</strong></td>
                                <td class="text-right">
                                    <span t-field="doc.tax_amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                            <tr t-if="doc.discount_amount">
                                <td><strong>إجمالي الخصم:</strong></td>
                                <td class="text-right">
                                    <span t-field="doc.discount_amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                            <tr class="border-black">
                                <td><strong>الإجمالي:</strong></td>
                                <td class="text-right">
                                    <span t-field="doc.total_amount" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
                
                <!-- Terms and Conditions -->
                <div class="row mt-4" t-if="doc.terms_conditions">
                    <div class="col-12">
                        <strong>الشروط والأحكام:</strong>
                        <div t-field="doc.terms_conditions"/>
                    </div>
                </div>
                
                <!-- Approval History -->
                <div class="row mt-4" t-if="doc.approval_history_ids">
                    <div class="col-12">
                        <strong>سجل الموافقات:</strong>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>المعتمد</th>
                                    <th>المستوى</th>
                                    <th>القرار</th>
                                    <th>التاريخ</th>
                                    <th>التعليق</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.approval_history_ids" t-as="approval">
                                    <tr>
                                        <td><span t-field="approval.approver_id.name"/></td>
                                        <td><span t-field="approval.approval_level"/></td>
                                        <td>
                                            <span t-if="approval.status == 'approved'" class="text-success">معتمد</span>
                                            <span t-elif="approval.status == 'rejected'" class="text-danger">مرفوض</span>
                                            <span t-else="" class="text-warning">في الانتظار</span>
                                        </td>
                                        <td><span t-field="approval.approval_date"/></td>
                                        <td><span t-field="approval.comments"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </div>
                
                <!-- Digital Signature Section -->
                <div class="row mt-5" t-if="doc.signature_request_ids">
                    <div class="col-12">
                        <strong>التوقيعات الإلكترونية:</strong>
                        <t t-foreach="doc.signature_request_ids" t-as="signature_req">
                            <div class="mt-3 border p-3">
                                <div class="row">
                                    <div class="col-6">
                                        <p><strong>الموقع:</strong> <span t-field="signature_req.signer_id.name"/></p>
                                        <p><strong>الدور:</strong> <span t-field="signature_req.signer_role"/></p>
                                        <p><strong>الحالة:</strong> 
                                            <span t-if="signature_req.status == 'signed'" class="text-success">موقع</span>
                                            <span t-elif="signature_req.status == 'pending'" class="text-warning">في الانتظار</span>
                                            <span t-elif="signature_req.status == 'rejected'" class="text-danger">مرفوض</span>
                                        </p>
                                        <p t-if="signature_req.signed_date"><strong>تاريخ التوقيع:</strong> <span t-field="signature_req.signed_date"/></p>
                                    </div>
                                    <div class="col-6" t-if="signature_req.signature_image">
                                        <img t-att-src="'data:image/png;base64,' + signature_req.signature_image.decode('utf-8')" 
                                             style="max-width: 200px; max-height: 100px; border: 1px solid #ccc;"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
                
                <div class="oe_structure"/>
            </div>
        </t>
    </template>
    
    <!-- Report Action -->
    <record id="action_report_rental_quotation" model="ir.actions.report">
        <field name="name">عرض السعر التأجيري</field>
        <field name="model">rental.quotation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">rental_quotation.report_rental_quotation_document</field>
        <field name="report_file">rental_quotation.report_rental_quotation_document</field>
        <field name="print_report_name">'عرض سعر - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_rental_quotation"/>
        <field name="binding_type">report</field>
    </record>

</odoo>