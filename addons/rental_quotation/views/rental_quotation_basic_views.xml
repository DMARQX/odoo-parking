<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Basic Form View -->
    <record id="view_rental_quotation_form_basic" model="ir.ui.view">
        <field name="name">rental.quotation.form.basic</field>
        <field name="model">rental.quotation</field>
        <field name="arch" type="xml">
            <form string="Rental Quotation">
                <header>
                    <button name="action_submit_for_approval" type="object" 
                            string="Submit for Approval" 
                            invisible="state != 'draft'" 
                            class="btn-primary"/>
                    <button name="action_approve" type="object" 
                            string="Approve" 
                            invisible="state != 'submitted'" 
                            class="btn-success"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="quotation_date"/>
                        <field name="total_amount"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Basic list View -->
    <record id="view_rental_quotation_list_basic" model="ir.ui.view">
        <field name="name">rental.quotation.list.basic</field>
        <field name="model">rental.quotation</field>
        <field name="arch" type="xml">
            <list string="Rental Quotations">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="quotation_date"/>
                <field name="total_amount"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Basic Action -->
    <record id="action_rental_quotation_basic" model="ir.actions.act_window">
        <field name="name">Rental Quotations</field>
        <field name="res_model">rental.quotation</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first rental quotation
            </p>
        </field>
    </record>

    <!-- Basic Menu -->
    <menuitem id="menu_rental_quotation_main" 
              name="Rental Quotations" 
              sequence="10"/>
              
    <menuitem id="menu_rental_quotation_quotations" 
              name="Quotations" 
              parent="menu_rental_quotation_main"
              action="action_rental_quotation_basic"
              sequence="10"/>

</odoo>