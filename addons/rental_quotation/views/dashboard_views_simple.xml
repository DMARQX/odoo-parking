<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Dashboard Action -->
    <record id="action_rental_quotation_dashboard" model="ir.actions.act_window">
        <field name="name">Quotation Dashboard</field>
        <field name="res_model">rental.quotation.dashboard</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'default_mode': 'dashboard'}</field>
    </record>
    
    <!-- Dashboard Form View -->
    <record id="view_rental_quotation_dashboard_form" model="ir.ui.view">
        <field name="name">rental.quotation.dashboard.form</field>
        <field name="model">rental.quotation.dashboard</field>
        <field name="arch" type="xml">
            <form string="Quotation Dashboard" create="false" edit="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1>Rental Quotations Dashboard</h1>
                        <h3>Real-time Analytics</h3>
                    </div>
                    
                    <!-- Basic Statistics -->
                    <group name="statistics" string="Statistics" col="4">
                        <field name="total_quotations"/>
                        <field name="pending_approvals"/>
                        <field name="approved_quotations"/>
                        <field name="converted_quotations"/>
                    </group>
                    
                    <!-- Financial Data -->
                    <group name="financial" string="Financial Overview" col="2">
                        <field name="total_quotation_value"/>
                        <field name="approved_value"/>
                        <field name="converted_value"/>
                        <field name="average_quotation_value"/>
                    </group>
                    
                </sheet>
            </form>
        </field>
    </record>
    
</odoo>