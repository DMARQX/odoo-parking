<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Portal Template for Customer -->
        <template id="portal_rental_quotations" name="Rental Quotations">
            <t t-call="portal.portal_layout">
                <t t-set="breadcrumbs_searchbar" t-value="True"/>
                
                <t t-call="portal.portal_searchbar">
                    <t t-set="title">Rental Quotations</t>
                </t>
                
                <div class="row">
                    <div class="col-12">
                        <div class="card">
                            <div class="card-header">
                                <h4>My Rental Quotations</h4>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr>
                                                <th>Quotation #</th>
                                                <th>Date</th>
                                                <th>Total Amount</th>
                                                <th>Status</th>
                                                <th>Action</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="quotations" t-as="quotation">
                                                <td><span t-esc="quotation.name"/></td>
                                                <td><span t-esc="quotation.quotation_date"/></td>
                                                <td><span t-esc="quotation.total_amount"/></td>
                                                <td>
                                                    <span t-if="quotation.state == 'draft'" class="badge badge-secondary">Draft</span>
                                                    <span t-if="quotation.state == 'pending'" class="badge badge-warning">Pending</span>
                                                    <span t-if="quotation.state == 'approved'" class="badge badge-success">Approved</span>
                                                    <span t-if="quotation.state == 'rejected'" class="badge badge-danger">Rejected</span>
                                                </td>
                                                <td>
                                                    <a t-attf-href="/my/quotations/#{quotation.id}" class="btn btn-sm btn-primary">View</a>
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Portal Quotation Detail -->
        <template id="portal_rental_quotation_detail" name="Quotation Detail">
            <t t-call="portal.portal_layout">
                <t t-set="title" t-value="quotation.name"/>
                
                <div class="row">
                    <div class="col-md-8">
                        <div class="card">
                            <div class="card-header">
                                <h4><span t-esc="quotation.name"/> - Details</h4>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-6">
                                        <strong>Date:</strong> <span t-esc="quotation.quotation_date"/><br/>
                                        <strong>Valid Until:</strong> <span t-esc="quotation.valid_until"/><br/>
                                        <strong>Status:</strong> 
                                        <span t-if="quotation.state == 'draft'" class="badge badge-secondary">Draft</span>
                                        <span t-if="quotation.state == 'pending'" class="badge badge-warning">Pending Approval</span>
                                        <span t-if="quotation.state == 'approved'" class="badge badge-success">Approved</span>
                                        <span t-if="quotation.state == 'rejected'" class="badge badge-danger">Rejected</span>
                                    </div>
                                </div>
                                
                                <hr/>
                                
                                <h5>Quotation Lines</h5>
                                <table class="table">
                                    <thead>
                                        <tr>
                                            <th>Property</th>
                                            <th>Unit</th>
                                            <th>Description</th>
                                            <th class="text-right">Amount</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="quotation.quotation_line_ids" t-as="line">
                                            <td><span t-esc="line.property_id.name"/></td>
                                            <td><span t-esc="line.unit_id.name"/></td>
                                            <td><span t-esc="line.description"/></td>
                                            <td class="text-right"><span t-esc="line.rental_amount"/></td>
                                        </tr>
                                    </tbody>
                                    <tfoot>
                                        <tr>
                                            <th colspan="3" class="text-right">Total:</th>
                                            <th class="text-right"><span t-esc="quotation.total_amount"/></th>
                                        </tr>
                                    </tfoot>
                                </table>
                                
                                <div t-if="quotation.notes" class="mt-3">
                                    <h6>Notes</h6>
                                    <p><span t-esc="quotation.notes"/></p>
                                </div>
                                
                                <div class="mt-4">
                                    <a href="/my/quotations" class="btn btn-secondary">Back to List</a>
                                    <t t-if="quotation.state == 'approved'">
                                        <a t-attf-href="/report/pdf/rental_quotation.report_rental_quotation_template/#{quotation.id}" 
                                           class="btn btn-primary ml-2" target="_blank">Download PDF</a>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="col-md-4">
                        <div class="card">
                            <div class="card-header">
                                <h6>Approval History</h6>
                            </div>
                            <div class="card-body">
                                <t t-if="quotation.approval_history_ids">
                                    <div t-foreach="quotation.approval_history_ids" t-as="approval" class="mb-3">
                                        <div class="d-flex justify-content-between">
                                            <strong><span t-esc="approval.approver_id.name"/></strong>
                                            <small><span t-esc="approval.approval_date"/></small>
                                        </div>
                                        <div>
                                            <span t-if="approval.action == 'approved'" class="badge badge-success">Approved</span>
                                            <span t-if="approval.action == 'rejected'" class="badge badge-danger">Rejected</span>
                                        </div>
                                        <div t-if="approval.comments">
                                            <small><span t-esc="approval.comments"/></small>
                                        </div>
                                    </div>
                                </t>
                                <t t-if="not quotation.approval_history_ids">
                                    <p class="text-muted">No approval history yet.</p>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

        <!-- Website Quotation Request Form -->
        <template id="website_quotation_request" name="Request Quotation">
            <t t-call="website.layout">
                <div id="wrap">
                    <div class="container mt-4">
                        <div class="row">
                            <div class="col-md-8 offset-md-2">
                                <h2>Request Rental Quotation</h2>
                                <p class="lead">Fill out the form below to request a rental quotation for your desired property.</p>
                                
                                <form action="/quotation/submit" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="customer_name">Full Name *</label>
                                                <input type="text" class="form-control" id="customer_name" name="customer_name" required="true"/>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="customer_email">Email *</label>
                                                <input type="email" class="form-control" id="customer_email" name="customer_email" required="true"/>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="customer_phone">Phone</label>
                                                <input type="tel" class="form-control" id="customer_phone" name="customer_phone"/>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="form-group">
                                                <label for="rental_period">Rental Period</label>
                                                <select class="form-control" id="rental_period" name="rental_period">
                                                    <option value="monthly">Monthly</option>
                                                    <option value="quarterly">Quarterly</option>
                                                    <option value="yearly">Yearly</option>
                                                </select>
                                            </div>
                                        </div>
                                    </div>
                                    
                                    <div class="form-group">
                                        <label for="property_requirements">Property Requirements</label>
                                        <textarea class="form-control" id="property_requirements" name="property_requirements" rows="4" 
                                                  placeholder="Describe your rental requirements (location, size, amenities, etc.)"></textarea>
                                    </div>
                                    
                                    <div class="form-group">
                                        <label for="additional_notes">Additional Notes</label>
                                        <textarea class="form-control" id="additional_notes" name="additional_notes" rows="3" 
                                                  placeholder="Any additional information you'd like to share"></textarea>
                                    </div>
                                    
                                    <div class="form-group text-center">
                                        <button type="submit" class="btn btn-primary btn-lg">Submit Quotation Request</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>

    </data>
</odoo>