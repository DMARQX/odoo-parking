<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Cron Job: Release Units After Grace Period -->
    <record id="ir_cron_release_units_grace_period" model="ir.cron">
        <field name="name">Rental Quotation: Release Units After Grace Period</field>
        <field name="model_id" ref="model_rental_quotation"/>
        <field name="state">code</field>
        <field name="code">model._cron_release_units_after_grace_period()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    
</odoo>
