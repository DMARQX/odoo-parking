<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Simple Quotation Template (backup) -->
        <template id="quotation_template_simple">
            <div class="quotation-template">
                <div class="header">
                    <h1>Rental Quotation</h1>
                    <p>Number: <span t-esc="quotation.name"/></p>
                    <p>Date: <span t-esc="quotation.quotation_date"/></p>
                </div>
                
                <div class="customer-info">
                    <h3>Customer Information</h3>
                    <p><span t-esc="quotation.partner_id.name"/></p>
                    <p><span t-esc="quotation.partner_id.email"/></p>
                    <p><span t-esc="quotation.partner_id.phone"/></p>
                </div>
                
                <div class="quotation-lines">
                    <h3>Quotation Details</h3>
                    <table>
                        <thead>
                            <tr>
                                <th>Property</th>
                                <th>Unit</th>
                                <th>Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="quotation.quotation_line_ids" t-as="line">
                                <td><span t-esc="line.property_id.name"/></td>
                                <td><span t-esc="line.unit_id.name"/></td>
                                <td><span t-esc="line.rental_amount"/></td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                
                <div class="total">
                    <h3>Total: <span t-esc="quotation.total_amount"/></h3>
                </div>
                
                <div class="footer">
                    <p>Thank you for choosing our services!</p>
                </div>
            </div>
        </template>

    </data>
</odoo>