<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Security Groups -->
        <record id="group_rental_quotation_user" model="res.groups">
            <field name="name">Rental Quotation User</field>
            <field name="category_id" ref="base.module_category_real_estate"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_rental_quotation_manager" model="res.groups">
            <field name="name">Rental Quotation Manager</field>
            <field name="category_id" ref="base.module_category_real_estate"/>
            <field name="implied_ids" eval="[(4, ref('group_rental_quotation_user'))]"/>
        </record>

        <record id="group_rental_quotation_admin" model="res.groups">
            <field name="name">Rental Quotation Administrator</field>
            <field name="category_id" ref="base.module_category_real_estate"/>
            <field name="implied_ids" eval="[(4, ref('group_rental_quotation_manager'))]"/>
        </record>

        <!-- Record Rules -->
        <record id="rule_rental_quotation_user" model="ir.rule">
            <field name="name">Rental Quotation User Rule</field>
            <field name="model_id" ref="model_rental_quotation"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('group_rental_quotation_user'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_rental_quotation_manager" model="ir.rule">
            <field name="name">Rental Quotation Manager Rule</field>
            <field name="model_id" ref="model_rental_quotation"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_rental_quotation_manager'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="True"/>
        </record>

        <record id="rule_approval_rule_manager" model="ir.rule">
            <field name="name">Approval Rule Manager Rule</field>
            <field name="model_id" ref="model_rental_quotation_approval_rule"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_rental_quotation_manager'))]"/>
        </record>

    </data>
</odoo>