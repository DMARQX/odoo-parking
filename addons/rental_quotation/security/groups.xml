<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Rental Quotation User Group -->
        <record id="group_rental_quotation_user" model="res.groups">
            <field name="name">Rental Quotation User</field>
            <field name="comment">Can create and manage rental quotations</field>
        </record>
        
        <!-- Rental Quotation Approver Group -->
        <record id="group_rental_quotation_approver" model="res.groups">
            <field name="name">Rental Quotation Approver</field>
            <field name="comment">Can approve rental quotations</field>
            <field name="implied_ids" eval="[(4, ref('group_rental_quotation_user'))]"/>
        </record>
        
        <!-- Rental Quotation Manager Group -->
        <record id="group_rental_quotation_manager" model="res.groups">
            <field name="name">Rental Quotation Manager</field>
            <field name="comment">Full access to rental quotation system</field>
            <field name="implied_ids" eval="[(4, ref('group_rental_quotation_approver'))]"/>
        </record>
        
        <!-- Rental Quotation Admin Group -->
        <record id="group_rental_quotation_admin" model="res.groups">
            <field name="name">Rental Quotation Admin</field>
            <field name="comment">System administrator for rental quotations</field>
            <field name="implied_ids" eval="[(4, ref('group_rental_quotation_manager'))]"/>
        </record>
        
    </data>
</odoo>