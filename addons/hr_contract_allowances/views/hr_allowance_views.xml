<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Allowance list View -->
        <record id="view_hr_allowance_list" model="ir.ui.view">
            <field name="name">hr.allowance.list</field>
            <field name="model">hr.allowance</field>
            <field name="arch" type="xml">
                <list string="Employee Allowances | بدلات الموظفين" decoration-muted="state == 'inactive'" decoration-danger="state == 'cancelled'">
                    <field name="employee_id"/>
                    <field name="allowance_name"/>
                    <field name="allowance_code"/>
                    <field name="amount" widget="monetary"/>
                    <field name="percentage" invisible="not is_percentage_based"/>
                    <field name="is_percentage_based" invisible="1"/>
                    <field name="is_taxable"/>
                    <field name="date_start"/>
                    <field name="date_end"/>
                    <field name="state" widget="badge" decoration-success="state == 'active'" decoration-info="state == 'draft'" decoration-muted="state == 'inactive'" decoration-danger="state == 'cancelled'"/>
                    <field name="currency_id" invisible="1"/>
                </list>
            </field>
        </record>
        
        <!-- Allowance Form View -->
        <record id="view_hr_allowance_form" model="ir.ui.view">
            <field name="name">hr.allowance.form</field>
            <field name="model">hr.allowance</field>
            <field name="arch" type="xml">
                <form string="Employee Allowance | بدل الموظف">
                    <header>
                        <button name="action_activate" string="Activate" type="object" class="oe_highlight" invisible="state == 'active'"/>
                        <button name="action_deactivate" string="Deactivate" type="object" invisible="state != 'active'"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancelled'"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,active,inactive,cancelled"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="contract_id" options="{'no_create': True}"/>
                                <field name="employee_id"/>
                                <field name="allowance_type_id" options="{'no_create': True}"/>
                                <field name="allowance_name" readonly="1"/>
                                <field name="allowance_code" readonly="1"/>
                            </group>
                            <group>
                                <field name="is_percentage_based" invisible="1"/>
                                <field name="percentage" invisible="not is_percentage_based"/>
                                <field name="amount" widget="monetary"/>
                                <field name="currency_id" invisible="1"/>
                                <field name="is_taxable" readonly="1"/>
                            </group>
                        </group>
                        
                        <group string="Validity Period | فترة الصلاحية">
                            <group>
                                <field name="date_start"/>
                                <field name="date_end"/>
                            </group>
                        </group>
                        
                        <group string="Notes | ملاحظات">
                            <field name="notes" nolabel="1" placeholder="Enter any additional notes about this allowance..."/>
                        </group>
                        
                    </sheet>
                </form>
            </field>
        </record>
        
        <!-- Allowance Search View -->
        <record id="view_hr_allowance_search" model="ir.ui.view">
            <field name="name">hr.allowance.search</field>
            <field name="model">hr.allowance</field>
            <field name="arch" type="xml">
                <search string="Search Allowances">
                    <field name="employee_id"/>
                    <field name="allowance_name"/>
                    <field name="allowance_code"/>
                    <field name="contract_id"/>
                    
                    <filter string="Active" name="active" domain="[('state', '=', 'active')]"/>
                    <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                    <filter string="Inactive" name="inactive" domain="[('state', '=', 'inactive')]"/>
                    <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                    <separator/>
                    <filter string="Taxable" name="taxable" domain="[('is_taxable', '=', True)]"/>
                    <filter string="Non-Taxable" name="non_taxable" domain="[('is_taxable', '=', False)]"/>
                    <separator/>
                    <filter string="Percentage Based" name="percentage_based" domain="[('is_percentage_based', '=', True)]"/>
                    <filter string="Fixed Amount" name="fixed_amount" domain="[('is_percentage_based', '=', False)]"/>
                    <separator/>
                    <filter string="This Month" name="this_month" domain="[('date_start', '&gt;=', (context_today() - relativedelta(day=1)).strftime('%Y-%m-%d')), ('date_start', '&lt;', (context_today() + relativedelta(months=1, day=1)).strftime('%Y-%m-%d'))]"/>
                    
                    <group expand="0" string="Group By">
                        <filter string="Employee" name="group_by_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="Allowance Type" name="group_by_allowance_type" context="{'group_by': 'allowance_type_id'}"/>
                        <filter string="Contract" name="group_by_contract" context="{'group_by': 'contract_id'}"/>
                        <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                        <filter string="Start Date" name="group_by_date_start" context="{'group_by': 'date_start'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Allowance Action -->
        <record id="action_hr_allowance" model="ir.actions.act_window">
            <field name="name">Employee Allowances | بدلات الموظفين</field>
            <field name="res_model">hr.allowance</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_active': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create the first allowance!
                </p>
                <p>
                    Assign allowances to employee contracts. You can set fixed amounts or percentages of the basic salary.
                </p>
            </field>
        </record>
        
    </data>
</odoo>