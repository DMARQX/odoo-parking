<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Demo Employee for Testing -->
        <record id="employee_demo_allowances" model="hr.employee">
            <field name="name">John Smith</field>
            <field name="work_email">john.smith@example.com</field>
        </record>
        
        <!-- Demo Contract for Testing -->
        <record id="demo_contract_allowances" model="hr.contract">
            <field name="name">Contract - John Smith</field>
            <field name="employee_id" ref="employee_demo_allowances"/>
            <field name="wage">5000.0</field>
            <field name="date_start" eval="(DateTime.now() - timedelta(days=30)).strftime('%Y-%m-%d')"/>
            <field name="date_end" eval="(DateTime.now() + timedelta(days=335)).strftime('%Y-%m-%d')"/>
            <field name="state">open</field>
        </record>
        
        <!-- Demo Allowances -->
        <record id="demo_allowance_transport" model="hr.allowance">
            <field name="contract_id" ref="demo_contract_allowances"/>
            <field name="allowance_type_id" ref="allowance_type_transport"/>
            <field name="amount">500.0</field>
            <field name="state">active</field>
            <field name="date_start" eval="(DateTime.now() - timedelta(days=30)).strftime('%Y-%m-%d')"/>
        </record>
        
        <record id="demo_allowance_housing" model="hr.allowance">
            <field name="contract_id" ref="demo_contract_allowances"/>
            <field name="allowance_type_id" ref="allowance_type_housing"/>
            <field name="percentage">25.0</field>
            <field name="amount">1250.0</field>
            <field name="state">active</field>
            <field name="date_start" eval="(DateTime.now() - timedelta(days=30)).strftime('%Y-%m-%d')"/>
        </record>
        
        <record id="demo_allowance_food" model="hr.allowance">
            <field name="contract_id" ref="demo_contract_allowances"/>
            <field name="allowance_type_id" ref="allowance_type_food"/>
            <field name="amount">300.0</field>
            <field name="state">active</field>
            <field name="date_start" eval="(DateTime.now() - timedelta(days=30)).strftime('%Y-%m-%d')"/>
        </record>
        
        <record id="demo_allowance_medical" model="hr.allowance">
            <field name="contract_id" ref="demo_contract_allowances"/>
            <field name="allowance_type_id" ref="allowance_type_medical"/>
            <field name="percentage">10.0</field>
            <field name="amount">500.0</field>
            <field name="state">active</field>
            <field name="date_start" eval="(DateTime.now() - timedelta(days=30)).strftime('%Y-%m-%d')"/>
        </record>
        
    </data>
</odoo>