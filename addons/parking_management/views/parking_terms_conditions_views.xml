<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="parking_terms_conditions_tree" model="ir.ui.view">
        <field name="name">parking.terms.conditions.tree</field>
        <field name="model">parking.terms.conditions</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="is_default"/>
                <field name="auto_sync"/>
                <field name="contract_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="parking_terms_conditions_form" model="ir.ui.view">
        <field name="name">parking.terms.conditions.form</field>
        <field name="model">parking.terms.conditions</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_sync_contracts" string="Sync to All Linked Contracts" type="object" class="btn-primary"
                            invisible="contract_count == 0"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_contracts" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <field name="contract_count" widget="statinfo" string="Linked Contracts"/>
                            </div>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="is_default"/>
                            <field name="auto_sync"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <field name="content" widget="html"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="parking_terms_conditions_search" model="ir.ui.view">
        <field name="name">parking.terms.conditions.search</field>
        <field name="model">parking.terms.conditions</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <filter name="defaults" string="Defaults" domain="[('is_default','=',True)]"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
            </search>
        </field>
    </record>
    <record id="action_parking_terms_conditions" model="ir.actions.act_window">
        <field name="name">Terms &amp; Conditions</field>
        <field name="res_model">parking.terms.conditions</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Terms &amp; Conditions template
            </p>
            <p>
                Manage reusable Terms &amp; Conditions templates. Link them to contracts and sync changes automatically.
            </p>
        </field>
    </record>
    <record id="menu_parking_terms_conditions" model="ir.ui.menu">
        <field name="name">Terms &amp; Conditions</field>
        <field name="parent_id" ref="parking_management.menu_parking_config"/>
        <field name="action" ref="action_parking_terms_conditions"/>
        <field name="sequence">40</field>
        <field name="groups_id" eval="[(4, ref('parking_management.group_parking_terms_conditions'))]"/>
    </record>
</odoo>
