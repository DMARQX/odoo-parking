<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="parking_contract_history_tree" model="ir.ui.view">
        <field name="name">parking.contract.history.tree</field>
        <field name="model">parking.contract.history</field>
        <field name="arch" type="xml">
            <list>
                <field name="contract_id"/>
                <field name="vehicle_id"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="duration_hours"/>
                <field name="operator_in_id"/>
                <field name="operator_out_id"/>
            </list>
        </field>
    </record>
    <record id="parking_contract_history_form" model="ir.ui.view">
        <field name="name">parking.contract.history.form</field>
        <field name="model">parking.contract.history</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="contract_id"/>
                            <field name="vehicle_id"/>
                            <field name="spot_id"/>
                            <field name="location_id"/>
                        </group>
                        <group>
                            <field name="check_in"/>
                            <field name="check_out"/>
                            <field name="duration_hours"/>
                            <field name="operator_in_id"/>
                            <field name="operator_out_id"/>
                        </group>
                    </group>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
    
    <record id="action_parking_contract_invoices" model="ir.actions.act_window">
        <field name="name">Contract Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_group_by_partner': 1}</field>
        <field name="domain">[('parking_contract_id', '!=', False)]</field>
    </record>
    
    <record id="action_parking_spot_status_log" model="ir.actions.act_window">
        <field name="name">Status Log</field>
        <field name="res_model">parking.spot.status.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
