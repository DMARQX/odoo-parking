<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Email Template: Vendor Quote Submitted to Owner -->
    <record id="email_template_vendor_quote_submitted" model="mail.template">
        <field name="name">Vendor Quote Submitted to Owner / عرض سعر مورد للمراجعة</field>
        <field name="model_id" ref="model_maintenance_vendor_quote"/>
        <field name="subject">New Vendor Quote Received - {{ object.name }} / عرض سعر جديد من {{ object.vendor_id.name }}</field>
        <field name="email_from">{{ (object.create_uid.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.project_id.partner_id.email if object.project_id and object.project_id.partner_id else '' }}</field>
        <field name="lang">{{ object.project_id.partner_id.lang if object.project_id and object.project_id.partner_id else 'en_US' }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f5f5f5; padding: 20px;">
                <tr>
                    <td align="center">
                        <table border="0" cellpadding="0" cellspacing="0" width="600" style="font-family: Arial, sans-serif;">
                            <tr>
                                <td style="background-color: #007bff; color: white; padding: 25px; text-align: center; border-radius: 8px 8px 0 0;">
                                    <h1 style="margin: 0; font-size: 24px; font-weight: bold;">New Vendor Quote Received</h1>
                                    <h2 style="margin: 8px 0 0 0; font-size: 20px; font-weight: normal; direction: rtl;">عرض سعر جديد من المورد</h2>
                                </td>
                            </tr>
                            <tr>
                                <td style="background-color: white; padding: 30px; border-radius: 0 0 8px 8px;">
                                    <p style="font-size: 16px; color: #333; margin: 0 0 15px 0;">Dear Property Owner,</p>
                                    <p style="font-size: 14px; color: #555; margin: 0 0 20px 0;">A new vendor quote has been submitted for your review:</p>
                                    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8f9fa; border-radius: 8px; margin-bottom: 25px;">
                                        <tr>
                                            <td style="padding: 20px;">
                                                <table border="0" cellpadding="8" cellspacing="0" width="100%" style="border-left: 4px solid #007bff;">
                                                    <tr><td width="40%" style="padding: 12px 15px; font-weight: bold; color: #495057;">Quote Number:</td><td style="padding: 12px 15px; color: #212529;"><t t-out="object.name"/></td></tr>
                                                    <tr><td style="padding: 12px 15px; font-weight: bold; color: #495057;">Vendor:</td><td style="padding: 12px 15px; color: #212529;"><t t-out="object.vendor_id.name"/></td></tr>
                                                    <tr><td style="padding: 12px 15px; font-weight: bold; color: #495057;">Project:</td><td style="padding: 12px 15px; color: #212529;"><t t-out="object.project_id.name if object.project_id else '-'"/></td></tr>
                                                    <tr><td style="padding: 12px 15px; font-weight: bold; color: #495057;">Purchase Requisition:</td><td style="padding: 12px 15px; color: #212529;"><t t-out="object.requisition_id.name if object.requisition_id else '-'"/></td></tr>
                                                    <tr style="background-color: #e8f5e9;"><td style="padding: 12px 15px; font-weight: bold; color: #495057;">Total Amount:</td><td style="padding: 12px 15px; color: #2e7d32; font-size: 18px; font-weight: bold;"><t t-out="'{:,.2f}'.format(object.total_amount)"/> <t t-out="object.company_currency_id.symbol if object.company_currency_id else 'SAR'"/></td></tr>
                                                    <tr><td style="padding: 12px 15px; font-weight: bold; color: #495057;">Delivery Days:</td><td style="padding: 12px 15px; color: #212529;"><t t-out="object.delivery_days or '-'"/> days</td></tr>
                                                    <tr><td style="padding: 12px 15px; font-weight: bold; color: #495057;">Warranty Period:</td><td style="padding: 12px 15px; color: #212529;"><t t-out="object.warranty_period or '-'"/></td></tr>
                                                    <tr><td style="padding: 12px 15px; font-weight: bold; color: #495057;">Valid Until:</td><td style="padding: 12px 15px; color: #212529;"><t t-out="object.validity_date.strftime('%Y-%m-%d') if object.validity_date else '-'"/></td></tr>
                                                </table>
                                            </td>
                                        </tr>
                                    </table>
                                    <p style="font-size: 14px; color: #555; margin: 0 0 25px 0;">Please review the quote and compare it with other vendor offers (if any).</p>
                                    <table border="0" cellpadding="0" cellspacing="0" width="100%">
                                        <tr>
                                            <td align="center" style="padding: 20px 0;">
                                                <a t-att-href="object.get_portal_url()" style="display: inline-block; padding: 15px 40px; background-color: #007bff; color: white; text-decoration: none; border-radius: 6px; font-weight: bold; font-size: 16px;">Review Quote / مراجعة العرض</a>
                                            </td>
                                        </tr>
                                    </table>
                                    <hr style="border: none; border-top: 2px solid #e0e0e0; margin: 25px 0;"/>
                                    <div dir="rtl" style="text-align: right;">
                                        <p style="font-size: 16px; color: #333; margin: 0 0 15px 0;">عزيزي مالك العقار،</p>
                                        <p style="font-size: 14px; color: #555; margin: 0 0 20px 0;">تم استلام عرض سعر جديد من المورد للمراجعة:</p>
                                        <table border="0" cellpadding="0" cellspacing="0" width="100%" style="background-color: #f8f9fa; border-radius: 8px; margin-bottom: 25px;">
                                            <tr>
                                                <td style="padding: 20px;">
                                                    <table border="0" cellpadding="8" cellspacing="0" width="100%" style="border-right: 4px solid #007bff;" dir="rtl">
                                                        <tr><td width="40%" style="padding: 12px 15px; font-weight: bold; color: #495057; text-align: right;">رقم العرض:</td><td style="padding: 12px 15px; color: #212529; text-align: right;"><t t-out="object.name"/></td></tr>
                                                        <tr><td style="padding: 12px 15px; font-weight: bold; color: #495057; text-align: right;">المورد:</td><td style="padding: 12px 15px; color: #212529; text-align: right;"><t t-out="object.vendor_id.name"/></td></tr>
                                                        <tr><td style="padding: 12px 15px; font-weight: bold; color: #495057; text-align: right;">المشروع:</td><td style="padding: 12px 15px; color: #212529; text-align: right;"><t t-out="object.project_id.name if object.project_id else '-'"/></td></tr>
                                                        <tr><td style="padding: 12px 15px; font-weight: bold; color: #495057; text-align: right;">طلب الشراء:</td><td style="padding: 12px 15px; color: #212529; text-align: right;"><t t-out="object.requisition_id.name if object.requisition_id else '-'"/></td></tr>
                                                        <tr style="background-color: #e8f5e9;"><td style="padding: 12px 15px; font-weight: bold; color: #495057; text-align: right;">المبلغ الإجمالي:</td><td style="padding: 12px 15px; color: #2e7d32; font-size: 18px; font-weight: bold; text-align: right;"><t t-out="'{:,.2f}'.format(object.total_amount)"/> <t t-out="object.company_currency_id.symbol if object.company_currency_id else 'ريال'"/></td></tr>
                                                        <tr><td style="padding: 12px 15px; font-weight: bold; color: #495057; text-align: right;">مدة التوصيل:</td><td style="padding: 12px 15px; color: #212529; text-align: right;"><t t-out="object.delivery_days or '-'"/> يوم</td></tr>
                                                        <tr><td style="padding: 12px 15px; font-weight: bold; color: #495057; text-align: right;">فترة الضمان:</td><td style="padding: 12px 15px; color: #212529; text-align: right;"><t t-out="object.warranty_period or '-'"/></td></tr>
                                                        <tr><td style="padding: 12px 15px; font-weight: bold; color: #495057; text-align: right;">صالح حتى:</td><td style="padding: 12px 15px; color: #212529; text-align: right;"><t t-out="object.validity_date.strftime('%Y-%m-%d') if object.validity_date else '-'"/></td></tr>
                                                    </table>
                                                </td>
                                            </tr>
                                        </table>
                                        <p style="font-size: 14px; color: #555; margin: 0;">يرجى مراجعة العرض ومقارنته مع العروض الأخرى (إن وجدت).</p>
                                    </div>
                                    <table border="0" cellpadding="0" cellspacing="0" width="100%" style="margin-top: 30px; border-top: 2px solid #e0e0e0;">
                                        <tr>
                                            <td style="padding: 20px 0; text-align: center;">
                                                <p style="font-size: 12px; color: #888; margin: 0 0 5px 0;">This is an automated notification from the Saqifaa Real Estate Management System.</p>
                                                <p style="font-size: 12px; color: #888; margin: 0; direction: rtl;">هذا إشعار تلقائي من نظام صقيفة لإدارة العقارات.</p>
                                            </td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                        </table>
                    </td>
                </tr>
            </table>
        </field>
    </record>

    <!-- Email Template: Quote Approved Notification -->
    <record id="email_template_vendor_quote_approved" model="mail.template">
        <field name="name">Vendor Quote Approved / تمت الموافقة على عرض السعر</field>
        <field name="model_id" ref="model_maintenance_vendor_quote"/>
        <field name="subject">Quote Approved - {{ object.name }} / تمت الموافقة على عرضكم</field>
        <field name="email_from">{{ (object.create_uid.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.vendor_id.email if object.vendor_id else '' }}</field>
        <field name="lang">{{ object.vendor_id.lang if object.vendor_id else 'en_US' }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; background-color: #f5f5f5;">
                <div style="background-color: #28a745; color: white; padding: 20px; text-align: center; border-radius: 5px 5px 0 0;">
                    <h2 style="margin: 0;">✓ Quote Approved!</h2>
                    <h3 style="margin: 5px 0 0 0; direction: rtl;">تمت الموافقة على عرضكم!</h3>
                </div>
                
                <div style="background-color: white; padding: 20px; border-radius: 0 0 5px 5px;">
                    <p>Dear {{ object.vendor_id.name }},</p>
                    <p>Congratulations! Your quote <strong>{{ object.name }}</strong> has been approved by the property owner.</p>
                    
                    <div style="background-color: #d4edda; padding: 15px; border-left: 4px solid #28a745; margin: 15px 0;">
                        <p style="margin: 0;"><strong>Purchase Order Created:</strong></p>
                        <p style="margin: 5px 0 0 0;">A purchase order <strong>{{ object.purchase_order_id.name if object.purchase_order_id else 'will be created shortly' }}</strong> has been generated.</p>
                    </div>
                    
                    <t t-if="object.owner_notes">
                    <div style="background-color: #f8f9fa; padding: 15px; margin: 15px 0;">
                        <p style="margin: 0;"><strong>Owner Notes:</strong></p>
                        <p style="margin: 5px 0 0 0;">{{ object.owner_notes }}</p>
                    </div>
                    </t>
                    
                    <hr style="border: none; border-top: 1px solid #e0e0e0; margin: 20px 0;"/>
                    
                    <div style="direction: rtl; text-align: right;">
                        <p>عزيزنا {{ object.vendor_id.name }}،</p>
                        <p>تهانينا! تمت الموافقة على عرضكم <strong>{{ object.name }}</strong> من قبل مالك العقار.</p>
                        
                        <t t-if="object.owner_notes">
                        <div style="background-color: #f8f9fa; padding: 15px; margin: 15px 0;">
                            <p style="margin: 0;"><strong>ملاحظات المالك:</strong></p>
                            <p style="margin: 5px 0 0 0; direction: rtl;">{{ object.owner_notes }}</p>
                        </div>
                        </t>
                    </div>
                    
                    <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #e0e0e0; color: #666; font-size: 12px; text-align: center;">
                        <p>Saqifaa Real Estate Management System</p>
                    </div>
                </div>
            </div>
        </field>
    </record>

    <!-- Email Template: Quote Rejected Notification -->
    <record id="email_template_vendor_quote_rejected" model="mail.template">
        <field name="name">Vendor Quote Rejected / تم رفض عرض السعر</field>
        <field name="model_id" ref="model_maintenance_vendor_quote"/>
        <field name="subject">Quote Not Accepted - {{ object.name }} / لم يتم قبول عرضكم</field>
        <field name="email_from">{{ (object.create_uid.email_formatted or user.email_formatted) }}</field>
        <field name="email_to">{{ object.vendor_id.email if object.vendor_id else '' }}</field>
        <field name="lang">{{ object.vendor_id.lang if object.vendor_id else 'en_US' }}</field>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px; background-color: #f5f5f5;">
                <div style="background-color: #dc3545; color: white; padding: 20px; text-align: center; border-radius: 5px 5px 0 0;">
                    <h2 style="margin: 0;">Quote Not Accepted</h2>
                    <h3 style="margin: 5px 0 0 0; direction: rtl;">لم يتم قبول العرض</h3>
                </div>
                
                <div style="background-color: white; padding: 20px; border-radius: 0 0 5px 5px;">
                    <p>Dear {{ object.vendor_id.name }},</p>
                    <p>We regret to inform you that your quote <strong>{{ object.name }}</strong> was not accepted.</p>
                    
                    <t t-if="object.rejection_reason">
                    <div style="background-color: #f8d7da; padding: 15px; border-left: 4px solid #dc3545; margin: 15px 0;">
                        <p style="margin: 0;"><strong>Rejection Reason:</strong></p>
                        <p style="margin: 5px 0 0 0;">{{ object.rejection_reason }}</p>
                    </div>
                    </t>
                    
                    <p>We appreciate your participation and look forward to working with you on future opportunities.</p>
                    
                    <hr style="border: none; border-top: 1px solid #e0e0e0; margin: 20px 0;"/>
                    
                    <div style="direction: rtl; text-align: right;">
                        <p>عزيزنا {{ object.vendor_id.name }}،</p>
                        <p>نأسف لإبلاغك بأنه لم يتم قبول عرضكم <strong>{{ object.name }}</strong>.</p>
                        
                        <t t-if="object.rejection_reason">
                        <div style="background-color: #f8d7da; padding: 15px; border-right: 4px solid #dc3545; margin: 15px 0;">
                            <p style="margin: 0;"><strong>سبب الرفض:</strong></p>
                            <p style="margin: 5px 0 0 0; direction: rtl;">{{ object.rejection_reason }}</p>
                        </div>
                        </t>
                        
                        <p>نقدر مشاركتكم ونتطلع للعمل معكم في الفرص المستقبلية.</p>
                    </div>
                    
                    <div style="margin-top: 30px; padding-top: 20px; border-top: 1px solid #e0e0e0; color: #666; font-size: 12px; text-align: center;">
                        <p>Saqifaa Real Estate Management System</p>
                    </div>
                </div>
            </div>
        </field>
    </record>

</odoo>
