<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Maintenance Request Reference (MR0001...) -->
        <record id="seq_rental_maintenance_request" model="ir.sequence">
            <field name="name">Maintenance Request Sequence</field>
            <field name="code">rental.maintenance.request</field>
            <field name="prefix">MR</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

        <!-- Sequence for Job Order (####) -->
        <record id="seq_maintenance_job_order" model="ir.sequence">
            <field name="name">Maintenance Job Order Sequence</field>
            <field name="code">maintenance.job.order</field>
            <field name="prefix"></field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>
    </data>
</odoo>
