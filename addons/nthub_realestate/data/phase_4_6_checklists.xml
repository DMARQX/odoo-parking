        <field name="checklist_id" ref="checklist_general_basic"/>
        <field name="description">Work area cleaned and debris removed</field>
        <field name="is_required">True</field>
        <field name="sequence">10</field>
    </record>

    <record id="checklist_item_gen_2" model="job.order.completion.item">
        <field name="checklist_id" ref="checklist_general_basic"/>
        <field name="description">All requested tasks completed</field>
        <field name="is_required">True</field>
        <field name="sequence">20</field>
    </record>

    <record id="checklist_item_gen_3" model="job.order.completion.item">
        <field name="checklist_id" ref="checklist_general_basic"/>
        <field name="description">No damage to surrounding areas</field>
        <field name="is_required">True</field>
        <field name="sequence">30</field>
    </record>
</odoo>
