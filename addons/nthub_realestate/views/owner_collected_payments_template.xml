<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================
         COLLECTED PAYMENTS - MODERN DASHBOARD
         Professional Layout with Sidebar, Charts,
         and SVG Icons
         ============================================ -->

    <template id="portal_owner_collected_payments" name="Collected Payments Dashboard">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="True"/>
            
            <!-- Load Google Fonts - Cairo for Arabic -->
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700&amp;family=Inter:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
            
            <!-- Load ApexCharts from CDN -->
            <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
            
            <style type="text/css">
            /* CSS Variables */
            :root {
                --cp-primary: #667eea;
                --cp-primary-dark: #5a67d8;
                --cp-primary-light: #eef2ff;
                --cp-secondary: #64748b;
                --cp-success: #10b981;
                --cp-success-light: #ecfdf5;
                --cp-warning: #f59e0b;
                --cp-warning-light: #fffbeb;
                --cp-danger: #ef4444;
                --cp-danger-light: #fef2f2;
                --cp-info: #3b82f6;
                --cp-info-light: #eff6ff;
                --cp-teal: #14b8a6;
                --cp-teal-light: #f0fdfa;
                --cp-purple: #8b5cf6;
                --cp-purple-light: #f5f3ff;
                --cp-bg: #f8fafc;
                --cp-card: #ffffff;
                --cp-text: #1e293b;
                --cp-text-muted: #64748b;
                --cp-border: #e2e8f0;
                --cp-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
                --cp-font: 'Cairo', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
                --sidebar-width: 280px;
            }
            
            * { font-family: var(--cp-font) !important; box-sizing: border-box; }
            
            /* Dashboard Wrapper */
            .cp-wrapper { display: flex; min-height: 100vh; background: var(--cp-bg); }
            
            /* Sidebar */
            .cp-sidebar { width: var(--sidebar-width); background: var(--cp-card); border-right: 1px solid var(--cp-border); position: fixed; left: 0; top: 0; height: 100vh; z-index: 1000; display: flex; flex-direction: column; box-shadow: 2px 0 20px rgba(0,0,0,0.04); }
            .cp-sidebar-header { padding: 1.5rem; border-bottom: 1px solid var(--cp-border); display: flex; align-items: center; gap: 1rem; }
            .cp-sidebar-logo { width: 50px; height: 50px; background: linear-gradient(135deg, var(--cp-primary) 0%, var(--cp-purple) 100%); border-radius: 14px; display: flex; align-items: center; justify-content: center; }
            .cp-sidebar-logo svg { width: 26px; height: 26px; color: white; }
            .cp-sidebar-brand h5 { margin: 0; font-weight: 700; color: var(--cp-text); font-size: 1.1rem; }
            .cp-sidebar-brand small { color: var(--cp-text-muted); font-size: 0.8rem; }
            .cp-sidebar-nav { flex: 1; padding: 1rem 0; overflow-y: auto; }
            .cp-nav-section { margin-bottom: 1.5rem; }
            .cp-nav-title { font-size: 0.7rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--cp-text-muted); padding: 0 1.5rem; margin-bottom: 0.75rem; }
            .cp-nav-link { display: flex; align-items: center; padding: 0.875rem 1.5rem; color: var(--cp-text); text-decoration: none; transition: all 0.2s ease; border-left: 3px solid transparent; gap: 0.875rem; }
            .cp-nav-link svg { width: 20px; height: 20px; color: var(--cp-text-muted); transition: all 0.2s ease; flex-shrink: 0; }
            .cp-nav-link:hover { background: var(--cp-bg); color: var(--cp-primary); }
            .cp-nav-link:hover svg { color: var(--cp-primary); }
            .cp-nav-link.active { background: linear-gradient(90deg, var(--cp-primary-light), transparent); color: var(--cp-primary); border-left-color: var(--cp-primary); font-weight: 600; }
            .cp-nav-link.active svg { color: var(--cp-primary); }
            .cp-nav-badge { margin-left: auto; background: linear-gradient(135deg, var(--cp-danger), #f87171); color: white; font-size: 0.7rem; padding: 0.25rem 0.625rem; border-radius: 20px; font-weight: 600; }
            .cp-sidebar-user { padding: 1.25rem 1.5rem; border-top: 1px solid var(--cp-border); background: var(--cp-bg); display: flex; align-items: center; gap: 0.875rem; }
            .cp-user-avatar { width: 42px; height: 42px; background: linear-gradient(135deg, var(--cp-teal), #5eead4); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 700; font-size: 1rem; }
            .cp-user-info h6 { margin: 0; font-size: 0.9rem; font-weight: 600; color: var(--cp-text); }
            .cp-user-info small { color: var(--cp-text-muted); font-size: 0.75rem; }
            
            /* Main Content */
            .cp-main { flex: 1; margin-left: var(--sidebar-width); padding: 2rem; min-height: 100vh; }
            
            /* Page Header */
            .cp-page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 2rem; flex-wrap: wrap; gap: 1rem; }
            .cp-page-title { display: flex; align-items: center; gap: 1rem; }
            .cp-page-title .icon-wrapper { width: 56px; height: 56px; background: linear-gradient(135deg, var(--cp-teal-light), #ccfbf1); border-radius: 16px; display: flex; align-items: center; justify-content: center; }
            .cp-page-title .icon-wrapper svg { width: 28px; height: 28px; color: var(--cp-teal); }
            .cp-page-title h1 { margin: 0; font-size: 1.75rem; font-weight: 700; color: var(--cp-text); }
            .cp-page-title p { margin: 0.25rem 0 0 0; color: var(--cp-text-muted); font-size: 0.95rem; }
            .cp-header-actions { display: flex; gap: 0.75rem; }
            .cp-btn { padding: 0.75rem 1.5rem; border-radius: 12px; font-weight: 600; font-size: 0.9rem; display: inline-flex; align-items: center; gap: 0.5rem; text-decoration: none; transition: all 0.2s ease; border: none; cursor: pointer; }
            .cp-btn svg { width: 18px; height: 18px; }
            .cp-btn-primary { background: linear-gradient(135deg, var(--cp-primary), var(--cp-purple)); color: white; box-shadow: 0 4px 15px rgba(102, 126, 234, 0.35); }
            .cp-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(102, 126, 234, 0.45); color: white; }
            .cp-btn-outline { background: var(--cp-card); color: var(--cp-text); border: 1px solid var(--cp-border); }
            .cp-btn-outline:hover { background: var(--cp-bg); border-color: var(--cp-primary); color: var(--cp-primary); }
            
            /* Stats Cards */
            .cp-stats-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.25rem; margin-bottom: 2rem; }
            .cp-stat-card { background: var(--cp-card); border-radius: 18px; padding: 1.5rem; box-shadow: var(--cp-shadow); transition: all 0.3s ease; position: relative; overflow: hidden; }
            .cp-stat-card::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; }
            .cp-stat-card:hover { transform: translateY(-4px); box-shadow: 0 8px 30px rgba(0,0,0,0.1); }
            .cp-stat-card.teal::before { background: linear-gradient(90deg, var(--cp-teal), #5eead4); }
            .cp-stat-card.primary::before { background: linear-gradient(90deg, var(--cp-primary), var(--cp-purple)); }
            .cp-stat-card.success::before { background: linear-gradient(90deg, var(--cp-success), #34d399); }
            .cp-stat-card.info::before { background: linear-gradient(90deg, var(--cp-info), #60a5fa); }
            .cp-stat-icon { width: 52px; height: 52px; border-radius: 14px; display: flex; align-items: center; justify-content: center; margin-bottom: 1rem; }
            .cp-stat-icon svg { width: 26px; height: 26px; }
            .cp-stat-icon.teal { background: var(--cp-teal-light); color: var(--cp-teal); }
            .cp-stat-icon.primary { background: var(--cp-primary-light); color: var(--cp-primary); }
            .cp-stat-icon.success { background: var(--cp-success-light); color: var(--cp-success); }
            .cp-stat-icon.info { background: var(--cp-info-light); color: var(--cp-info); }
            .cp-stat-value { font-size: 1.875rem; font-weight: 800; color: var(--cp-text); margin-bottom: 0.25rem; line-height: 1.2; }
            .cp-stat-value small { font-size: 0.5em; color: var(--cp-text-muted); font-weight: 600; }
            .cp-stat-label { font-size: 0.875rem; color: var(--cp-text-muted); font-weight: 500; }
            
            /* Charts Row */
            .cp-charts-row { display: grid; grid-template-columns: 2fr 1fr; gap: 1.5rem; margin-bottom: 2rem; }
            .cp-chart-card { background: var(--cp-card); border-radius: 18px; box-shadow: var(--cp-shadow); overflow: hidden; }
            .cp-chart-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--cp-border); display: flex; justify-content: space-between; align-items: center; }
            .cp-chart-header h5 { margin: 0; font-size: 1rem; font-weight: 600; color: var(--cp-text); display: flex; align-items: center; gap: 0.5rem; }
            .cp-chart-header h5 svg { width: 20px; height: 20px; color: var(--cp-text-muted); }
            .cp-chart-body { padding: 1.5rem; }
            
            /* Data Table */
            .cp-table-card { background: var(--cp-card); border-radius: 18px; box-shadow: var(--cp-shadow); overflow: hidden; }
            .cp-table-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--cp-border); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem; }
            .cp-table-header h5 { margin: 0; font-size: 1rem; font-weight: 600; color: var(--cp-text); display: flex; align-items: center; gap: 0.5rem; }
            .cp-table-header h5 svg { width: 20px; height: 20px; color: var(--cp-text-muted); }
            .cp-search-box { position: relative; }
            .cp-search-box input { padding: 0.75rem 1rem 0.75rem 2.75rem; border: 1px solid var(--cp-border); border-radius: 10px; font-size: 0.9rem; width: 280px; transition: all 0.2s ease; background: var(--cp-bg); }
            .cp-search-box input:focus { outline: none; border-color: var(--cp-primary); box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1); background: var(--cp-card); }
            .cp-search-box svg { position: absolute; left: 0.875rem; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; color: var(--cp-text-muted); }
            .cp-table { width: 100%; border-collapse: collapse; }
            .cp-table thead th { background: var(--cp-bg); padding: 1rem 1.25rem; font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: var(--cp-text-muted); border-bottom: 1px solid var(--cp-border); text-align: left; }
            .cp-table tbody td { padding: 1rem 1.25rem; font-size: 0.9rem; color: var(--cp-text); border-bottom: 1px solid var(--cp-border); vertical-align: middle; }
            .cp-table tbody tr { transition: background 0.2s ease; }
            .cp-table tbody tr:hover { background: var(--cp-bg); }
            .cp-table tbody tr:last-child td { border-bottom: none; }
            .cp-badge { display: inline-flex; align-items: center; gap: 0.375rem; padding: 0.5rem 0.875rem; border-radius: 25px; font-size: 0.8rem; font-weight: 600; }
            .cp-badge svg { width: 14px; height: 14px; }
            .cp-badge.paid { background: var(--cp-success-light); color: var(--cp-success); }
            .cp-badge.pending { background: var(--cp-warning-light); color: var(--cp-warning); }
            .cp-table-footer { padding: 1rem 1.5rem; border-top: 1px solid var(--cp-border); display: flex; justify-content: space-between; align-items: center; background: var(--cp-bg); }
            .cp-table-info { font-size: 0.875rem; color: var(--cp-text-muted); }
            
            /* Empty State */
            .cp-empty { text-align: center; padding: 4rem 2rem; }
            .cp-empty .empty-icon { width: 100px; height: 100px; border-radius: 50%; background: var(--cp-bg); display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; }
            .cp-empty .empty-icon svg { width: 48px; height: 48px; color: var(--cp-text-muted); opacity: 0.5; }
            .cp-empty h4 { color: var(--cp-text); margin-bottom: 0.5rem; font-weight: 600; }
            .cp-empty p { color: var(--cp-text-muted); max-width: 300px; margin: 0 auto; }
            
            /* Mobile Menu */
            .cp-mobile-toggle { display: none; position: fixed; bottom: 1.5rem; right: 1.5rem; width: 56px; height: 56px; background: linear-gradient(135deg, var(--cp-primary), var(--cp-purple)); border-radius: 50%; align-items: center; justify-content: center; z-index: 1100; box-shadow: 0 4px 20px rgba(102, 126, 234, 0.4); cursor: pointer; }
            .cp-mobile-toggle svg { width: 24px; height: 24px; color: white; }
            .cp-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.5); z-index: 999; }
            .cp-overlay.active { display: block; }
            
            @media (max-width: 1200px) { .cp-stats-grid { grid-template-columns: repeat(2, 1fr); } .cp-charts-row { grid-template-columns: 1fr; } }
            @media (max-width: 992px) { .cp-sidebar { transform: translateX(-100%); transition: transform 0.3s ease; } .cp-sidebar.open { transform: translateX(0); } .cp-main { margin-left: 0; } .cp-mobile-toggle { display: flex; } }
            @media (max-width: 768px) { .cp-stats-grid { grid-template-columns: 1fr; } .cp-main { padding: 1rem; } .cp-search-box input { width: 100%; } }
            
            /* Animations */
            .cp-fade-in { animation: cpFadeIn 0.4s ease forwards; }
            @keyframes cpFadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
            </style>
            
