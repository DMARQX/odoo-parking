<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================
         OWNER DASHBOARD - PROFESSIONAL LAYOUT
         With Sidebar, ApexCharts, and Soft Colors
         ============================================ -->

    <!-- Main Dashboard Template with Sidebar -->
    <template id="portal_owner_dashboard" name="Owner Dashboard - Professional">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="True"/>
            
            <!-- Load ApexCharts from CDN -->
            <script src="https://cdn.jsdelivr.net/npm/apexcharts"></script>
            
            <!-- Load Custom Dashboard Styles Inline -->
            <style type="text/css">
            /* CSS Variables - Soft Color Palette */
            :root {
                --owner-primary: #5C6BC0;
                --owner-primary-light: #7986CB;
                --owner-primary-dark: #3F51B5;
                --owner-secondary: #78909C;
                --owner-success: #66BB6A;
                --owner-success-light: #E8F5E9;
                --owner-warning: #FFA726;
                --owner-warning-light: #FFF3E0;
                --owner-danger: #EF5350;
                --owner-danger-light: #FFEBEE;
                --owner-info: #42A5F5;
                --owner-info-light: #E3F2FD;
                --owner-purple: #AB47BC;
                --owner-purple-light: #F3E5F5;
                --owner-teal: #26A69A;
                --owner-teal-light: #E0F2F1;
                --owner-bg: #F5F7FA;
                --owner-sidebar-bg: #FFFFFF;
                --owner-card-bg: #FFFFFF;
                --owner-text: #37474F;
                --owner-text-muted: #78909C;
                --owner-border: #E0E0E0;
                --owner-shadow: rgba(0, 0, 0, 0.08);
                --sidebar-width: 280px;
                --sidebar-collapsed-width: 80px;
            }
            .owner-dashboard-wrapper { display: flex; min-height: 100vh; background-color: var(--owner-bg); }
            .owner-sidebar { width: var(--sidebar-width); background: var(--owner-sidebar-bg); border-right: 1px solid var(--owner-border); position: fixed; left: 0; top: 0; height: 100vh; z-index: 1000; transition: all 0.3s ease; box-shadow: 2px 0 10px var(--owner-shadow); display: flex; flex-direction: column; }
            .owner-sidebar.collapsed { width: var(--sidebar-collapsed-width); }
            .owner-sidebar.collapsed .sidebar-text, .owner-sidebar.collapsed .sidebar-logo-text { display: none; }
            .owner-sidebar.collapsed .nav-link { justify-content: center; padding: 1rem; }
            .owner-sidebar.collapsed .nav-link i { margin-right: 0; font-size: 1.3rem; }
            .sidebar-header { padding: 1.5rem; border-bottom: 1px solid var(--owner-border); display: flex; align-items: center; gap: 1rem; }
            .sidebar-logo { width: 48px; height: 48px; background: linear-gradient(135deg, var(--owner-primary) 0%, var(--owner-primary-dark) 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
            .sidebar-logo i { color: white; font-size: 1.5rem; }
            .sidebar-logo-text h5 { margin: 0; font-weight: 700; color: var(--owner-text); font-size: 1.1rem; }
            .sidebar-logo-text small { color: var(--owner-text-muted); font-size: 0.8rem; }
            .sidebar-nav { flex: 1; padding: 1rem 0; overflow-y: auto; }
            .nav-section { margin-bottom: 1.5rem; }
            .nav-section-title { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--owner-text-muted); padding: 0 1.5rem; margin-bottom: 0.5rem; }
            .owner-sidebar.collapsed .nav-section-title { display: none; }
            .sidebar-nav .nav-link { display: flex; align-items: center; padding: 0.75rem 1.5rem; color: var(--owner-text); text-decoration: none; transition: all 0.2s ease; border-left: 3px solid transparent; margin: 2px 0; }
            .sidebar-nav .nav-link i { width: 24px; margin-right: 12px; font-size: 1.1rem; color: var(--owner-text-muted); transition: all 0.2s ease; }
            .sidebar-nav .nav-link:hover { background-color: var(--owner-bg); color: var(--owner-primary); }
            .sidebar-nav .nav-link:hover i { color: var(--owner-primary); }
            .sidebar-nav .nav-link.active { background-color: rgba(92, 107, 192, 0.1); color: var(--owner-primary); border-left-color: var(--owner-primary); font-weight: 600; }
            .sidebar-nav .nav-link.active i { color: var(--owner-primary); }
            .nav-badge { margin-left: auto; background-color: var(--owner-danger); color: white; font-size: 0.7rem; padding: 0.2rem 0.5rem; border-radius: 10px; font-weight: 600; }
            .sidebar-user { padding: 1rem 1.5rem; border-top: 1px solid var(--owner-border); background-color: var(--owner-bg); }
            .user-avatar { width: 40px; height: 40px; background: linear-gradient(135deg, var(--owner-teal) 0%, var(--owner-teal-light) 100%); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: white; font-weight: 600; font-size: 1rem; }
            .user-info h6 { margin: 0; font-size: 0.9rem; font-weight: 600; color: var(--owner-text); }
            .user-info small { color: var(--owner-text-muted); font-size: 0.75rem; }
            .sidebar-toggle { position: absolute; right: -12px; top: 70px; width: 24px; height: 24px; background: var(--owner-primary); border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; z-index: 1001; box-shadow: 0 2px 8px var(--owner-shadow); transition: all 0.3s ease; }
            .sidebar-toggle i { color: white; font-size: 0.8rem; transition: transform 0.3s ease; }
            .owner-sidebar.collapsed .sidebar-toggle i { transform: rotate(180deg); }
            .owner-main-content { flex: 1; margin-left: var(--sidebar-width); padding: 2rem; transition: margin-left 0.3s ease; min-height: 100vh; }
            .owner-sidebar.collapsed + .owner-main-content { margin-left: var(--sidebar-collapsed-width); }
            .dashboard-header { margin-bottom: 2rem; }
            .dashboard-header h1 { font-size: 1.75rem; font-weight: 700; color: var(--owner-text); margin-bottom: 0.25rem; }
            .dashboard-header p { color: var(--owner-text-muted); margin: 0; }
            .stat-cards-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1.25rem; margin-bottom: 2rem; }
            .stat-card { background: var(--owner-card-bg); border-radius: 16px; padding: 1.5rem; box-shadow: 0 2px 12px var(--owner-shadow); transition: all 0.3s ease; border: 1px solid transparent; cursor: pointer; text-decoration: none; color: inherit; display: block; opacity: 0; }
            .stat-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px var(--owner-shadow); border-color: var(--owner-primary-light); }
            .stat-card-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem; }
            .stat-card-icon { width: 48px; height: 48px; border-radius: 12px; display: flex; align-items: center; justify-content: center; font-size: 1.25rem; }
            .stat-card-icon.primary { background-color: rgba(92, 107, 192, 0.15); color: var(--owner-primary); }
            .stat-card-icon.success { background-color: var(--owner-success-light); color: var(--owner-success); }
            .stat-card-icon.warning { background-color: var(--owner-warning-light); color: var(--owner-warning); }
            .stat-card-icon.danger { background-color: var(--owner-danger-light); color: var(--owner-danger); }
            .stat-card-icon.info { background-color: var(--owner-info-light); color: var(--owner-info); }
            .stat-card-icon.purple { background-color: var(--owner-purple-light); color: var(--owner-purple); }
            .stat-card-icon.teal { background-color: var(--owner-teal-light); color: var(--owner-teal); }
            .stat-card-value { font-size: 1.75rem; font-weight: 700; color: var(--owner-text); margin-bottom: 0.25rem; line-height: 1.2; }
            .stat-card-label { font-size: 0.85rem; color: var(--owner-text-muted); font-weight: 500; }
            .chart-card { background: var(--owner-card-bg); border-radius: 16px; box-shadow: 0 2px 12px var(--owner-shadow); overflow: hidden; margin-bottom: 1.5rem; }
            .chart-card-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--owner-border); display: flex; justify-content: space-between; align-items: center; }
            .chart-card-header h5 { margin: 0; font-size: 1rem; font-weight: 600; color: var(--owner-text); }
            .chart-card-body { padding: 1.5rem; }
            .data-table-card { background: var(--owner-card-bg); border-radius: 16px; box-shadow: 0 2px 12px var(--owner-shadow); overflow: hidden; }
            .data-table-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--owner-border); display: flex; justify-content: space-between; align-items: center; }
            .data-table-header h5 { margin: 0; font-size: 1rem; font-weight: 600; color: var(--owner-text); }
            .data-table { width: 100%; border-collapse: collapse; }
            .data-table thead th { background-color: var(--owner-bg); padding: 1rem 1.25rem; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--owner-text-muted); border-bottom: 1px solid var(--owner-border); text-align: left; }
            .data-table tbody td { padding: 1rem 1.25rem; font-size: 0.9rem; color: var(--owner-text); border-bottom: 1px solid var(--owner-border); vertical-align: middle; }
            .data-table tbody tr:hover { background-color: var(--owner-bg); }
            .status-badge { display: inline-flex; align-items: center; padding: 0.35rem 0.75rem; border-radius: 20px; font-size: 0.75rem; font-weight: 600; }
            .status-badge.available { background-color: var(--owner-success-light); color: var(--owner-success); }
            .status-badge.rented { background-color: var(--owner-warning-light); color: var(--owner-warning); }
            .activity-card { background: var(--owner-card-bg); border-radius: 16px; box-shadow: 0 2px 12px var(--owner-shadow); height: 100%; }
            .activity-card-header { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--owner-border); display: flex; justify-content: space-between; align-items: center; }
            .activity-card-header h5 { margin: 0; font-size: 1rem; font-weight: 600; color: var(--owner-text); }
            .activity-list { padding: 1rem 1.5rem; max-height: 350px; overflow-y: auto; }
            .activity-item { display: flex; gap: 1rem; padding: 0.75rem 0; border-bottom: 1px solid var(--owner-border); text-decoration: none; }
            .activity-item:last-child { border-bottom: none; }
            .activity-icon { width: 36px; height: 36px; border-radius: 10px; display: flex; align-items: center; justify-content: center; font-size: 0.9rem; flex-shrink: 0; }
            .activity-content { flex: 1; }
            .activity-content h6 { margin: 0 0 0.25rem 0; font-size: 0.9rem; font-weight: 500; color: var(--owner-text); }
            .activity-content p { margin: 0; font-size: 0.8rem; color: var(--owner-text-muted); }
            .activity-time { font-size: 0.75rem; color: var(--owner-text-muted); white-space: nowrap; }
            .quick-actions { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
            .quick-action-btn { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 1.5rem; background: var(--owner-card-bg); border-radius: 16px; box-shadow: 0 2px 12px var(--owner-shadow); text-decoration: none; transition: all 0.3s ease; border: 2px solid transparent; }
            .quick-action-btn:hover { transform: translateY(-4px); border-color: var(--owner-primary); box-shadow: 0 8px 24px var(--owner-shadow); }
            .quick-action-btn i { font-size: 2rem; margin-bottom: 0.75rem; color: var(--owner-primary); }
            .quick-action-btn span { font-size: 0.85rem; font-weight: 600; color: var(--owner-text); }
            .animate-fade-in { animation: fadeInUp 0.5s ease forwards; }
            @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
            @media (max-width: 992px) { .owner-sidebar { transform: translateX(-100%); } .owner-sidebar.mobile-open { transform: translateX(0); } .owner-main-content { margin-left: 0; } .mobile-menu-toggle { display: flex !important; } }
            @media (max-width: 768px) { .stat-cards-row { grid-template-columns: repeat(2, 1fr); } .owner-main-content { padding: 1rem; } }
            @media (max-width: 576px) { .stat-cards-row { grid-template-columns: 1fr; } }
            .mobile-menu-toggle { display: none; position: fixed; bottom: 1.5rem; right: 1.5rem; width: 56px; height: 56px; background: var(--owner-primary); border-radius: 50%; align-items: center; justify-content: center; z-index: 1100; box-shadow: 0 4px 16px rgba(92, 107, 192, 0.4); cursor: pointer; }
            .mobile-menu-toggle i { color: white; font-size: 1.5rem; }
            .sidebar-overlay { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.5); z-index: 999; }
            .sidebar-overlay.active { display: block; }
            .btn-chart-action { padding: 0.4rem 0.8rem; font-size: 0.75rem; border-radius: 6px; border: 1px solid var(--owner-border); background: transparent; color: var(--owner-text-muted); cursor: pointer; transition: all 0.2s ease; }
            .btn-chart-action:hover, .btn-chart-action.active { background: var(--owner-primary); border-color: var(--owner-primary); color: white; }
            .chart-actions { display: flex; gap: 0.5rem; }
            </style>
            
            <div class="owner-dashboard-wrapper">
                <!-- Sidebar Overlay for Mobile -->
                <div class="sidebar-overlay"></div>
                
                <!-- Sidebar Navigation -->
                <aside class="owner-sidebar">
                    <div class="sidebar-toggle">
                        <i class="fa fa-chevron-left"></i>
                    </div>
                    
                    <!-- Sidebar Header -->
                    <div class="sidebar-header">
                        <div class="sidebar-logo">
                            <i class="fa fa-building"></i>
                        </div>
                        <div class="sidebar-logo-text">
                            <h5>Owner Portal</h5>
                            <small>Real Estate Management</small>
                        </div>
                    </div>
                    
                    <!-- Sidebar Navigation -->
                    <nav class="sidebar-nav">
                        <div class="nav-section">
                            <div class="nav-section-title sidebar-text">Main Menu</div>
                            <a href="/my/properties" class="nav-link active">
                                <i class="fa fa-dashboard"></i>
                                <span class="sidebar-text">Dashboard</span>
                            </a>
                            <a href="/my/properties" class="nav-link">
                                <i class="fa fa-building"></i>
                                <span class="sidebar-text">My Properties</span>
                            </a>
                        </div>
                        
                        <div class="nav-section">
                            <div class="nav-section-title sidebar-text">Financials</div>
                            <a href="/my/collected-payments" class="nav-link">
                                <i class="fa fa-money"></i>
                                <span class="sidebar-text">Collected Payments</span>
                            </a>
                            <a href="/my/receivables" class="nav-link">
                                <i class="fa fa-file-invoice-dollar"></i>
                                <span class="sidebar-text">Receivables</span>
                                <t t-if="total_receivables > 0">
                                    <span class="nav-badge"><t t-esc="'%.0f' % (total_receivables / 1000)"/>K</span>
                                </t>
                            </a>
                        </div>
                        
                        <div class="nav-section">
                            <div class="nav-section-title sidebar-text">Operations</div>
                            <a href="/my/vendor_quotes" class="nav-link">
                                <i class="fa fa-check-circle"></i>
                                <span class="sidebar-text">Pending Approvals</span>
                                <t t-if="pending_vendor_quotes > 0">
                                    <span class="nav-badge"><t t-esc="pending_vendor_quotes"/></span>
                                </t>
                            </a>
                            <a href="/my/requests" class="nav-link">
                                <i class="fa fa-comment"></i>
                                <span class="sidebar-text">My Requests</span>
                            </a>
                            <a href="/my/requests/new" class="nav-link">
                                <i class="fa fa-plus-circle"></i>
                                <span class="sidebar-text">New Request</span>
                            </a>
                        </div>
                    </nav>
                    
                    <!-- Sidebar User -->
                    <div class="sidebar-user d-flex align-items-center gap-3">
                        <div class="user-avatar">
                            <t t-esc="request.env.user.name[:2].upper()"/>
                        </div>
                        <div class="user-info sidebar-text">
                            <h6><t t-esc="request.env.user.name"/></h6>
                            <small>Property Owner</small>
                        </div>
                    </div>
                </aside>
                
                <!-- Main Content -->
                <main class="owner-main-content">
                    <!-- Mobile Menu Toggle -->
                    <div class="mobile-menu-toggle">
                        <i class="fa fa-bars"></i>
                    </div>
                    
                    <!-- Dashboard Header -->
                    <div class="dashboard-header">
                        <h1>Dashboard Overview</h1>
                        <p>Welcome back, <t t-esc="request.env.user.name"/>! Here's what's happening with your properties.</p>
                    </div>
                    
                    <!-- Statistics Cards -->
                    <div class="stat-cards-row">
                        <!-- Total Projects -->
                        <a href="/my/properties" class="stat-card animate-fade-in">
                            <div class="stat-card-header">
                                <div class="stat-card-icon primary">
                                    <i class="fa fa-building"></i>
                                </div>
                            </div>
                            <div class="stat-card-value"><t t-esc="property_count"/></div>
                            <div class="stat-card-label">Total Projects</div>
                        </a>
                        
                        <!-- Total Units -->
                        <div class="stat-card animate-fade-in">
                            <div class="stat-card-header">
                                <div class="stat-card-icon info">
                                    <i class="fa fa-th-large"></i>
                                </div>
                            </div>
                            <div class="stat-card-value"><t t-esc="total_units"/></div>
                            <div class="stat-card-label">Total Units</div>
                        </div>
                        
                        <!-- Available Units -->
                        <div class="stat-card animate-fade-in">
                            <div class="stat-card-header">
                                <div class="stat-card-icon warning">
                                    <i class="fa fa-key"></i>
                                </div>
                            </div>
                            <div class="stat-card-value"><t t-esc="available_units"/></div>
                            <div class="stat-card-label">Available Units</div>
                        </div>
                        
                        <!-- Rented Units -->
                        <div class="stat-card animate-fade-in">
                            <div class="stat-card-header">
                                <div class="stat-card-icon success">
                                    <i class="fa fa-users"></i>
                                </div>
                            </div>
                            <div class="stat-card-value"><t t-esc="rented_units"/></div>
                            <div class="stat-card-label">Rented Units</div>
                        </div>
                        
                        <!-- Monthly Revenue -->
                        <div class="stat-card animate-fade-in">
                            <div class="stat-card-header">
                                <div class="stat-card-icon purple">
                                    <i class="fa fa-line-chart"></i>
                                </div>
                            </div>
                            <div class="stat-card-value">
                                <t t-esc="'%.0f' % (monthly_revenue or 0)"/>
                                <small style="font-size: 0.5em;"><t t-esc="company_currency.symbol"/></small>
                            </div>
                            <div class="stat-card-label">Monthly Revenue</div>
                        </div>
                        
                        <!-- Total Collected -->
                        <a href="/my/collected-payments" class="stat-card animate-fade-in">
                            <div class="stat-card-header">
                                <div class="stat-card-icon teal">
                                    <i class="fa fa-check-circle"></i>
                                </div>
                            </div>
                            <div class="stat-card-value">
                                <t t-esc="'%.0f' % (total_collected or 0)"/>
                                <small style="font-size: 0.5em;"><t t-esc="company_currency.symbol"/></small>
                            </div>
                            <div class="stat-card-label">Total Collected</div>
                        </a>
                        
                        <!-- Total Receivables -->
                        <a href="/my/receivables" class="stat-card animate-fade-in">
                            <div class="stat-card-header">
                                <div class="stat-card-icon danger">
                                    <i class="fa fa-clock-o"></i>
                                </div>
                            </div>
                            <div class="stat-card-value">
                                <t t-esc="'%.0f' % (total_receivables or 0)"/>
                                <small style="font-size: 0.5em;"><t t-esc="company_currency.symbol"/></small>
                            </div>
                            <div class="stat-card-label">Total Receivables</div>
                        </a>
                        
                        <!-- Pending Approvals -->
                        <a href="/my/vendor_quotes" class="stat-card animate-fade-in">
                            <div class="stat-card-header">
                                <div class="stat-card-icon warning">
                                    <i class="fa fa-exclamation-circle"></i>
                                </div>
                            </div>
                            <div class="stat-card-value"><t t-esc="pending_vendor_quotes or 0"/></div>
                            <div class="stat-card-label">Pending Approvals</div>
                        </a>
                    </div>
                    
                    <!-- Charts Row -->
                    <div class="row g-4 mb-4">
                        <!-- Revenue Chart -->
                        <div class="col-lg-8">
                            <div class="chart-card">
                                <div class="chart-card-header">
                                    <h5><i class="fa fa-line-chart me-2"></i>Revenue Overview</h5>
                                    <div class="chart-actions">
                                        <button class="btn-chart-action active" data-action="6months">6 Months</button>
                                        <button class="btn-chart-action" data-action="year">Year</button>
                                    </div>
                                </div>
                                <div class="chart-card-body">
                                    <div id="revenue-chart" 
                                         t-att-data-chart-data="json.dumps(chart_data.get('revenue', {})) if chart_data else '{}'"
                                         style="height: 320px;"></div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Units Distribution Chart -->
                        <div class="col-lg-4">
                            <div class="chart-card">
                                <div class="chart-card-header">
                                    <h5><i class="fa fa-pie-chart me-2"></i>Units Distribution</h5>
                                </div>
                                <div class="chart-card-body">
                                    <div id="units-chart" 
                                         t-att-data-chart-data="json.dumps({'available': available_units or 0, 'rented': rented_units or 0, 'sold': sold_units_count or 0})"
                                         style="height: 280px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Second Row: Occupancy + Collection by Project -->
                    <div class="row g-4 mb-4">
                        <!-- Occupancy Rate -->
                        <div class="col-lg-4">
                            <div class="chart-card">
                                <div class="chart-card-header">
                                    <h5><i class="fa fa-percent me-2"></i>Occupancy Rate</h5>
                                </div>
                                <div class="chart-card-body">
                                    <t t-set="occupancy_rate" t-value="(rented_units / total_units * 100) if total_units else 0"/>
                                    <div id="occupancy-chart" 
                                         t-att-data-chart-data="json.dumps({'rate': round(occupancy_rate, 1)})"
                                         style="height: 280px;"></div>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Collection by Project -->
                        <div class="col-lg-8">
                            <div class="chart-card">
                                <div class="chart-card-header">
                                    <h5><i class="fa fa-bar-chart me-2"></i>Collection by Project</h5>
                                </div>
                                <div class="chart-card-body">
                                    <div id="collection-chart" 
                                         t-att-data-chart-data="json.dumps(chart_data.get('collection', {})) if chart_data else '{}'"
                                         style="height: 320px;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Projects Table + Recent Activity -->
                    <div class="row g-4">
                        <!-- Projects Table -->
                        <div class="col-lg-8">
                            <div class="data-table-card">
                                <div class="data-table-header">
                                    <h5><i class="fa fa-building me-2"></i>Your Properties</h5>
                                    <a href="/my/properties" class="btn btn-sm btn-outline-primary">View All</a>
                                </div>
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>Property Name</th>
                                            <th class="text-center">Units</th>
                                            <th class="text-center">Rented</th>
                                            <th class="text-center">Available</th>
                                            <th class="text-end">Contract Value</th>
                                            <th class="text-end">Receivables</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-if="not properties">
                                            <tr>
                                                <td colspan="6" class="text-center py-5 text-muted">
                                                    <i class="fa fa-building fa-2x mb-2"></i>
                                                    <p class="mb-0">No properties found</p>
                                                </td>
                                            </tr>
                                        </t>
                                        <t t-foreach="properties[:5]" t-as="prop">
                                            <tr>
                                                <td>
                                                    <a t-att-href="'/my/property/%s' % prop.id" class="fw-bold text-decoration-none">
                                                        <t t-esc="prop.name"/>
                                                    </a>
                                                    <br/>
                                                    <small class="text-muted" t-if="prop.street" t-esc="prop.street"/>
                                                </td>
                                                <td class="text-center fw-bold"><t t-esc="prop.quantity"/></td>
                                                <td class="text-center">
                                                    <span class="status-badge rented"><t t-esc="prop.rented_units_count"/></span>
                                                </td>
                                                <td class="text-center">
                                                    <span class="status-badge available"><t t-esc="prop.available_units_count"/></span>
                                                </td>
                                                <td class="text-end fw-bold" style="color: var(--owner-primary);">
                                                    <t t-esc="'%.0f' % (project_financials.get(prop.id, {}).get('contract_value', 0.0))"/>
                                                    <small class="text-muted"><t t-esc="company_currency.symbol"/></small>
                                                </td>
                                                <td class="text-end fw-bold" style="color: var(--owner-danger);">
                                                    <t t-esc="'%.0f' % (project_financials.get(prop.id, {}).get('total_receivables', 0.0))"/>
                                                    <small class="text-muted"><t t-esc="company_currency.symbol"/></small>
                                                </td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                        
                        <!-- Recent Activity -->
                        <div class="col-lg-4">
                            <div class="activity-card">
                                <div class="activity-card-header">
                                    <h5><i class="fa fa-clock-o me-2"></i>Recent Requests</h5>
                                    <a href="/my/requests" class="btn btn-sm btn-outline-primary">View All</a>
                                </div>
                                <div class="activity-list">
                                    <t t-if="not requests">
                                        <div class="text-center py-4 text-muted">
                                            <i class="fa fa-inbox fa-2x mb-2"></i>
                                            <p class="mb-0">No recent requests</p>
                                        </div>
                                    </t>
                                    <t t-foreach="requests" t-as="req">
                                        <a t-att-href="'/my/request/%s' % req.id" class="activity-item text-decoration-none">
                                            <div class="activity-icon" t-attf-style="background-color: {{ 'var(--owner-info-light)' if req.state == 'new' else 'var(--owner-warning-light)' if req.state == 'in_progress' else 'var(--owner-success-light)' }}; color: {{ 'var(--owner-info)' if req.state == 'new' else 'var(--owner-warning)' if req.state == 'in_progress' else 'var(--owner-success)' }};">
                                                <i t-attf-class="fa {{ 'fa-envelope' if req.state == 'new' else 'fa-spinner' if req.state == 'in_progress' else 'fa-check' }}"></i>
                                            </div>
                                            <div class="activity-content">
                                                <h6><t t-esc="req.subject[:30]"/>...</h6>
                                                <p><t t-esc="dict(req.fields_get(['request_type'])['request_type']['selection'])[req.request_type]"/></p>
                                            </div>
                                            <div class="activity-time">
                                                <span t-field="req.create_date" t-options='{"widget": "relative"}'/>
                                            </div>
                                        </a>
                                    </t>
                                </div>
                                <div class="p-3 border-top">
                                    <a href="/my/requests/new" class="btn btn-primary w-100">
                                        <i class="fa fa-plus me-2"></i>Submit New Request
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Quick Actions -->
                    <div class="mt-4">
                        <h5 class="mb-3" style="color: var(--owner-text); font-weight: 600;">Quick Actions</h5>
                        <div class="quick-actions">
                            <a href="/my/collected-payments" class="quick-action-btn">
                                <i class="fa fa-money" style="color: var(--owner-teal);"></i>
                                <span>View Payments</span>
                            </a>
                            <a href="/my/receivables" class="quick-action-btn">
                                <i class="fa fa-file-text-o" style="color: var(--owner-danger);"></i>
                                <span>Check Receivables</span>
                            </a>
                            <a href="/my/vendor_quotes" class="quick-action-btn">
                                <i class="fa fa-check-square-o" style="color: var(--owner-warning);"></i>
                                <span>Approve Quotes</span>
                            </a>
                            <a href="/my/requests/new" class="quick-action-btn">
                                <i class="fa fa-plus-circle" style="color: var(--owner-success);"></i>
                                <span>New Request</span>
                            </a>
                        </div>
                    </div>
                </main>
            </div>
            
            <!-- Inline Chart Initialization Script -->
            <script type="text/javascript">
                document.addEventListener('DOMContentLoaded', function() {
                    // Wait for ApexCharts
                    if (typeof ApexCharts === 'undefined') {
                        console.log('ApexCharts not loaded yet');
                        return;
                    }

                    // Sidebar Toggle
                    var sidebar = document.querySelector('.owner-sidebar');
                    var toggle = document.querySelector('.sidebar-toggle');
                    var mobileToggle = document.querySelector('.mobile-menu-toggle');
                    var overlay = document.querySelector('.sidebar-overlay');

                    if (toggle) {
                        toggle.addEventListener('click', function() {
                            sidebar.classList.toggle('collapsed');
                        });
                    }

                    if (mobileToggle) {
                        mobileToggle.addEventListener('click', function() {
                            sidebar.classList.add('mobile-open');
                            overlay.classList.add('active');
                        });
                    }

                    if (overlay) {
                        overlay.addEventListener('click', function() {
                            sidebar.classList.remove('mobile-open');
                            overlay.classList.remove('active');
                        });
                    }

                    // Chart Data from template
                    var chartData = <t t-raw="json.dumps(chart_data) if chart_data else '{}'" />;
                    
                    // Revenue Chart
                    var revenueEl = document.getElementById('revenue-chart');
                    if (revenueEl &amp;&amp; chartData.revenue) {
                        var revenueOptions = {
                            series: [{
                                name: 'Expected',
                                data: chartData.revenue.revenue || []
                            }, {
                                name: 'Collected',
                                data: chartData.revenue.collected || []
                            }],
                            chart: {
                                type: 'area',
                                height: 320,
                                toolbar: { show: false },
                                fontFamily: 'inherit',
                                animations: { enabled: true, easing: 'easeinout', speed: 800 }
                            },
                            colors: ['#5C6BC0', '#66BB6A'],
                            fill: {
                                type: 'gradient',
                                gradient: { shadeIntensity: 1, opacityFrom: 0.4, opacityTo: 0.1, stops: [0, 90, 100] }
                            },
                            stroke: { curve: 'smooth', width: 3 },
                            dataLabels: { enabled: false },
                            xaxis: {
                                categories: chartData.revenue.months || [],
                                axisBorder: { show: false },
                                axisTicks: { show: false },
                                labels: { style: { colors: '#78909C', fontSize: '12px' } }
                            },
                            yaxis: {
                                labels: {
                                    style: { colors: '#78909C', fontSize: '12px' },
                                    formatter: function(val) { return val.toLocaleString(); }
                                }
                            },
                            grid: { borderColor: '#E0E0E0', strokeDashArray: 4 },
                            legend: { position: 'top', horizontalAlign: 'right', fontSize: '13px', markers: { radius: 4 } },
                            tooltip: { y: { formatter: function(val) { return val.toLocaleString() + ' SAR'; } } }
                        };
                        new ApexCharts(revenueEl, revenueOptions).render();
                    }

                    // Units Donut Chart
                    var unitsEl = document.getElementById('units-chart');
                    if (unitsEl) {
                        var available = <t t-esc="available_units or 0"/>;
                        var rented = <t t-esc="rented_units or 0"/>;
                        var sold = <t t-esc="sold_units_count or 0"/>;
                        
                        var unitsOptions = {
                            series: [available, rented, sold],
                            labels: ['Available', 'Rented', 'Sold'],
                            chart: { type: 'donut', height: 280, animations: { enabled: true, easing: 'easeinout', speed: 800 } },
                            colors: ['#66BB6A', '#FFA726', '#42A5F5'],
                            plotOptions: {
                                pie: {
                                    donut: {
                                        size: '70%',
                                        labels: {
                                            show: true,
                                            name: { show: true, fontSize: '14px', fontWeight: 600, color: '#37474F' },
                                            value: { show: true, fontSize: '24px', fontWeight: 700, color: '#37474F' },
                                            total: { show: true, label: 'Total Units', fontSize: '14px', fontWeight: 500, color: '#78909C' }
                                        }
                                    }
                                }
                            },
                            legend: { position: 'bottom', fontSize: '13px', markers: { radius: 4 } },
                            dataLabels: { enabled: false },
                            stroke: { show: false }
                        };
                        new ApexCharts(unitsEl, unitsOptions).render();
                    }

                    // Occupancy Rate Radial Chart
                    var occupancyEl = document.getElementById('occupancy-chart');
                    if (occupancyEl) {
                        var totalUnits = <t t-esc="total_units or 0"/>;
                        var rentedUnits = <t t-esc="rented_units or 0"/>;
                        var occupancyRate = totalUnits > 0 ? Math.round((rentedUnits / totalUnits) * 100) : 0;
                        
                        var occupancyOptions = {
                            series: [occupancyRate],
                            chart: { type: 'radialBar', height: 280, animations: { enabled: true, easing: 'easeinout', speed: 800 } },
                            colors: ['#5C6BC0'],
                            plotOptions: {
                                radialBar: {
                                    hollow: { size: '70%' },
                                    track: { background: '#E8EAF6', strokeWidth: '100%' },
                                    dataLabels: {
                                        show: true,
                                        name: { show: true, fontSize: '14px', fontWeight: 500, color: '#78909C', offsetY: 20 },
                                        value: {
                                            show: true, fontSize: '32px', fontWeight: 700, color: '#37474F', offsetY: -15,
                                            formatter: function(val) { return val + '%'; }
                                        }
                                    }
                                }
                            },
                            labels: ['Occupancy Rate'],
                            stroke: { lineCap: 'round' }
                        };
                        new ApexCharts(occupancyEl, occupancyOptions).render();
                    }

                    // Collection by Project Bar Chart
                    var collectionEl = document.getElementById('collection-chart');
                    if (collectionEl &amp;&amp; chartData.collection) {
                        var collectionOptions = {
                            series: [{
                                name: 'Collected',
                                data: chartData.collection.collected || []
                            }, {
                                name: 'Receivables',
                                data: chartData.collection.receivables || []
                            }],
                            chart: { type: 'bar', height: 320, stacked: true, toolbar: { show: false }, animations: { enabled: true, easing: 'easeinout', speed: 800 } },
                            colors: ['#66BB6A', '#EF5350'],
                            plotOptions: { bar: { horizontal: false, borderRadius: 6, columnWidth: '50%' } },
                            dataLabels: { enabled: false },
                            xaxis: {
                                categories: chartData.collection.projects || [],
                                axisBorder: { show: false },
                                axisTicks: { show: false },
                                labels: { style: { colors: '#78909C', fontSize: '12px' }, rotate: -45 }
                            },
                            yaxis: {
                                labels: {
                                    style: { colors: '#78909C', fontSize: '12px' },
                                    formatter: function(val) { return val.toLocaleString(); }
                                }
                            },
                            grid: { borderColor: '#E0E0E0', strokeDashArray: 4 },
                            legend: { position: 'top', horizontalAlign: 'right', fontSize: '13px', markers: { radius: 4 } },
                            tooltip: { y: { formatter: function(val) { return val.toLocaleString() + ' SAR'; } } }
                        };
                        new ApexCharts(collectionEl, collectionOptions).render();
                    }

                    // Animate stat cards
                    document.querySelectorAll('.stat-card').forEach(function(card, index) {
                        setTimeout(function() {
                            card.classList.add('animate-fade-in');
                        }, index * 50);
                    });
                });
            </script>
        </t>
    </template>

</odoo>