<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- TENANT PORTAL STYLES -->
    <template id="tenant_portal_styles" name="Tenant Portal Styles">
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
        <style type="text/css">
        :root { --t-primary:#0EA5E9; --t-bg:#F8FAFC; --t-card:#FFFFFF; --t-text:#1E293B; --t-muted:#64748B; --t-border:#E2E8F0; --t-success:#10B981; --t-warning:#F59E0B; --t-danger:#EF4444; --sidebar-w:280px; }
        * { font-family: 'Cairo', sans-serif !important; }
        .t-wrapper { display:flex; min-height:100vh; background:var(--t-bg); }
        .t-sidebar { width:var(--sidebar-w); background:var(--t-card); border-right:1px solid var(--t-border); position:fixed; left:0; top:0; height:100vh; z-index:1000; box-shadow:2px 0 10px rgba(0,0,0,0.08); }
        .t-sidebar-header { padding:1.5rem; border-bottom:1px solid var(--t-border); display:flex; align-items:center; gap:1rem; }
        .t-sidebar-logo { width:48px; height:48px; background:linear-gradient(135deg,var(--t-primary),#0284C7); border-radius:12px; display:flex; align-items:center; justify-content:center; }
        .t-sidebar-logo svg { color:white; width:24px; height:24px; }
        .t-sidebar-text h5 { margin:0; font-weight:700; color:var(--t-text); }
        .t-sidebar-text small { color:var(--t-muted); }
        .t-nav { padding:1rem 0; }
        .t-nav-section { margin-bottom:1.5rem; }
        .t-nav-title { font-size:0.7rem; font-weight:600; text-transform:uppercase; color:var(--t-muted); padding:0 1.5rem; margin-bottom:0.5rem; }
        .t-nav a { display:flex; align-items:center; padding:0.75rem 1.5rem; color:var(--t-text); text-decoration:none; border-left:3px solid transparent; }
        .t-nav a:hover { background:var(--t-bg); color:var(--t-primary); }
        .t-nav a.active { background:rgba(14,165,233,0.1); color:var(--t-primary); border-left-color:var(--t-primary); font-weight:600; }
        .t-nav svg { width:20px; height:20px; margin-right:12px; }
        .t-main { flex:1; margin-left:var(--sidebar-w); padding:2rem; }
        .t-header h1 { font-size:1.75rem; font-weight:700; color:var(--t-text); margin:0; }
        .t-header p { color:var(--t-muted); margin:0.5rem 0 0 0; }
        .t-stats { display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:1.5rem; margin:2rem 0; }
        .t-stat { background:var(--t-card); border-radius:16px; padding:1.5rem; border:1px solid var(--t-border); }
        .t-stat-icon { width:48px; height:48px; border-radius:12px; display:flex; align-items:center; justify-content:center; margin-bottom:1rem; }
        .t-stat-icon svg { width:24px; height:24px; }
        .t-stat-value { font-size:1.75rem; font-weight:700; color:var(--t-text); }
        .t-stat-label { font-size:0.875rem; color:var(--t-muted); }
        .t-card { background:var(--t-card); border-radius:16px; border:1px solid var(--t-border); margin-bottom:1.5rem; overflow:hidden; }
        .t-card-header { background:var(--t-bg); padding:1rem 1.5rem; border-bottom:1px solid var(--t-border); font-weight:600; }
        .t-card-body { padding:1.5rem; }
        .t-table { width:100%; border-collapse:collapse; }
        .t-table th { background:var(--t-bg); padding:1rem; text-align:left; font-weight:600; border-bottom:2px solid var(--t-border); }
        .t-table td { padding:1rem; border-bottom:1px solid var(--t-border); }
        .t-table tr:hover { background:var(--t-bg); }
        .t-badge { padding:0.35rem 0.75rem; border-radius:50px; font-size:0.75rem; font-weight:600; }
        .t-badge-success { background:#D1FAE5; color:#059669; }
        .t-badge-warning { background:#FEF3C7; color:#D97706; }
        .t-badge-danger { background:#FEE2E2; color:#DC2626; }
        .t-badge-info { background:#E0E7FF; color:#4F46E5; }
        .t-badge-gray { background:#E2E8F0; color:#475569; }
        .t-btn { background:linear-gradient(135deg,var(--t-primary),#0284C7); color:white; border:none; padding:0.5rem 1rem; border-radius:8px; font-weight:500; cursor:pointer; }
        .t-btn:hover { color:white; box-shadow:0 4px 12px rgba(14,165,233,0.4); }
        .t-btn-outline { background:transparent; color:var(--t-primary); border:1px solid var(--t-primary); padding:0.5rem 1rem; border-radius:8px; }
        .t-btn-outline:hover { background:var(--t-primary); color:white; }
        .t-links { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:1.5rem; }
        .t-link { background:var(--t-card); border-radius:16px; padding:1.5rem; border:1px solid transparent; text-decoration:none; display:flex; align-items:center; gap:1rem; transition:all 0.3s; }
        .t-link:hover { transform:translateY(-4px); border-color:var(--t-primary); box-shadow:0 8px 24px rgba(0,0,0,0.1); }
        .t-link-icon { width:56px; height:56px; border-radius:14px; display:flex; align-items:center; justify-content:center; }
        .t-link-icon svg { width:26px; height:26px; }
        .t-link h4 { margin:0 0 0.25rem 0; font-weight:600; color:var(--t-text); }
        .t-link p { margin:0; color:var(--t-muted); font-size:0.85rem; }
        @media(max-width:991px) { .t-sidebar{transform:translateX(-100%);} .t-main{margin-left:0;} }
        </style>
    </template>

    <!-- TENANT SIDEBAR -->
    <template id="tenant_sidebar" name="Tenant Sidebar">
        <aside class="t-sidebar">
            <div class="t-sidebar-header">
                <div class="t-sidebar-logo">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 21v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21m0 0h4.5V3.545M12.75 21h7.5V10.75M2.25 21h1.5m18 0h-18M2.25 9l4.5-1.636M18.75 3l-1.5.545m0 6.205l3 1m1.5.5l-1.5-.5M6.75 7.364V3h-3v18m3-13.636l10.5-3.819" /></svg>
                </div>
                <div class="t-sidebar-text">
                    <h5>Tenant Portal</h5>
                    <small>Your Account Dashboard</small>
                </div>
            </div>
            <nav class="t-nav">
                <div class="t-nav-section">
                    <div class="t-nav-title">Main</div>
                    <a t-attf-href="/my" t-attf-class="#{page_name == 'home' and 'active' or ''}">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" /></svg>
                        Home
                    </a>
                    <a t-attf-href="/my/rental_contracts" t-attf-class="#{page_name == 'rental_contracts' and 'active' or ''}">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
                        My Contracts
                    </a>
                </div>
                <div class="t-nav-section">
                    <div class="t-nav-title">Maintenance</div>
                    <a t-attf-href="/my/maintenance_requests" t-attf-class="#{page_name == 'maintenance' and 'active' or ''}">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M11.42 15.17L17.25 21A2.652 2.652 0 0021 17.25l-5.877-5.877M11.42 15.17l2.496-3.03c.317-.384.74-.626 1.208-.766M11.42 15.17l-4.655 5.653a2.548 2.548 0 11-3.586-3.586l6.837-5.63m5.108-.233c.55-.164 1.163-.188 1.743-.14a4.5 4.5 0 004.486-6.336l-3.276 3.277a3.004 3.004 0 01-2.25-2.25l3.276-3.276a4.5 4.5 0 00-6.336 4.486c.091 1.076-.071 2.264-.904 2.95l-.102.085m-1.745 1.437L5.909 7.5H4.5L2.25 3.75l1.5-1.5L7.5 4.5v1.409l4.26 4.26m-1.745 1.437l1.745-1.437m6.615 8.206L15.75 15.75M4.867 19.125h.008v.008h-.008v-.008z" /></svg>
                        Requests
                    </a>
                </div>
                <div class="t-nav-section">
                    <div class="t-nav-title">Account</div>
                    <a href="/my/security">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z" /></svg>
                        Security
                    </a>
                </div>
            </nav>
        </aside>
    </template>

</odoo>
