<odoo>
    <data>
        <!-- views/mep_maintenance_form_views.xml -->
        <record id="view_mep_maintenance_form_tree" model="ir.ui.view">
            <field name="name">mep.maintenance.form.tree</field>
            <field name="model">mep.maintenance.form</field>
            <field name="arch" type="xml">
                <list>
                    <field name="date"/>
                    <field name="project_id"/>
                    <field name="location"/>
                </list>
            </field>
        </record>

        <record id="view_mep_maintenance_form_form" model="ir.ui.view">
            <field name="name">mep.maintenance.form.form</field>
            <field name="model">mep.maintenance.form</field>
            <field name="arch" type="xml">
                <form string="MEP Preventive Maintenance Form">
                    <sheet>
                        <group>
                            <field name="date"/>
                            <field name="project_id"/>
                            <field name="location"/>
                        </group>

                        <field name="work_line_ids">
                            <list editable="bottom">
                                <field name="work_description"/>
                                <field name="system_details"/>
                                <field name="status"/>
                                <field name="remarks"/>
                            </list>
                        </field>

                        <group>
                            <field name="additional_work"/>
                            <field name="referral_task"/>
                        </group>

                        <group string="Signatures">
                            <group>
                                <field name="contractor_name"/>
                                <field name="contractor_signature" widget="signature"/>
                                <field name="contractor_date"/>
                            </group>
                            <group>
                                <field name="tenant_name"/>
                                <field name="tenant_signature" widget="signature"/>
                                <field name="tenant_date"/>
                            </group>
                            <group>
                                <field name="tower_name"/>
                                <field name="tower_signature" widget="signature"/>
                                <field name="tower_date"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_mep_maintenance_form" model="ir.actions.act_window">
            <field name="name">MEP Maintenance Forms</field>
            <field name="res_model">mep.maintenance.form</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a new MEP maintenance form
                </p>
                <p>
                    Track and manage MEP preventive maintenance activities
                </p>
            </field>
        </record>


    </data>
</odoo>