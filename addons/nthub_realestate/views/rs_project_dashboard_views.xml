<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. Action to open the Dashboard -->
    <record id="action_rs_project_dashboard" model="ir.actions.act_window">
        <field name="name">Projects Dashboard</field>
        <field name="res_model">rs.project</field>
        <field name="view_mode">dashboard,graph,pivot,list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No projects found. Let's create one!
            </p><p>
                This dashboard gives you a high-level overview of your real estate portfolio.
            </p>
        </field>
    </record>

    <!-- 2. Graph and Pivot Views (Defined BEFORE the dashboard that uses them) -->
    <record id="view_rs_project_graph_dashboard" model="ir.ui.view">
        <field name="name">rs.project.graph.dashboard</field>
        <field name="model">rs.project</field>
        <field name="arch" type="xml">
            <graph string="Projects Analysis" sample="1">
                <field name="region" type="row"/>
                <field name="monthly_revenue" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_rs_project_pivot_dashboard" model="ir.ui.view">
        <field name="name">rs.project.pivot.dashboard</field>
        <field name="model">rs.project</field>
        <field name="arch" type="xml">
            <pivot string="Projects Analysis" sample="1">
                <field name="region" type="row"/>
                <field name="property_type" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- 3. The Dashboard View (Defined AFTER the views it refers to) -->
    <record id="view_rs_project_dashboard" model="ir.ui.view">
        <field name="name">rs.project.dashboard</field>
        <field name="model">rs.project</field>
        <field name="arch" type="xml">
            <dashboard>
                <group>
                    <group>
                        <widget name="total" string="Total Projects"/>
                        <widget name="total" string="Total Units" field="quantity"/>
                        <widget name="total" string="Sold Units" field="count_of_proprety"/>
                    </group>
                    <group>
                        <widget name="total" string="Total Sales Value" field="total_projects_sold" currency_field="company_currency_id"/>
                        <widget name="total" string="Monthly Rental Revenue" field="monthly_revenue" currency_field="company_currency_id"/>
                        <widget name="total" string="Avg. Occupancy" field="occupancy_rate" format="{value.toFixed(1)}%"/>
                    </group>
                </group>
                <group>
                    <group>
                        <view type="graph" title="Revenue by Region" ref="rs_project_dashboard.view_rs_project_graph_dashboard"/>
                    </group>
                    <group>
                        <view type="pivot" title="Units by Region - Type" ref="rs_project_dashboard.view_rs_project_pivot_dashboard"/>
                    </group>
                </group>
            </dashboard>
        </field>
    </record>

    <!-- 4. Action Override to set dashboard as default view -->
    <record id="action_rs_project_dashboard" model="ir.actions.act_window">
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'dashboard', 'view_id': ref('view_rs_project_dashboard')}),
            (0, 0, {'view_mode': 'list'}),
            (0, 0, {'view_mode': 'form'})]"/>
    </record>

    <!-- 5. Menu Items -->
    <menuitem
        id="menu_rs_project_root"
        name="Real Estate"
        web_icon="base,building"
        sequence="10"/>

    <menuitem
        id="menu_rs_project_dashboard"
        name="Dashboard"
        parent="menu_rs_project_root"
        action="action_rs_project_dashboard"
        sequence="1"/>

</odoo>