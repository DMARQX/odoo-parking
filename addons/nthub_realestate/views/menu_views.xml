<odoo>
  <data>

    <!-- ===== Actions (ضعها قبل أي menuitem يستدعيها) ===== -->
    <!-- Client Action for Dashboard -->
    <record id="action_real_estate_dashboard" model="ir.actions.client">
      <field name="name">Real Estate Dashboard</field>
      <field name="tag">real_estate_dashboard_action</field>
    </record>

    <!-- NOTE:
         باقي الأكشنز المذكورة أدناه (tenants_action, owner_action, ...إلخ)
         لازم تكون متعرفة في مكان آخر (act_window / client).
         لو مش متعرفة، Odoo هيطلعلك خطأ external id مش موجود وقت التحديث،
         لكنه مش هيبقى ParseError. -->

    <!-- ===== Root ===== -->
    <menuitem id="menu_real_estate_dashboard_root"
              name="Real Estate"
              web_icon="nthub_realestate,static/description/icon.png"
              action="action_real_estate_dashboard"
              sequence="10"/>

    <!-- 1) Dashboard -->
    <menuitem id="menu_real_estate_dashboard"
              name="Dashboard"
              parent="menu_real_estate_dashboard_root"
              action="action_real_estate_dashboard"
              sequence="1"/>

    <!-- 2) Partners -->
    <menuitem id="partners_menu"
              parent="menu_real_estate_dashboard_root"
              name="Partners"
              sequence="2"/>
    <menuitem id="tenants_menu_action"
              name="Tenants"
              parent="partners_menu"
              action="tenants_action"
              sequence="1"/>
    <menuitem id="owner_menu_action"
              name="Owners"
              parent="partners_menu"
              action="owner_action"
              sequence="2"/>

    <!-- 3) Property Structure -->
    <menuitem id="property_structure_menu"
              parent="menu_real_estate_dashboard_root"
              name="Property Structure"
              sequence="3"/>
    <menuitem id="regions_menu_action"
              parent="property_structure_menu"
              name="Regions"
              action="regions_actions"
              sequence="1"/>
    <menuitem id="rs_project_menu_action"
              parent="property_structure_menu"
              name="Projects"
              action="rs_project_action"
              sequence="2"/>
    <menuitem id="sub_property_menu_action"
              parent="property_structure_menu"
              name="Units"
              action="sub_properties_action"
              sequence="3"/>

    <!-- 4) Booking -->
    <menuitem id="reservation_menu_item"
              parent="menu_real_estate_dashboard_root"
              name="Booking"
              action="unit_reservation_form_action"
              sequence="4"/>

    <!-- 5) Settlement -->
    <menuitem id="settlement_menu_item"
              parent="menu_real_estate_dashboard_root"
              name="Settlement"
              sequence="5"/>
    <menuitem id="ownership_settlement_menu_item"
              parent="settlement_menu_item"
              name="Ownership Settlement"
              action="ownership_contract_line_action"
              sequence="1"/>
    <menuitem id="rental_settlement_menu_item"
              parent="settlement_menu_item"
              name="Rental Settlement"
              action="rental_contract_line_action"
              sequence="2"/>

    <!-- 6) Contracts -->
    <menuitem id="contracts_menu_item"
              parent="menu_real_estate_dashboard_root"
              name="Contracts"
              sequence="6"/>
    <menuitem id="ownership_contract_menu_item"
              parent="contracts_menu_item"
              name="Ownership Contracts"
              action="ownership_contract_action"
              sequence="1"/>
    <menuitem id="real_contract_action_menu_item"
              parent="contracts_menu_item"
              name="Rental Contracts"
              action="rental_contract_action"
              sequence="2"/>
    <menuitem id="contract_setup_menu_item"
              parent="contracts_menu_item"
              name="Contract Setup"
              action="action_contract_setup"
              sequence="3"/>

    <!-- 7) Request for Quotation -->
    <menuitem id="menu_offer_presentation"
              parent="menu_real_estate_dashboard_root"
              name="Request for Quotation"
              action="offer_presentation_action"
              sequence="7"/>

    <!-- 7) Maintenance -->
    <menuitem id="menu_maintenance_root"
              name="Maintenance"
              parent="menu_real_estate_dashboard_root"
              sequence="8"/>
    <menuitem id="rental_maintenance_request_menu"
              name="Maintenance Requests"
              parent="menu_maintenance_root"
              action="action_rental_maintenance_request"
              sequence="1"/>
    <menuitem id="menu_maintenance_job_orders"
              name="Job Orders"
              parent="menu_maintenance_root"
              action="action_maintenance_job_order"
              sequence="2"/>
    <!-- Legacy Job Orders menu removed - use "Job Orders" instead -->
    <menuitem id="menu_mep_maintenance_form_action"
              name="MEP Maintenance"
              parent="menu_maintenance_root"
              action="action_mep_maintenance_form"
              sequence="4"/>

    <!-- 8) Material Requests -->
    <menuitem id="menu_material_requisition_root"
              name="Material Requests"
              parent="menu_real_estate_dashboard_root"
              sequence="9"/>
    <menuitem id="menu_material_requisition_form"
              name="Requisition Forms"
              parent="menu_material_requisition_root"
              action="action_material_requisition_form"
              sequence="1"/>
    <menuitem id="menu_owner_requests"
              name="Owner Requests"
              parent="menu_material_requisition_root"
              action="action_owner_request"
              sequence="2"/>

    <!-- 100) Configuration -->
    <menuitem id="configration_menu"
              parent="menu_real_estate_dashboard_root"
              name="Configuration"
              sequence="100"/>
    <menuitem id="setting_menu_action"
              parent="configration_menu"
              name="Settings"
              action="action_general_config"
              sequence="1"/>
    <menuitem id="installment_template_action_menu"
              parent="configration_menu"
              name="Installment Template"
              action="installment_template_form_action"
              sequence="2"/>
    <menuitem id="main_property_type_menu_action"
              parent="configration_menu"
              name="Project Type"
              action="main_property_type_action"
              sequence="3"/>
    <menuitem id="property_status_menu_action"
              parent="configration_menu"
              name="Property Status"
              action="property_status_action"
              sequence="4"/>
    <menuitem id="property_description_menu_action"
              parent="configration_menu"
              name="Property Description"
              action="property_description_action"
              sequence="5"/>
    <menuitem id="furniture_menu_action"
              parent="configration_menu"
              name="Furniture"
              action="furniture_action"
              sequence="6"/>

  </data>
</odoo>
