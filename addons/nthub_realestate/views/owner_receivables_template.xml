                        </div>
                    </div>
                    
                    <t t-if="overdue_count">
                        <div class="rv-alert rv-fade-in">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
                            <div class="rv-alert-content">
                                <h5><t t-esc="overdue_count"/> Overdue Invoices</h5>
                                <p>Total overdue: <t t-esc="'{:,.2f}'.format(overdue_amount)"/> &#65020;</p>
                            </div>
                        </div>
                    </t>
                    
                    <div class="rv-stats-grid">
                        <div class="rv-stat-card danger rv-fade-in">
                            <div class="rv-stat-icon danger">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" /></svg>
                            </div>
                            <div class="rv-stat-value"><t t-esc="'{:,.0f}'.format(total_receivables or 0)"/><small>&#65020;</small></div>
                            <div class="rv-stat-label">Total Receivables</div>
                        </div>
                        
                        <div class="rv-stat-card warning rv-fade-in">
                            <div class="rv-stat-icon warning">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                            </div>
                            <div class="rv-stat-value"><t t-esc="'{:,.0f}'.format(overdue_amount or 0)"/><small>&#65020;</small></div>
                            <div class="rv-stat-label">Overdue Amount</div>
                        </div>
                        
                        <div class="rv-stat-card info rv-fade-in">
                            <div class="rv-stat-icon info">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" /></svg>
                            </div>
                            <div class="rv-stat-value"><t t-esc="invoice_count or 0"/></div>
                            <div class="rv-stat-label">Open Invoices</div>
                        </div>
                        
                        <div class="rv-stat-card purple rv-fade-in">
                            <div class="rv-stat-icon purple">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" /></svg>
                            </div>
                            <div class="rv-stat-value"><t t-esc="avg_days_overdue or 0"/></div>
                            <div class="rv-stat-label">Avg Days Overdue</div>
                        </div>
                    </div>
                    
                    <div class="rv-charts-row">
                        <div class="rv-chart-card rv-fade-in">
                            <div class="rv-chart-header">
                                <h5>
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z" /><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z" /></svg>
                                    Aging Analysis
                                </h5>
                            </div>
                            <div class="rv-chart-body">
                                <div id="aging-chart" style="height: 280px;"></div>
                            </div>
                        </div>
                        <div class="rv-chart-card rv-fade-in">
                            <div class="rv-chart-header">
                                <h5>
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" /></svg>
                                    By Project
                                </h5>
                            </div>
                            <div class="rv-chart-body">
                                <div id="project-chart" style="height: 280px;"></div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="rv-table-card rv-fade-in">
                        <div class="rv-table-header">
                            <h5>
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" /></svg>
                                Outstanding Invoices / الفواتير المستحقة
                            </h5>
                            <div class="rv-filters">
                                <div class="rv-filter-select">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 01-.659 1.591l-5.432 5.432a2.25 2.25 0 00-.659 1.591v2.927a2.25 2.25 0 01-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 00-.659-1.591L3.659 7.409A2.25 2.25 0 013 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0112 3z" /></svg>
                                    <select id="status-filter">
                                        <option value="all">All Status</option>
                                        <option value="overdue">Overdue</option>
                                        <option value="partial">Partial</option>
                                        <option value="due">Due</option>
                                    </select>
                                </div>
                                <div class="rv-search-box">
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" /></svg>
                                    <input type="text" id="invoice-search" placeholder="Search invoices... / بحث..."/>
                                </div>
                            </div>
                        </div>
                        <div style="overflow-x: auto;">
                            <table class="rv-table" id="invoices-table">
                                <thead>
                                    <tr>
                                        <th>Invoice</th>
                                        <th>Project</th>
                                        <th>Unit</th>
                                        <th>Tenant</th>
                                        <th>Due Date</th>
                                        <th class="text-end">Balance</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-if="not receivable_invoices">
                                        <tr>
                                            <td colspan="7">
                                                <div class="rv-empty">
                                                    <div class="empty-icon">
                                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                                    </div>
                                                    <h4>All Clear!</h4>
                                                    <p>No outstanding receivables at this time.</p>
                                                </div>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-foreach="receivable_invoices or []" t-as="inv">
                                        <t t-set="row_status" t-value="'overdue' if (inv.get('due_date') and inv['due_date'] &lt; datetime.date.today()) else ('partial' if inv.get('payment_state') == 'partial' else 'due')"/>
                                        <tr t-att-data-status="row_status">
                                            <td style="font-weight: 600;">
                                                <t t-if="inv.get('invoice')">
                                                    <t t-esc="inv['invoice'].name"/>
                                                </t>
                                                <t t-else="">
                                                    <t t-esc="inv.get('contract').name if inv.get('contract') else '-'"/>
                                                </t>
                                            </td>
                                            <td><t t-esc="inv['project'].name if inv.get('project') else '-'"/></td>
                                            <td><t t-esc="inv['unit'].name if inv.get('unit') else '-'"/></td>
                                            <td><t t-esc="inv['tenant'].name if inv.get('tenant') else '-'"/></td>
                                            <td><t t-esc="inv['due_date'].strftime('%d %b %Y') if inv.get('due_date') else '-'"/></td>
                                            <td class="text-end" style="font-weight: 700; color: var(--rv-danger);">
                                                <t t-esc="'{:,.2f}'.format(inv.get('amount_residual', 0))"/> &#65020;
                                            </td>
                                            <td>
                                                <t t-if="inv.get('due_date') and inv['due_date'] &lt; datetime.date.today()">
                                                    <span class="rv-badge overdue">
                                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" /></svg>
                                                        Overdue
                                                    </span>
                                                </t>
                                                <t t-elif="inv.get('payment_state') == 'partial'">
                                                    <span class="rv-badge partial">
                                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 12c0-1.232-.046-2.453-.138-3.662a4.006 4.006 0 00-3.7-3.7 48.678 48.678 0 00-7.324 0 4.006 4.006 0 00-3.7 3.7c-.017.22-.032.441-.046.662M19.5 12l3-3m-3 3l-3-3m-12 3c0 1.232.046 2.453.138 3.662a4.006 4.006 0 003.7 3.7 48.656 48.656 0 007.324 0 4.006 4.006 0 003.7-3.7c.017-.22.032-.441.046-.662M4.5 12l3 3m-3-3l-3 3" /></svg>
                                                        Partial
                                                    </span>
                                                </t>
                                                <t t-else="">
                                                    <span class="rv-badge due">
                                                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                                                        Due
                                                    </span>
                                                </t>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>
                        <div class="rv-table-footer">
                            <div class="rv-table-info">
                                Showing <strong id="visible-count"><t t-esc="len(receivable_invoices) if receivable_invoices else 0"/></strong> of <strong><t t-esc="len(receivable_invoices) if receivable_invoices else 0"/></strong> invoices
                            </div>
                        </div>
                    </div>
                </main>
            </div>
            
            <script type="text/javascript">
                document.addEventListener('DOMContentLoaded', function() {
                    var sidebar = document.querySelector('.rv-sidebar');
                    var mobileToggle = document.querySelector('.rv-mobile-toggle');
                    var overlay = document.querySelector('.rv-overlay');

                    if (mobileToggle) {
                        mobileToggle.addEventListener('click', function() {
                            sidebar.classList.add('open');
                            overlay.classList.add('active');
                        });
                    }
                    if (overlay) {
                        overlay.addEventListener('click', function() {
                            sidebar.classList.remove('open');
                            overlay.classList.remove('active');
                        });
                    }

                    var searchInput = document.getElementById('invoice-search');
                    var statusFilter = document.getElementById('status-filter');
                    var visibleCountEl = document.getElementById('visible-count');
                    
                    function filterTable() {
                        var searchText = searchInput ? searchInput.value.toLowerCase() : '';
                        var statusValue = statusFilter ? statusFilter.value : 'all';
                        var rows = document.querySelectorAll('#invoices-table tbody tr[data-status]');
                        var visibleCount = 0;
                        
                        rows.forEach(function(row) {
                            var text = row.textContent.toLowerCase();
                            var rowStatus = row.getAttribute('data-status');
                            var matchesSearch = searchText === '' || text.includes(searchText);
                            var matchesStatus = statusValue === 'all' || rowStatus === statusValue;
                            
                            if (matchesSearch &amp;&amp; matchesStatus) {
                                row.style.display = '';
                                visibleCount++;
                            } else {
                                row.style.display = 'none';
                            }
                        });
                        
                        if (visibleCountEl) {
                            visibleCountEl.textContent = visibleCount;
                        }
                    }
                    
                    if (searchInput) {
                        searchInput.addEventListener('keyup', filterTable);
                    }
                    
                    if (statusFilter) {
                        statusFilter.addEventListener('change', filterTable);
                    }

                    if (typeof ApexCharts === 'undefined') return;

                    var chartData = <t t-out="json.dumps(chart_data) if chart_data else '{}'" />;

                    var agingEl = document.getElementById('aging-chart');
                    if (agingEl &amp;&amp; chartData.aging) {
                        new ApexCharts(agingEl, {
                            series: chartData.aging.values || [],
                            chart: { type: 'donut', height: 280, fontFamily: 'Cairo, Inter, sans-serif' },
                            labels: chartData.aging.labels || [],
                            colors: ['#10b981', '#3b82f6', '#f59e0b', '#ef4444'],
                            legend: { position: 'bottom', fontSize: '12px' },
                            plotOptions: { pie: { donut: { size: '60%', labels: { show: true, total: { show: true, label: 'Total', formatter: function(w) { return w.globals.seriesTotals.reduce((a,b)=>a+b,0).toLocaleString() + ' \uFDFC'; } } } } } }
                        }).render();
                    }

                    var projectEl = document.getElementById('project-chart');
                    if (projectEl &amp;&amp; chartData.by_project) {
                        new ApexCharts(projectEl, {
                            series: [{ name: 'Amount', data: chartData.by_project.amounts || [] }],
                            chart: { type: 'bar', height: 280, toolbar: { show: false }, fontFamily: 'Cairo, Inter, sans-serif' },
                            colors: ['#ef4444'],
                            plotOptions: { bar: { borderRadius: 8, horizontal: true } },
                            dataLabels: { enabled: false },
                            xaxis: { categories: chartData.by_project.projects || [], labels: { formatter: function(val) { return val.toLocaleString(); } } },
                            yaxis: { labels: { style: { colors: '#64748b' } } },
                            tooltip: { y: { formatter: function(val) { return val.toLocaleString() + ' \uFDFC'; } } }
                        }).render();
                    }
                });
            </script>
        </t>
    </template>

</odoo>
