<odoo>
    <!-- list View -->
    <record id="view_low_current_maintenance_list" model="ir.ui.view">
        <field name="name">low.current.maintenance.form.list</field>
        <field name="model">low.current.maintenance.form</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date"/>
                <field name="project_id"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_low_current_maintenance_form" model="ir.ui.view">
        <field name="name">low.current.maintenance.form</field>
        <field name="model">low.current.maintenance.form</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="date"/>
                        <field name="project_id"/>
                        <field name="location"/>
                    </group>

                    <field name="work_line_ids">
                        <list editable="bottom">
                            <field name="work_description"/>
                            <field name="system_details"/>
                            <field name="status"/>
                            <field name="remarks"/>
                        </list>
                    </field>

                    <group string="Additional Info">
                        <field name="additional_work"/>
                        <field name="referral_task"/>
                    </group>

                    <group string="Signatures">
                        <group>
                            <field name="contractor_name"/>
                            <field name="contractor_signature" widget="signature"/>
                            <field name="contractor_date"/>
                        </group>
                        <group>
                            <field name="tenant_name"/>
                            <field name="tenant_signature" widget="signature"/>
                            <field name="tenant_date"/>
                        </group>
                        <group>
                            <field name="tower_name"/>
                            <field name="tower_signature" widget="signature"/>
                            <field name="tower_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_low_current_maintenance_form" model="ir.actions.act_window">
        <field name="name">Low Current Preventive Maintenance</field>
        <field name="res_model">low.current.maintenance.form</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menus -->



</odoo>
