<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Warehouse Location Mapping Views -->
    <record id="warehouse_location_mapping_list" model="ir.ui.view">
        <field name="name">Warehouse Location Mapping List</field>
        <field name="model">warehouse.location.mapping</field>
        <field name="arch" type="xml">
            <list>
                <field name="project_id"/>
                <field name="warehouse_location_id"/>
                <field name="job_site_location_id"/>
                <field name="is_default"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="warehouse_location_mapping_form" model="ir.ui.view">
        <field name="name">Warehouse Location Mapping Form</field>
        <field name="model">warehouse.location.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="warehouse_location_id"/>
                            <field name="job_site_location_id"/>
                        </group>
                        <group>
                            <field name="is_default"/>
                            <field name="is_active"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="warehouse_location_mapping_search" model="ir.ui.view">
        <field name="name">Warehouse Location Mapping Search</field>
        <field name="model">warehouse.location.mapping</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="warehouse_location_id"/>
                <filter name="active_only" string="Active" domain="[('is_active', '=', True)]"/>
                <filter name="default_only" string="Default Mappings" domain="[('is_default', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_project" string="Project" context="{'group_by': 'project_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="warehouse_location_mapping_action" model="ir.actions.act_window">
        <field name="name">Warehouse Location Mappings</field>
        <field name="res_model">warehouse.location.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <!-- Job Site Location Views -->
    <record id="job_site_location_list" model="ir.ui.view">
        <field name="name">Job Site Location List</field>
        <field name="model">job.site.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="location_type"/>
                <field name="is_active"/>
            </list>
        </field>
    </record>

    <record id="job_site_location_form" model="ir.ui.view">
        <field name="name">Job Site Location Form</field>
        <field name="model">job.site.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name" placeholder="Location Name"/>
                    </h1>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="stock_location_id"/>
                            <field name="location_type"/>
                        </group>
                        <group>
                            <field name="is_active"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Location Details">
                            <group>
                                <group>
                                    <field name="contact_person_id"/>
                                    <field name="contact_phone"/>
                                </group>
                                <group>
                                    <field name="capacity"/>
                                </group>
                            </group>
                            <field name="description" placeholder="Detailed description..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="job_site_location_search" model="ir.ui.view">
        <field name="name">Job Site Location Search</field>
        <field name="model">job.site.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="location_type"/>
                <filter name="active_only" string="Active" domain="[('is_active', '=', True)]"/>
                <filter name="primary_only" string="Primary Locations" domain="[('is_primary', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_type" string="Type" context="{'group_by': 'location_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="job_site_location_action" model="ir.actions.act_window">
        <field name="name">Job Site Locations</field>
        <field name="res_model">job.site.location</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record id="stock_picking_workflow_list" model="ir.ui.view">
        <field name="name">Stock Picking Workflow List</field>
        <field name="model">stock.picking.workflow</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="maintenance_request_id"/>
                <field name="project_id"/>
                <field name="status"/>
                <field name="total_items"/>
                <field name="total_quantity"/>
            </list>
        </field>
    </record>

    <record id="stock_picking_workflow_form" model="ir.ui.view">
        <field name="name">Stock Picking Workflow Form</field>
        <field name="model">stock.picking.workflow</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Submit" type="object" class="oe_highlight"/>
                    <button name="action_create_picking" string="Create Stock Picking" type="object" class="oe_highlight"/>
                    <button name="action_confirm_receipt" string="Confirm Receipt" type="object" class="oe_highlight"/>
                    <field name="status" widget="statusbar" clickable="0"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="maintenance_request_id"/>
                            <field name="project_id"/>
                        </group>
                        <group>
                            <field name="creation_date" readonly="1"/>
                            <field name="submission_date" readonly="1"/>
                            <field name="delivery_date" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="warehouse_location_mapping_id"/>
                            <field name="source_location_id"/>
                            <field name="destination_location_id"/>
                            <field name="job_site_location_id"/>
                        </group>
                        <group>
                            <field name="contractor_id" readonly="1"/>
                            <field name="requested_delivery_date"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Materials">
                            <field name="picking_line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id" readonly="1"/>
                                    <field name="available_quantity"/>
                                    <field name="shortage_quantity"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <div class="oe_subtotal_footer_separator">
                                    <strong>Total Items:</strong>
                                </div>
                                <field name="total_items" class="oe_subtotal_footer_separator" readonly="1"/>
                                <div class="oe_subtotal_footer_separator">
                                    <strong>Total Quantity:</strong>
                                </div>
                                <field name="total_quantity" class="oe_subtotal_footer_separator" readonly="1"/>
                            </group>
                        </page>
                        <page string="Delivery Status">
                            <group>
                                <group>
                                    <field name="delivered_quantity" readonly="1"/>
                                    <field name="received_quantity" readonly="1"/>
                                    <field name="delivery_progress" readonly="1"/>
                                </group>
                                <group>
                                    <field name="received_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                        <page string="Additional Info">
                            <group>
                                <field name="contractor_signature"/>
                            </group>
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter>

                </chatter>
            </form>
        </field>
    </record>

    <record id="stock_picking_workflow_search" model="ir.ui.view">
        <field name="name">Stock Picking Workflow Search</field>
        <field name="model">stock.picking.workflow</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="maintenance_request_id"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <filter name="draft" string="Draft" domain="[('status', '=', 'draft')]"/>
                <filter name="submitted" string="Submitted" domain="[('status', '=', 'submitted')]"/>
                <filter name="picking_created" string="Picking Created" domain="[('status', '=', 'picking_created')]"/>
                <filter name="delivered" string="Delivered" domain="[('status', 'in', ['partially_delivered', 'delivered'])]"/>
                <filter name="received" string="Received" domain="[('status', '=', 'received')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_contractor" string="Contractor" context="{'group_by': 'contractor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="stock_picking_workflow_action" model="ir.actions.act_window">
        <field name="name">Stock Picking Workflows</field>
        <field name="res_model">stock.picking.workflow</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

    <record id="job_site_location_search" model="ir.ui.view">
        <field name="name">Job Site Location Search</field>
        <field name="model">job.site.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <field name="location_type"/>
                <filter name="active_only" string="Active" domain="[('is_active', '=', True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_project" string="Project" context="{'group_by': 'project_id'}"/>
                    <filter name="group_by_type" string="Type" context="{'group_by': 'location_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="job_site_location_action" model="ir.actions.act_window">
        <field name="name">Job Site Locations</field>
        <field name="res_model">job.site.location</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
    </record>

</odoo>
