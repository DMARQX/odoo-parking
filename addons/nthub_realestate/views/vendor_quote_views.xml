<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ============================================================
         VENDOR QUOTE FORM VIEW - NEW WORKFLOW
         ============================================================ -->
    <record id="view_vendor_quote_form" model="ir.ui.view">
        <field name="name">maintenance.vendor.quote.form</field>
        <field name="model">maintenance.vendor.quote</field>
        <field name="arch" type="xml">
            <form string="Quote Request">
                <header>
                    <!-- Step 1: Send to Owner (after attaching vendor PDFs) -->
                    <button name="action_send_to_owner" type="object" 
                            string="Send to Owner"
                            class="btn-primary" 
                            invisible="state != 'draft'"
                            confirm="Are you sure you want to send this quote request to the owner for approval?"/>
                    
                    <!-- Step 2: Owner Approve/Reject (Backend) -->
                    <button name="action_owner_approve" type="object" 
                            string="Owner Approve"
                            class="btn-success" 
                            invisible="state != 'pending_owner_approval'"/>
                    <button name="action_owner_reject" type="object" 
                            string="Owner Reject"
                            class="btn-danger" 
                            invisible="state != 'pending_owner_approval'"/>
                    
                    <!-- Step 3: Select Vendor (after owner approval) -->
                    <button name="action_select_vendor" type="object" 
                            string="Select Vendor"
                            class="btn-primary" 
                            invisible="state != 'owner_approved'"/>
                    
                    <!-- View PO (after vendor selected) -->
                    <button name="action_view_purchase_order" type="object" 
                            string="View Purchase Order"
                            class="btn-info" 
                            invisible="state != 'po_created' or not purchase_order_id"/>
                    
                    <!-- Cancel -->
                    <button name="action_owner_reject" type="object" 
                            string="Cancel"
                            class="btn-secondary" 
                            invisible="state in ['po_created', 'cancelled', 'rejected']"/>
                    
                    <field name="state" widget="statusbar" 
                           statusbar_visible="draft,pending_owner_approval,owner_approved,vendor_selected,po_created"/>
                </header>
                
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(nthub_realestate.action_maintenance_job_order)d" 
                                type="action" class="oe_stat_button" icon="fa-wrench"
                                context="{'default_id': job_order_id}"
                                invisible="not job_order_id">
                            <field name="job_order_id" widget="statinfo" string="Job Order"/>
                        </button>
                        <button name="action_view_purchase_order" type="object" 
                                class="oe_stat_button" icon="fa-file-text-o"
                                invisible="not purchase_order_id">
                            <field name="purchase_order_id" widget="statinfo" string="Purchase Order"/>
                        </button>
                    </div>
                    
                    <!-- Alert Banners -->
                    <div class="alert alert-info" role="alert" invisible="state != 'draft'">
                        <strong>Step 1:</strong> Add materials list, then attach vendor quote PDFs, then send to owner for approval.
                    </div>
                    <div class="alert alert-warning" role="alert" invisible="state != 'pending_owner_approval'">
                        <strong>Pending Owner Approval:</strong> Waiting for owner to review and approve the quotes.
                    </div>
                    <div class="alert alert-success" role="alert" invisible="state != 'owner_approved'">
                        <strong>Owner Approved!</strong> Please select the winning vendor to create the purchase order.
                    </div>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Request Information">
                            <field name="job_order_id" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="project_id" readonly="1"/>
                            <field name="owner_partner_id" readonly="1" string="Property Owner"/>
                            <field name="quote_date" required="1"/>
                            <field name="validity_date"/>
                        </group>
                        <group string="Selected Vendor" invisible="state not in ['vendor_selected', 'po_created']">
                            <field name="selected_vendor_id" readonly="1"/>
                            <field name="final_amount" widget="monetary" readonly="1"/>
                            <field name="company_currency_id" invisible="1"/>
                        </group>
                        <group string="Estimated Values" invisible="state in ['vendor_selected', 'po_created']">
                            <field name="total_amount" widget="monetary" readonly="1"
                                   options="{'currency_field': 'company_currency_id'}"/>
                            <field name="company_currency_id" invisible="1"/>
                            <field name="delivery_days"/>
                            <field name="payment_terms"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <!-- Tab 1: Materials List -->
                        <page string="Materials List" name="quote_lines">
                            <field name="quote_line_ids" readonly="state not in ['draft']">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id" required="1"/>
                                    <field name="description"/>
                                    <field name="quantity" required="1"/>
                                    <field name="uom_id"/>
                                    <field name="unit_price" string="Est. Price"/>
                                    <field name="subtotal" sum="Total"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        
                        <!-- Tab 2: Vendor Quote PDFs (NEW) -->
                        <page string="Vendor Quotes (PDFs)" name="vendor_attachments">
                            <div class="alert alert-info mb-3" role="alert" invisible="state != 'draft'">
                                <i class="fa fa-info-circle"/> 
                                Attach quote PDFs from multiple vendors for comparison. The owner will review all quotes.
                            </div>
                            <field name="vendor_attachment_ids" readonly="state not in ['draft']">
                                <list editable="bottom">
                                    <field name="vendor_id" required="1" string="Vendor"/>
                                    <field name="quote_file" filename="quote_filename" string="Quote PDF"/>
                                    <field name="quote_filename" column_invisible="1"/>
                                    <field name="quote_amount" string="Amount"/>
                                    <field name="delivery_days" string="Delivery"/>
                                    <field name="payment_terms" string="Payment"/>
                                    <field name="warranty_period" string="Warranty"/>
                                    <field name="is_owner_approved" readonly="1" widget="boolean_toggle" string="Owner OK"/>
                                    <field name="is_selected" readonly="1" widget="boolean_toggle" string="Selected"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        
                        <!-- Tab 3: Other Attachments -->
                        <page string="Other Documents" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary" class="oe_inline"/>
                        </page>
                        
                        <!-- Tab 4: Notes -->
                        <page string="Notes" name="notes">
                            <group>
                                <field name="notes" placeholder="Internal notes" nolabel="1"/>
                            </group>
                            <group invisible="state not in ['owner_approved', 'vendor_selected', 'po_created', 'rejected']">
                                <field name="owner_notes" placeholder="Notes from owner" readonly="1"/>
                            </group>
                            <group invisible="state != 'rejected'">
                                <field name="rejection_reason" readonly="1"/>
                            </group>
                        </page>
                        
                        <!-- Tab 5: Approval Details -->
                        <page string="Approval Details" name="approval_details"
                              invisible="state in ['draft']">
                            <group>
                                <group>
                                    <field name="sent_to_owner_date" readonly="1"/>
                                    <field name="approved_by_owner_id" readonly="1"/>
                                    <field name="approval_date" readonly="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Vendor Quote Tree View - Updated -->
    <record id="view_vendor_quote_tree" model="ir.ui.view">
        <field name="name">maintenance.vendor.quote.tree</field>
        <field name="model">maintenance.vendor.quote</field>
        <field name="arch" type="xml">
            <list string="Quote Requests" 
                  decoration-success="state in ['owner_approved', 'vendor_selected', 'po_created']"
                  decoration-danger="state == 'rejected'"
                  decoration-warning="state == 'pending_owner_approval'"
                  decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="job_order_id"/>
                <field name="project_id"/>
                <field name="quote_date"/>
                <field name="validity_date"/>
                <field name="total_amount" sum="Total Amount"/>
                <field name="vendor_attachment_count" string="# Vendor Quotes"/>
                <field name="selected_vendor_id" optional="show"/>
                <field name="final_amount" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state in ['owner_approved', 'vendor_selected', 'po_created']"
                       decoration-danger="state == 'rejected'"
                       decoration-warning="state == 'pending_owner_approval'"
                       decoration-info="state == 'draft'"/>
            </list>
        </field>
    </record>

    <!-- Vendor Quote Kanban View - Updated -->
    <record id="view_vendor_quote_kanban" model="ir.ui.view">
        <field name="name">maintenance.vendor.quote.kanban</field>
        <field name="model">maintenance.vendor.quote</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="state">
                <field name="name"/>
                <field name="selected_vendor_id"/>
                <field name="total_amount"/>
                <field name="final_amount"/>
                <field name="state"/>
                <field name="project_id"/>
                <field name="quote_date"/>
                <field name="vendor_attachment_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <span class="badge text-bg-secondary">
                                    <t t-if="record.final_amount.raw_value">
                                        <field name="final_amount" widget="monetary"/>
                                    </t>
                                    <t t-else="">
                                        <field name="total_amount" widget="monetary"/>
                                    </t>
                                </span>
                            </div>
                            <div class="o_kanban_record_body">
                                <t t-if="record.selected_vendor_id.raw_value">
                                    <i class="fa fa-check-circle text-success"/> <field name="selected_vendor_id"/>
                                </t>
                                <t t-else="">
                                    <i class="fa fa-file-pdf-o"/> <field name="vendor_attachment_count"/> vendor quotes
                                </t>
                                <br/>
                                <i class="fa fa-building-o"/> <field name="project_id"/>
                                <br/>
                                <i class="fa fa-calendar"/> <field name="quote_date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vendor Quote Search View - Updated -->
    <record id="view_vendor_quote_search" model="ir.ui.view">
        <field name="name">maintenance.vendor.quote.search</field>
        <field name="model">maintenance.vendor.quote</field>
        <field name="arch" type="xml">
            <search string="Search Quote Requests">
                <field name="name" string="Quote Number"/>
                <field name="selected_vendor_id"/>
                <field name="job_order_id"/>
                <field name="project_id"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Pending Owner" name="pending_owner" 
                        domain="[('state', '=', 'pending_owner_approval')]"/>
                <filter string="Owner Approved" name="approved" 
                        domain="[('state', '=', 'owner_approved')]"/>
                <filter string="Vendor Selected" name="vendor_selected" 
                        domain="[('state', '=', 'vendor_selected')]"/>
                <filter string="PO Created" name="po_created" 
                        domain="[('state', '=', 'po_created')]"/>
                <filter string="Rejected" name="rejected" domain="[('state', '=', 'rejected')]"/>
                <separator/>
                <filter string="Valid Quotes" name="valid" 
                        domain="[('validity_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Expired Quotes" name="expired" 
                        domain="[('validity_date', '&lt;', context_today().strftime('%Y-%m-%d'))]"/>
                <group expand="0" string="Group By">
                    <filter string="Selected Vendor" name="group_vendor" context="{'group_by': 'selected_vendor_id'}"/>
                    <filter string="Project" name="group_project" context="{'group_by': 'project_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Job Order" name="group_job_order" context="{'group_by': 'job_order_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vendor Quote Action - Updated -->
    <record id="action_vendor_quote" model="ir.actions.act_window">
        <field name="name">Quote Requests</field>
        <field name="res_model">maintenance.vendor.quote</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_pending_owner': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Quote Request
            </p>
            <p>
                Quote requests allow you to collect and compare vendor quotes before creating a purchase order.
            </p>
        </field>
    </record>

    <!-- ============================================================
         VENDOR QUOTE ATTACHMENT VIEWS
         ============================================================ -->
    <record id="view_vendor_quote_attachment_tree" model="ir.ui.view">
        <field name="name">maintenance.vendor.quote.attachment.tree</field>
        <field name="model">maintenance.vendor.quote.attachment</field>
        <field name="arch" type="xml">
            <list string="Vendor Quote Attachments" editable="bottom">
                <field name="vendor_id" required="1"/>
                <field name="attachment_id" required="1"/>
                <field name="quote_amount"/>
                <field name="delivery_days"/>
                <field name="payment_terms"/>
                <field name="warranty_period"/>
                <field name="is_selected"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- ============================================================
         VENDOR SELECTION WIZARD VIEWS
         ============================================================ -->
    <record id="view_vendor_quote_select_vendor_wizard_form" model="ir.ui.view">
        <field name="name">vendor.quote.select.vendor.wizard.form</field>
        <field name="model">vendor.quote.select.vendor.wizard</field>
        <field name="arch" type="xml">
            <form string="Select Vendor - Owner Approved Quotes Only">
                <group>
                    <group>
                        <field name="quote_id" readonly="1"/>
                        <field name="vendor_count" invisible="1"/>
                    </group>
                    <group>
                        <field name="selection_mode" widget="radio" 
                               options="{'horizontal': true}"
                               invisible="vendor_count &lt;= 1"/>
                    </group>
                </group>
                
                <div class="alert alert-success mb-3">
                    <i class="fa fa-check-circle"/> 
                    <strong>Owner Approved Vendors:</strong> 
                    Only vendors approved by the property owner are shown below.
                </div>
                
                <separator string="OWNER APPROVED VENDOR QUOTES / عروض الموردين الموافق عليها"/>
                <field name="vendor_attachment_ids" readonly="1">
                    <list decoration-success="is_owner_approved">
                        <field name="vendor_id" string="Vendor / المورد"/>
                        <field name="quote_amount" string="Amount / المبلغ"/>
                        <field name="delivery_days" string="Delivery / التسليم"/>
                        <field name="payment_terms" string="Payment / الدفع"/>
                        <field name="warranty_period" string="Warranty / الضمان"/>
                        <field name="is_owner_approved" widget="boolean_toggle" string="Owner OK"/>
                    </list>
                </field>
                
                <!-- Single Vendor Selection -->
                <group invisible="selection_mode != 'single'">
                    <group>
                        <label for="selected_attachment_id" string="Select Final Vendor / اختر المورد النهائي"/>
                        <field name="selected_attachment_id" nolabel="1"
                               options="{'no_create': True}"
                               domain="[('id', 'in', vendor_attachment_ids)]"
                               required="selection_mode == 'single'"/>
                    </group>
                    <group>
                        <field name="final_amount" readonly="1" string="Final Amount / المبلغ النهائي"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                
                <!-- Multiple Vendors Selection with Product Assignment -->
                <group invisible="selection_mode != 'multiple'">
                    <separator string="ASSIGN PRODUCTS TO VENDORS / تخصيص المنتجات للموردين"/>
                    <field name="product_assignment_ids">
                        <list editable="bottom">
                            <field name="quote_line_id" column_invisible="1" force_save="1"/>
                            <field name="product_id" string="Product / المنتج" readonly="1" force_save="1"/>
                            <field name="quantity" string="Qty / الكمية"/>
                            <field name="unit_price" string="Price / السعر"/>
                            <field name="subtotal" string="Subtotal / المجموع" sum="Total"/>
                            <field name="available_vendor_ids" column_invisible="1"/>
                            <field name="vendor_attachment_id" 
                                   string="Assign to Vendor / خصص للمورد"
                                   options="{'no_create': True}"
                                   required="1"/>
                            <field name="currency_id" column_invisible="1"/>
                        </list>
                    </field>
                    
                    <group>
                        <field name="final_amount" readonly="1" string="Total Amount / المبلغ الإجمالي"/>
                    </group>
                </group>
                
                <footer>
                    <button name="action_confirm" type="object" string="Confirm Selection / تأكيد الاختيار" 
                            class="btn-primary"/>
                    <button string="Cancel / إلغاء" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Add to Phase 4-6 Menu -->
    <menuitem id="menu_vendor_quotes"
              name="Quote Requests"
              parent="menu_maintenance_stock_purchase"
              action="action_vendor_quote"
              sequence="40"/>

</odoo>
