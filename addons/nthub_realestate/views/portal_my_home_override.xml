<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Override Portal My Home Page for Owners -->
    <template id="portal_my_home_owner" name="Owner Portal Home Override" inherit_id="portal.portal_my_home" priority="99">
        <!-- Replace the entire content for owners -->
        <xpath expr="//div[hasclass('o_portal_my_home')]" position="replace">
            <t t-if="request.env.user.partner_id.is_owner">
                <!-- Custom Owner Portal Home -->
                <t t-set="no_breadcrumbs" t-value="True"/>
                
                <link rel="preconnect" href="https://fonts.googleapis.com"/>
                <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
                <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700&amp;family=Inter:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
                
                <style type="text/css">
                /* CSS Variables - Soft Color Palette */
                :root {
                    --owner-primary: #5C6BC0;
                    --owner-primary-light: #7986CB;
                    --owner-primary-dark: #3F51B5;
                    --owner-secondary: #78909C;
                    --owner-success: #66BB6A;
                    --owner-success-light: #E8F5E9;
                    --owner-warning: #FFA726;
                    --owner-warning-light: #FFF3E0;
                    --owner-danger: #EF5350;
                    --owner-danger-light: #FFEBEE;
                    --owner-info: #42A5F5;
                    --owner-info-light: #E3F2FD;
                    --owner-purple: #AB47BC;
                    --owner-purple-light: #F3E5F5;
                    --owner-bg: #F5F7FA;
                    --owner-sidebar-bg: #FFFFFF;
                    --owner-card-bg: #FFFFFF;
                    --owner-text: #37474F;
                    --owner-text-muted: #78909C;
                    --owner-border: #E0E0E0;
                    --owner-shadow: rgba(0, 0, 0, 0.08);
                    --sidebar-width: 280px;
                    --font-family: 'Cairo', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                }
                * { font-family: var(--font-family) !important; }
                
                /* Layout */
                .owner-dashboard-wrapper { display: flex; min-height: 100vh; background-color: var(--owner-bg); }
                
                /* Sidebar - Light Theme */
                .owner-sidebar { 
                    width: var(--sidebar-width); 
                    background: var(--owner-sidebar-bg); 
                    border-right: 1px solid var(--owner-border); 
                    position: fixed; 
                    left: 0; 
                    top: 0; 
                    height: 100vh; 
                    z-index: 1000; 
                    box-shadow: 2px 0 10px var(--owner-shadow); 
                    display: flex; 
                    flex-direction: column; 
                }
                .sidebar-header { padding: 1.5rem; border-bottom: 1px solid var(--owner-border); display: flex; align-items: center; gap: 1rem; }
                .sidebar-logo { width: 48px; height: 48px; background: linear-gradient(135deg, var(--owner-primary) 0%, var(--owner-primary-dark) 100%); border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
                .sidebar-logo svg { color: white; width: 24px; height: 24px; }
                .sidebar-logo-text h5 { margin: 0; font-weight: 700; color: var(--owner-text); font-size: 1.1rem; }
                .sidebar-logo-text small { color: var(--owner-text-muted); font-size: 0.8rem; }
                .sidebar-nav { flex: 1; padding: 1rem 0; overflow-y: auto; }
                .nav-section { margin-bottom: 1.5rem; }
                .nav-section-title { font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px; color: var(--owner-text-muted); padding: 0 1.5rem; margin-bottom: 0.5rem; }
                .sidebar-nav .nav-link { display: flex; align-items: center; padding: 0.75rem 1.5rem; color: var(--owner-text); text-decoration: none; transition: all 0.2s ease; border-left: 3px solid transparent; margin: 2px 0; }
                .sidebar-nav .nav-link .nav-icon { width: 20px; height: 20px; margin-right: 12px; flex-shrink: 0; color: var(--owner-text-muted); transition: all 0.2s ease; }
                .sidebar-nav .nav-link:hover { background-color: var(--owner-bg); color: var(--owner-primary); }
                .sidebar-nav .nav-link:hover .nav-icon { color: var(--owner-primary); }
                .sidebar-nav .nav-link.active { background-color: rgba(92, 107, 192, 0.1); color: var(--owner-primary); border-left-color: var(--owner-primary); font-weight: 600; }
                .sidebar-nav .nav-link.active .nav-icon { color: var(--owner-primary); }
                
                /* Main Content */
                .owner-main-content { flex: 1; margin-left: var(--sidebar-width); padding: 2rem; min-height: 100vh; }
                
                /* Welcome Section */
                .welcome-section { margin-bottom: 2rem; }
                .welcome-title { font-size: 2rem; font-weight: 700; color: var(--owner-text); margin: 0; }
                .welcome-subtitle { color: var(--owner-text-muted); margin: 0.5rem 0 0 0; font-size: 1.1rem; }
                
                /* Quick Links Grid */
                .quick-links-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
                .quick-link-card { background: var(--owner-card-bg); border-radius: 16px; padding: 1.5rem; box-shadow: 0 2px 12px var(--owner-shadow); transition: all 0.3s ease; text-decoration: none; display: flex; align-items: center; gap: 1rem; border: 1px solid transparent; }
                .quick-link-card:hover { transform: translateY(-4px); box-shadow: 0 8px 24px var(--owner-shadow); border-color: var(--owner-primary); }
                .quick-link-icon { width: 56px; height: 56px; border-radius: 14px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
                .quick-link-icon svg { width: 26px; height: 26px; }
                .quick-link-icon.dashboard { background: rgba(92, 107, 192, 0.15); color: var(--owner-primary); }
                .quick-link-icon.properties { background: var(--owner-info-light); color: var(--owner-info); }
                .quick-link-icon.payments { background: var(--owner-success-light); color: var(--owner-success); }
                .quick-link-icon.requests { background: var(--owner-warning-light); color: var(--owner-warning); }
                .quick-link-icon.quotes { background: var(--owner-purple-light); color: var(--owner-purple); }
                .quick-link-content h4 { margin: 0 0 0.25rem 0; font-weight: 600; color: var(--owner-text); font-size: 1rem; }
                .quick-link-content p { margin: 0; color: var(--owner-text-muted); font-size: 0.85rem; }
                
                /* Account Section */
                .account-section { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--owner-border); }
                .account-section h3 { font-size: 1.25rem; font-weight: 600; color: var(--owner-text); margin-bottom: 1rem; }
                
                @media (max-width: 991.98px) {
                    .owner-sidebar { transform: translateX(-100%); }
                    .owner-main-content { margin-left: 0; }
                }
                </style>
                
