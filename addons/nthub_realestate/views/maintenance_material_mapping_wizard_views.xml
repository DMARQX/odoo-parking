<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Material Mapping Wizard Form View -->
        <record id="maintenance_material_mapping_wizard_form" model="ir.ui.view">
            <field name="name">maintenance.material.mapping.wizard.form</field>
            <field name="model">maintenance.material.mapping.wizard</field>
            <field name="arch" type="xml">
                <form string="Map Materials to Products">
                    <sheet>
                        <group>
                            <field name="job_order_id" readonly="1"/>
                        </group>
                        
                        <notebook>
                            <page string="Material Mappings">
                                <field name="mapping_line_ids">
                                    <list editable="bottom">
                                        <field name="description"/>
                                        <field name="requested_qty"/>
                                        <field name="product_id" options="{'no_create': True}"/>
                                        <field name="mapped_qty"/>
                                        <field name="mapping_type"/>
                                        <field name="supplier_id" 
                                               invisible="mapping_type != 'purchase'"
                                               options="{'no_create': True}"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                    
                    <footer>
                        <button name="action_map_materials" string="Map Materials" 
                                type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Material Mapping Wizard Action -->
        <record id="action_maintenance_material_mapping_wizard" model="ir.actions.act_window">
            <field name="name">Map Materials</field>
            <field name="res_model">maintenance.material.mapping.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
    </data>
</odoo>