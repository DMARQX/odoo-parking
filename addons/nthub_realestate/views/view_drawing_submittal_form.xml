<odoo>


  <record id="view_unit_handover_form_list" model="ir.ui.view">
  <field name="name">view.unit.handover.form.list</field>
  <field name="model">unit.handover.form</field>
  <field name="arch" type="xml">
    <list>
      <field name="date"/>
      <field name="unit_number"/>
      <field name="tenant_name"/>
      <field name="contact_person"/>
    </list>
  </field>
</record>

<record id="view_unit_handover_form" model="ir.ui.view">
  <field name="name">unit.handover.form</field>
  <field name="model">unit.handover.form</field>
  <field name="arch" type="xml">
    <form string="Unit Handover Form">
      <sheet>
        <group>
          <field name="contract_id"/>
          <field name="date"/>
          <field name="unit_number"/>
          <field name="total_area"/>
          <field name="tenant_name"/>
          <field name="contact_person"/>
          <field name="office_number"/>
        </group>

        <notebook>
          <page string="Items Checklist">
            <field name="handover_item_ids">
              <list editable="bottom">
                <field name="item_name"/>
                <field name="description"/>
                <field name="checked"/>
              </list>
            </field>
          </page>

<!--          <page string="Signatures">-->
<!--            <group>-->
<!--              <field name="consultant_name"/>-->
<!--              <field name="consultant_signature" widget="image"/>-->
<!--              <field name="consultant_date"/>-->
<!--            </group>-->
<!--            <group>-->
<!--              <field name="tenant_rep_name"/>-->
<!--              <field name="tenant_signature" widget="image"/>-->
<!--              <field name="tenant_date"/>-->
<!--            </group>-->
<!--          </page>-->
        </notebook>
                <group string="Signatures">
          <group>
            <field name="consultant_name"/>
            <field name="consultant_signature" widget="signature"/>
            <field name="consultant_date"/>
          </group>
          <group>
            <field name="tenant_rep_name"/>
            <field name="tenant_signature" widget="signature"/>
            <field name="tenant_date"/>
          </group>
        </group>

      </sheet>
    </form>
  </field>
</record>



