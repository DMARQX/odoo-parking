<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ========================================================================================
             MAINTENANCE JOB ORDER - FORM VIEW
             ======================================================================================== -->
        <record id="maintenance_job_order_view_form" model="ir.ui.view">
            <field name="name">maintenance.job.order.view.form</field>
            <field name="model">maintenance.job.order</field>
            <field name="arch" type="xml">
                <form string="Maintenance Job Order">
                    <header>
                        <!-- Backend Actions -->
                        <button name="action_send_to_contractor" string="Send to Contractor" 
                                type="object" class="btn-primary" 
                                invisible="state != 'draft'"/>
                        <button name="action_map_materials" string="Map Materials" 
                                type="object" class="btn-info" 
                                invisible="(state not in ['sent_to_contractor', 'in_progress']) or (state == 'sent_to_contractor' and not requested_material_ids)"/>
                        <button name="action_issue_materials" string="Issue Materials" 
                                type="object" class="btn-info" 
                                invisible="state not in ['sent_to_contractor', 'in_progress'] or not issued_material_ids"/>
                        <button name="action_purchase_approval_request" string="Purchase Approval Request" 
                                type="object" class="btn-warning" 
                                invisible="state not in ['sent_to_contractor', 'in_progress'] or not purchase_material_ids or has_purchase_orders"/>
                        <button name="action_confirm_purchase_orders" string="Confirm Purchase Orders" 
                                type="object" class="btn-primary" 
                                invisible="not has_purchase_orders or state not in ['draft', 'sent_to_contractor', 'in_progress']"/>
                        <button name="action_materials_received" string="Materials Received" 
                                type="object" class="btn-info" 
                                invisible="not has_purchase_orders or state not in ['sent_to_contractor', 'in_progress']"/>
                        
                        <!-- Contractor Actions -->
                        <button name="action_start_work" string="Start Work" 
                                type="object" class="btn-primary" 
                                invisible="state != 'sent_to_contractor'"/>
                        <button name="action_mark_completed" string="Mark Work Completed" 
                                type="object" class="btn-success" 
                                invisible="state != 'in_progress'"/>
                        
                        <!-- Approval Actions -->
                        <button name="action_supervisor_approval" string="Supervisor Approval" 
                                type="object" class="btn-success" 
                                invisible="state != 'completed_by_contractor'"/>
                        <button name="action_tenant_approval" string="Tenant Approval" 
                                type="object" class="btn-success" 
                                invisible="state != 'pending_supervisor_approval'"/>
                        
                        <!-- Final Actions -->
                        <button name="action_close_job_order" string="Close Job Order" 
                                type="object" class="btn-secondary" 
                                invisible="state != 'pending_tenant_approval'"/>
                        <button name="action_cancel" string="Cancel" 
                                type="object" class="btn-danger" 
                                invisible="state in ['closed', 'cancelled']"/>
                        
                        <!-- Contractor Portal Actions (typically visible in portal) -->
                        <button name="action_start_work" string="Start Work" 
                                type="object" class="btn-primary" 
                                invisible="state != 'sent_to_contractor'" 
                                groups="base.group_portal"/>
                        <button name="action_mark_completed" string="Complete Work" 
                                type="object" class="btn-success" 
                                invisible="state != 'in_progress'" 
                                groups="base.group_portal"/>
                        
                        <field name="state" widget="statusbar" 
                               statusbar_visible="draft,sent_to_contractor,in_progress,completed_by_contractor,pending_supervisor_approval,pending_tenant_approval,closed"/>
                    </header>

                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="%(action_rental_maintenance_request)d" 
                                    type="action" 
                                    class="oe_stat_button" 
                                    icon="fa-wrench"
                                    invisible="not maintenance_request_id">
                                <field name="maintenance_request_id" widget="statinfo" string="Origin Request"/>
                            </button>
                            <button name="action_view_purchase_orders" 
                                    type="object" 
                                    class="oe_stat_button" 
                                    icon="fa-shopping-cart"
                                    invisible="purchase_order_count == 0">
                                <field name="purchase_order_count" widget="statinfo" string="Purchase Orders"/>
                            </button>
                            <button name="action_view_stock_pickings" 
                                    type="object" 
                                    class="oe_stat_button" 
                                    icon="fa-truck"
                                    invisible="stock_picking_count == 0">
                                <field name="stock_picking_count" widget="statinfo" string="Transfers"/>
                            </button>
                        </div>

                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name" readonly="1"/></h1>
                        </div>

                        <!-- ========== A. HEADER INFORMATION ========== -->
                        <group string="Job Order Information">
                            <group>
                                <field name="date" readonly="1"/>
                                <field name="maintenance_request_id" readonly="1"/>
                                <field name="x_unit_area" readonly="1"/>
                                <field name="ordered_by_id" readonly="1"/>
                                <field name="job_reference"/>
                            </group>
                            <group>
                                <field name="ordered_mobile" readonly="1"/>
                                <field name="ordered_email" readonly="1"/>
                                <field name="job_logged_by" readonly="1"/>
                                <field name="x_company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>

                        <group string="Assignment">
                            <group>
                                <field name="assigned_contractor_id" 
                                       options="{'no_create': True, 'no_create_edit': True}"/>
                                <field name="job_assigned_datetime" readonly="1"/>
                                <field name="job_type"/>
                                <field name="job_type_other" invisible="job_type != 'other'"/>
                            </group>
                            <group>
                                <field name="priority"/>
                                <field name="technician_id"/>
                            </group>
                        </group>

                        <!-- ========== B. JOB DESCRIPTION & EXECUTION ========== -->
                        <separator string="Job Description"/>
                        <field name="job_description" nolabel="1" 
                               placeholder="Detailed work order description..."/>

                        <group string="Execution Details">
                            <group>
                                <field name="job_start_datetime"/>
                                <field name="job_end_datetime"/>
                            </group>
                            <group>
                                <field name="additional_resources"/>
                                <field name="requested_material_text"/>
                            </group>
                        </group>

                        <separator string="Corrective Action" 
                                   invisible="state in ['draft', 'sent_to_contractor']"/>
                        <field name="corrective_action" nolabel="1" 
                               placeholder="What was done to fix the issue..."
                               invisible="state in ['draft', 'sent_to_contractor']"/>

                        <!-- ========== E. MATERIAL LINES (Notebook) ========== -->
                        <notebook>
                            <!-- E1: Requested Materials (Contractor Input) -->
                            <page string="Requested Materials" name="requested_materials">
                                <field name="requested_material_ids">
                                    <list editable="bottom">
                                        <field name="description"/>
                                        <field name="quantity"/>
                                        <field name="type_of_material"/>
                                        <field name="request_priority"/>
                                        <field name="reception_status"/>
                                        <field name="notes"/>
                                    </list>
                                </field>
                            </page>

                            <!-- E2: Issued Materials (From Stock) -->
                            <page string="Issued Materials" name="issued_materials">
                                <field name="issued_material_ids">
                                    <list editable="bottom">
                                        <field name="product_id" 
                                               domain="[('type', '!=', 'service')]"/>
                                        <field name="issue_qty"/>
                                        <field name="uom_id"/>
                                        <field name="serial_no"/>
                                        <field name="notes"/>
                                        <field name="move_id" readonly="1"/>
                                    </list>
                                </field>
                            </page>

                            <!-- E3: Materials to Purchase -->
                            <page string="To Purchase" name="purchase_materials">
                                <field name="purchase_material_ids">
                                    <list editable="bottom">
                                        <field name="product_id"/>
                                        <field name="quantity"/>
                                        <field name="received_quantities_po" readonly="1"/>
                                        <field name="uom_id"/>
                                        <field name="supplier_id"/>
                                        <field name="target_date"/>
                                        <field name="notes"/>
                                        <field name="purchase_line_id" readonly="1"/>
                                    </list>
                                </field>
                            </page>

                            <!-- C: Approvals & Sign Off -->
                            <page string="Approvals" name="approvals">
                                <group string="Contractor Supervisor Sign Off">
                                    <group>
                                        <field name="supervisor_id"/>
                                        <field name="supervisor_sign_datetime" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="supervisor_signature" widget="signature"/>
                                    </group>
                                </group>
                                <separator/>
                                <field name="supervisor_remarks" 
                                       placeholder="Supervisor remarks after work completion..."/>

                                <separator/>
                                
                                <group string="Tenant Approval">
                                    <group>
                                        <field name="tenant_manager_id"/>
                                        <field name="tenant_sign_datetime" readonly="1"/>
                                    </group>
                                    <group>
                                        <field name="tenant_signature" widget="signature"/>
                                    </group>
                                </group>
                                <separator/>
                                <field name="tenant_remarks" 
                                       placeholder="Tenant remarks on completed work..."/>

                                <separator/>

                                <group string="Manager Final Approval">
                                    <group>
                                        <field name="manager_name"/>
                                        <field name="manager_sign_date"/>
                                    </group>
                                    <group>
                                        <field name="manager_signature" widget="signature"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>

                        <!-- ========== CANCELLATION ========== -->
                        <group string="Cancellation Details" 
                               invisible="state != 'cancelled'">
                            <field name="cancellation_reason" nolabel="1"/>
                        </group>
                    </sheet>

                    <!-- CHATTER -->
                    <chatter>

                    </chatter>
                </form>
            </field>
        </record>

        <!-- ========================================================================================
             MAINTENANCE JOB ORDER - LIST VIEW
             ======================================================================================== -->
        <record id="maintenance_job_order_view_tree" model="ir.ui.view">
            <field name="name">maintenance.job.order.view.list</field>
            <field name="model">maintenance.job.order</field>
            <field name="arch" type="xml">
                <list string="Maintenance Job Orders" 
                      decoration-info="state=='draft'" 
                      decoration-warning="state in ['sent_to_contractor', 'in_progress']" 
                      decoration-success="state=='closed'">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="maintenance_request_id"/>
                    <field name="ordered_by_id"/>
                    <field name="x_unit_area"/>
                    <field name="assigned_contractor_id"/>
                    <field name="job_type"/>
                    <field name="priority" widget="priority"/>
                    <field name="state" widget="badge" 
                           decoration-info="state=='draft'" 
                           decoration-primary="state=='sent_to_contractor'" 
                           decoration-warning="state=='in_progress'" 
                           decoration-success="state=='closed'" 
                           decoration-danger="state=='cancelled'"/>
                </list>
            </field>
        </record>

        <!-- ========================================================================================
             MAINTENANCE JOB ORDER - SEARCH VIEW
             ======================================================================================== -->
        <record id="maintenance_job_order_view_search" model="ir.ui.view">
            <field name="name">maintenance.job.order.view.search</field>
            <field name="model">maintenance.job.order</field>
            <field name="arch" type="xml">
                <search string="Search Job Orders">
                    <field name="name" string="Job Order #"/>
                    <field name="maintenance_request_id" string="Request"/>
                    <field name="ordered_by_id" string="Tenant"/>
                    <field name="assigned_contractor_id" string="Contractor"/>
                    <field name="x_unit_area" string="Unit"/>
                    
                    <separator/>
                    
                    <!-- State Filters -->
                    <filter name="draft" string="Draft" 
                            domain="[('state', '=', 'draft')]"/>
                    <filter name="sent_to_contractor" string="Sent to Contractor" 
                            domain="[('state', '=', 'sent_to_contractor')]"/>
                    <filter name="in_progress" string="In Progress" 
                            domain="[('state', '=', 'in_progress')]"/>
                    <filter name="completed_by_contractor" string="Completed by Contractor" 
                            domain="[('state', '=', 'completed_by_contractor')]"/>
                    <filter name="pending_approvals" string="Pending Approvals" 
                            domain="[('state', 'in', ['pending_supervisor_approval', 'pending_tenant_approval'])]"/>
                    <filter name="closed" string="Closed" 
                            domain="[('state', '=', 'closed')]"/>
                    <filter name="cancelled" string="Cancelled" 
                            domain="[('state', '=', 'cancelled')]"/>
                    
                    <separator/>
                    
                    <!-- Priority Filters -->
                    <filter name="urgent" string="Urgent" 
                            domain="[('priority', '=', 'urgent')]"/>
                    <filter name="high" string="High Priority" 
                            domain="[('priority', '=', 'high')]"/>
                    
                    <separator/>
                    
                    <!-- Job Type Filters -->
                    <filter name="fault" string="Fault" 
                            domain="[('job_type', '=', 'fault')]"/>
                    <filter name="new" string="New" 
                            domain="[('job_type', '=', 'new')]"/>
                    <filter name="site_visit" string="Site Visit" 
                            domain="[('job_type', '=', 'site_visit')]"/>
                    
                    <separator/>
                    
                    <!-- Date Filters -->
                    <filter name="today" string="Today" 
                            domain="[('date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                    <filter name="this_week" string="This Week" 
                            domain="[('date', '&gt;=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                    <filter name="this_month" string="This Month" 
                            domain="[('date', '&gt;=', (context_today().replace(day=1)).strftime('%Y-%m-%d'))]"/>
                    
                    <separator/>
                    
                    <!-- Group By -->
                    <group string="Group By" expand="0">
                        <filter name="group_by_state" string="Status" 
                                context="{'group_by': 'state'}"/>
                        <filter name="group_by_contractor" string="Contractor" 
                                context="{'group_by': 'assigned_contractor_id'}"/>
                        <filter name="group_by_priority" string="Priority" 
                                context="{'group_by': 'priority'}"/>
                        <filter name="group_by_job_type" string="Job Type" 
                                context="{'group_by': 'job_type'}"/>
                        <filter name="group_by_tenant" string="Tenant" 
                                context="{'group_by': 'ordered_by_id'}"/>
                        <filter name="group_by_date" string="Date" 
                                context="{'group_by': 'date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ========================================================================================
             MAINTENANCE JOB ORDER - KANBAN VIEW
             ======================================================================================== -->
        <record id="maintenance_job_order_view_kanban" model="ir.ui.view">
            <field name="name">maintenance.job.order.view.kanban</field>
            <field name="model">maintenance.job.order</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile" default_group_by="state">
                    <field name="name"/>
                    <field name="date"/>
                    <field name="ordered_by_id"/>
                    <field name="assigned_contractor_id"/>
                    <field name="priority"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top mb-2">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <span class="badge" t-att-class="record.priority.raw_value == 'urgent' ? 'badge-danger' : record.priority.raw_value == 'high' ? 'badge-warning' : 'badge-secondary'">
                                        <field name="priority"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="ordered_by_id"/>
                                    <br/>
                                    <field name="assigned_contractor_id"/>
                                </div>
                                <div class="o_kanban_record_bottom mt-2">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="date"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ========================================================================================
             MAINTENANCE JOB ORDER - ACTION
             ======================================================================================== -->
        <record id="action_maintenance_job_order" model="ir.actions.act_window">
            <field name="name">Maintenance Job Orders</field>
            <field name="res_model">maintenance.job.order</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="search_view_id" ref="maintenance_job_order_view_search"/>
            <field name="context">{'search_default_in_progress': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No job orders found. Create one from a maintenance request!
                </p>
            </field>
        </record>

        <!-- ========================================================================================
             MENU ITEMS
             ======================================================================================== -->
        <!-- Will be added to existing menu structure -->

    </data>
</odoo>
