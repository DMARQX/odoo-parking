<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============================================
         NEW REQUEST FORM - MODERN DESIGN
         With Sidebar Navigation (matching Dashboard)
         ============================================ -->

    <template id="portal_owner_request_form_new" name="New Owner Request - Modern">
        <t t-call="portal.portal_layout">
            <t t-set="no_breadcrumbs" t-value="True"/>
            
            <!-- Load Google Fonts - Cairo for Arabic -->
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous"/>
            <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;500;600;700&amp;family=Inter:wght@300;400;500;600;700&amp;display=swap" rel="stylesheet"/>
            
            <style type="text/css">
            /* Request Form Styles */
            :root {
                --req-primary: #5C6BC0;
                --req-primary-light: #E8EAF6;
                --req-primary-dark: #3949AB;
                --req-success: #66BB6A;
                --req-success-light: #E8F5E9;
                --req-warning: #FFA726;
                --req-warning-light: #FFF3E0;
                --req-danger: #EF5350;
                --req-danger-light: #FFEBEE;
                --req-info: #42A5F5;
                --req-info-light: #E3F2FD;
                --req-text: #37474F;
                --req-text-muted: #78909C;
                --req-bg: #F5F7FA;
                --req-card-bg: #FFFFFF;
                --req-border: #E0E0E0;
                --req-shadow: rgba(0, 0, 0, 0.06);
                --req-font: 'Cairo', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
                --sidebar-width: 280px;
                --sidebar-collapsed-width: 80px;
            }
            
            * { font-family: var(--req-font) !important; }
            
            .request-form-wrapper { 
                display: flex; 
                min-height: 100vh; 
                background-color: var(--req-bg);
                font-family: var(--req-font);
            }
            
            /* Sidebar Styles */
            .req-sidebar { 
                width: var(--sidebar-width); 
                background: var(--req-card-bg); 
                border-right: 1px solid var(--req-border); 
                position: fixed; 
                left: 0; 
                top: 0; 
                height: 100vh; 
                z-index: 1000; 
                transition: all 0.3s ease; 
                box-shadow: 2px 0 10px var(--req-shadow); 
                display: flex; 
                flex-direction: column; 
            }
            .sidebar-header { 
                padding: 1.5rem; 
                border-bottom: 1px solid var(--req-border); 
                display: flex; 
                align-items: center; 
                gap: 1rem; 
            }
            .sidebar-logo { 
                width: 48px; 
                height: 48px; 
                background: linear-gradient(135deg, var(--req-primary) 0%, var(--req-primary-dark) 100%); 
                border-radius: 12px; 
                display: flex; 
                align-items: center; 
                justify-content: center; 
                flex-shrink: 0; 
            }
            .sidebar-logo svg { width: 24px; height: 24px; color: white; }
            .sidebar-logo-text h5 { margin: 0; font-weight: 700; color: var(--req-text); font-size: 1.1rem; }
            .sidebar-logo-text small { color: var(--req-text-muted); font-size: 0.8rem; }
            .sidebar-nav { flex: 1; padding: 1rem 0; overflow-y: auto; }
            .nav-section { margin-bottom: 1.5rem; }
            .nav-section-title { 
                font-size: 0.7rem; 
                font-weight: 600; 
                text-transform: uppercase; 
                letter-spacing: 0.5px; 
                color: var(--req-text-muted); 
                padding: 0 1.5rem; 
                margin-bottom: 0.5rem; 
            }
            .sidebar-nav .nav-link { 
                display: flex; 
                align-items: center; 
                padding: 0.75rem 1.5rem; 
                color: var(--req-text); 
                text-decoration: none; 
                transition: all 0.2s ease; 
                border-left: 3px solid transparent; 
                margin: 2px 0; 
            }
            .sidebar-nav .nav-link .nav-icon { 
                width: 20px; 
                height: 20px; 
                margin-right: 12px; 
                flex-shrink: 0;
                color: var(--req-text-muted); 
                transition: all 0.2s ease; 
            }
            .sidebar-nav .nav-link:hover { background-color: var(--req-bg); color: var(--req-primary); }
            .sidebar-nav .nav-link:hover .nav-icon { color: var(--req-primary); }
            .sidebar-nav .nav-link.active { 
                background-color: rgba(92, 107, 192, 0.1); 
                color: var(--req-primary); 
                border-left-color: var(--req-primary); 
                font-weight: 600; 
            }
            .sidebar-nav .nav-link.active .nav-icon { color: var(--req-primary); }
            .nav-badge { 
                margin-left: auto; 
                background-color: var(--req-danger); 
                color: white; 
                font-size: 0.7rem; 
                padding: 0.2rem 0.5rem; 
                border-radius: 10px; 
                font-weight: 600; 
            }
            .sidebar-user { 
                padding: 1rem 1.5rem; 
                border-top: 1px solid var(--req-border); 
                background-color: var(--req-bg); 
                display: flex;
                align-items: center;
                gap: 0.75rem;
            }
            .user-avatar { 
                width: 40px; 
                height: 40px; 
                background: linear-gradient(135deg, #26A69A 0%, #E0F2F1 100%); 
                border-radius: 50%; 
                display: flex; 
                align-items: center; 
                justify-content: center; 
                color: white; 
                font-weight: 600; 
                font-size: 1rem; 
            }
            .user-info h6 { margin: 0; font-size: 0.9rem; font-weight: 600; color: var(--req-text); }
            .user-info small { color: var(--req-text-muted); font-size: 0.75rem; }
            
            /* Main Content */
            .req-main-content { 
                flex: 1; 
                margin-left: var(--sidebar-width); 
                padding: 2rem; 
                transition: margin-left 0.3s ease; 
                min-height: 100vh; 
            }
            
            /* Page Header */
            .req-page-header {
                margin-bottom: 2rem;
            }
            .req-page-header h1 {
                font-size: 1.75rem;
                font-weight: 700;
                color: var(--req-text);
                margin-bottom: 0.5rem;
            }
            .req-page-header p {
                color: var(--req-text-muted);
                margin: 0;
            }
            
            /* Form Card */
            .req-form-card {
                background: var(--req-card-bg);
                border-radius: 16px;
                box-shadow: 0 2px 12px var(--req-shadow);
                overflow: hidden;
                max-width: 800px;
            }
            .req-form-header {
                padding: 1.5rem 2rem;
                background: linear-gradient(135deg, var(--req-primary) 0%, var(--req-primary-dark) 100%);
                color: white;
            }
            .req-form-header h3 {
                margin: 0 0 0.25rem 0;
                font-weight: 600;
                font-size: 1.25rem;
            }
            .req-form-header p {
                margin: 0;
                opacity: 0.9;
                font-size: 0.9rem;
            }
            .req-form-body {
                padding: 2rem;
            }
            
            /* Form Elements */
            .form-group {
                margin-bottom: 1.5rem;
            }
            .form-group label {
                display: block;
                font-weight: 600;
                color: var(--req-text);
                margin-bottom: 0.5rem;
                font-size: 0.9rem;
            }
            .form-group label .required {
                color: var(--req-danger);
            }
            .form-control-modern {
                width: 100%;
                padding: 0.75rem 1rem;
                border: 2px solid var(--req-border);
                border-radius: 10px;
                font-size: 0.95rem;
                transition: all 0.2s ease;
                background: var(--req-card-bg);
            }
            .form-control-modern:focus {
                outline: none;
                border-color: var(--req-primary);
                box-shadow: 0 0 0 3px rgba(92, 107, 192, 0.15);
            }
            .form-control-modern::placeholder {
                color: var(--req-text-muted);
            }
            select.form-control-modern {
                cursor: pointer;
            }
            textarea.form-control-modern {
                min-height: 120px;
                resize: vertical;
            }
            
            /* Request Type Cards */
            .request-type-grid {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 1rem;
            }
            .request-type-card {
                position: relative;
                padding: 1.25rem;
                border: 2px solid var(--req-border);
                border-radius: 12px;
                cursor: pointer;
                transition: all 0.2s ease;
                background: var(--req-card-bg);
            }
            .request-type-card:hover {
                border-color: var(--req-primary-light);
                background: var(--req-primary-light);
            }
            .request-type-card.selected {
                border-color: var(--req-primary);
                background: var(--req-primary-light);
            }
            .request-type-card input[type="radio"] {
                position: absolute;
                opacity: 0;
            }
            .request-type-card .type-icon {
                width: 40px;
                height: 40px;
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                margin-bottom: 0.75rem;
                font-size: 1.25rem;
            }
            .request-type-card .type-icon.financial { background: var(--req-success-light); color: var(--req-success); }
            .request-type-card .type-icon.maintenance { background: var(--req-warning-light); color: var(--req-warning); }
            .request-type-card .type-icon.info { background: var(--req-info-light); color: var(--req-info); }
            .request-type-card .type-icon.other { background: #F3E5F5; color: #AB47BC; }
            .request-type-card h6 {
                margin: 0 0 0.25rem 0;
                font-weight: 600;
                color: var(--req-text);
            }
            .request-type-card p {
                margin: 0;
                font-size: 0.8rem;
                color: var(--req-text-muted);
            }
            
            /* File Upload */
            .file-upload-area {
                border: 2px dashed var(--req-border);
                border-radius: 12px;
                padding: 2rem;
                text-align: center;
                cursor: pointer;
                transition: all 0.2s ease;
                background: var(--req-bg);
            }
            .file-upload-area:hover {
                border-color: var(--req-primary);
                background: var(--req-primary-light);
            }
            .file-upload-area i {
                font-size: 2.5rem;
                color: var(--req-primary);
                margin-bottom: 0.75rem;
            }
            .file-upload-area h6 {
                margin: 0 0 0.25rem 0;
                font-weight: 600;
                color: var(--req-text);
            }
            .file-upload-area p {
                margin: 0;
                font-size: 0.85rem;
                color: var(--req-text-muted);
            }
            .file-upload-area input[type="file"] {
                display: none;
            }
            
            /* Buttons */
            .form-actions {
                display: flex;
                justify-content: flex-end;
                gap: 1rem;
                padding-top: 1rem;
                border-top: 1px solid var(--req-border);
                margin-top: 1rem;
            }
            .btn-cancel {
                padding: 0.75rem 1.5rem;
                border: 2px solid var(--req-border);
                border-radius: 10px;
                background: transparent;
                color: var(--req-text);
                font-weight: 600;
                cursor: pointer;
                transition: all 0.2s ease;
                text-decoration: none;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
            }
            .btn-cancel:hover {
                background: var(--req-bg);
                border-color: var(--req-text-muted);
            }
            .btn-submit {
                padding: 0.75rem 2rem;
                border: none;
                border-radius: 10px;
                background: linear-gradient(135deg, var(--req-primary) 0%, var(--req-primary-dark) 100%);
                color: white;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.2s ease;
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
            }
            .btn-submit:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(92, 107, 192, 0.4);
            }
            
            /* Tips Card */
            .tips-card {
                background: var(--req-info-light);
                border-radius: 12px;
                padding: 1.25rem;
                margin-top: 1.5rem;
                max-width: 800px;
            }
            .tips-card h6 {
                margin: 0 0 0.75rem 0;
                color: var(--req-info);
                font-weight: 600;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }
            .tips-card ul {
                margin: 0;
                padding-left: 1.25rem;
            }
            .tips-card li {
                color: var(--req-text);
                font-size: 0.85rem;
                margin-bottom: 0.35rem;
            }
            
            /* Responsive */
            @media (max-width: 992px) {
                .req-sidebar { transform: translateX(-100%); }
                .req-main-content { margin-left: 0; }
                .request-type-grid { grid-template-columns: 1fr; }
            }
            @media (max-width: 576px) {
                .req-form-body { padding: 1.25rem; }
                .form-actions { flex-direction: column-reverse; }
                .btn-cancel, .btn-submit { width: 100%; justify-content: center; }
            }
            </style>
            
