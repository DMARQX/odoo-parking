<odoo>
    <data>

        <!-- ======================== FORM VIEW ======================== -->
        <record id="rental_maintenance_request_view_form" model="ir.ui.view">
            <field name="name">rental.maintenance.request.view.form</field>
            <field name="model">rental.maintenance.request</field>
            <field name="arch" type="xml">
                <form string="Maintenance Request">
                    <header>
                        <!-- Submit: Only in Draft -->
                        <button name="action_submit" string="Submit" type="object" class="btn-primary" data-hotkey="q" invisible="x_status != 'draft'"/>
                        
                        <!-- Under Review: Only when Submitted -->
                        <button name="action_under_review" string="Under Review" type="object" class="btn-warning" invisible="x_status != 'submitted'"/>
                        
                        <!-- Create Job Order: Only when Under Review and no job order exists -->
                        <button name="action_create_job_order" string="Create Job Order" type="object" class="btn-success" invisible="x_status != 'under_review' or x_job_order_id"/>
                        
                        <!-- Mark Completed: Only when In Progress -->
                        <button name="action_mark_completed" string="Mark Completed" type="object" class="btn-info" invisible="x_status != 'in_progress'"/>
                        
                        <!-- Close: Only when approved by tenant or pending tenant approval -->
                        <button name="action_close" string="Close" type="object" class="btn-secondary" invisible="x_status not in ('approved_by_tenant', 'pending_tenant_approval')"/>
                        
                        <!-- Cancel: Available in draft, submitted, under_review, job_ordered states -->
                        <button name="action_cancel" string="Cancel" type="object" class="btn-danger" invisible="x_status not in ('draft', 'submitted', 'under_review', 'job_ordered')"/>
                        
                        <field name="x_status" widget="statusbar" statusbar_visible="draft,submitted,under_review,job_ordered,in_progress,closed"/>
                    </header>
                    <sheet>
                        <!-- Smart Button -->
                        <div class="oe_button_box" name="button_box">
                            <button name="action_view_job_order" type="object" class="oe_stat_button" icon="fa-tasks" invisible="not x_job_order_id">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">Job Order</span>
                                </div>
                            </button>
                        </div>
                        
                        <div class="oe_title">
                            <label for="name" class="oe_edit_only"/>
                            <h1><field name="name"/></h1>
                        </div>

                        <!-- BASIC INFORMATION -->
                        <group string="Request Information">
                            <group>
                                <field name="request_date"/>
                                <field name="x_request_type"/>
                                <field name="priority"/>
                                <field name="x_job_logged_by"/>
                            </group>
                            <group>
                                <field name="contract_id"/>
                                <field name="partner_id" readonly="1"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>

                        <!-- TENANT & LOCATION -->
                        <group string="Tenant &amp; Location">
                            <group>
                                <field name="x_unit_area" readonly="1"/>
                                <field name="x_building_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="x_tenant_mobile" readonly="1"/>
                                <field name="x_tenant_email" readonly="1"/>
                            </group>
                        </group>

                        <!-- PROBLEM DESCRIPTION -->
                        <separator string="Description of Problem"/>
                        <field name="description" nolabel="1" placeholder="Provide detailed description of the maintenance issue..."/>

                        <!-- ATTACHMENTS -->
                        <separator string="Attachments"/>
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>

                        <!-- JOB ORDER LINKAGE -->
                        <group string="Job Order Information" invisible="not x_job_order_id">
                            <group>
                                <field name="x_job_order_id" readonly="1"/>
                                <field name="x_job_assigned_to" readonly="1"/>
                                <field name="x_job_assigned_by" readonly="1"/>
                            </group>
                            <group>
                                <field name="x_job_assigned_time" readonly="1"/>
                                <field name="approved_by_tenant_date" readonly="1"/>
                            </group>
                        </group>

                        <!-- CANCELLATION -->
                        <group string="Cancellation Details" invisible="x_status != 'cancelled'">
                            <field name="cancellation_reason" nolabel="1"/>
                        </group>
                    </sheet>

                    <!-- CHATTER -->
                    <chatter>

                    </chatter>
                </form>
            </field>
        </record>

        <!-- ======================== LIST VIEW ======================== -->
        <record id="rental_maintenance_request_view_tree" model="ir.ui.view">
            <field name="name">rental.maintenance.request.view.list</field>
            <field name="model">rental.maintenance.request</field>
            <field name="arch" type="xml">
                <list string="Maintenance Requests" decoration-info="x_status=='draft'" decoration-warning="x_status=='submitted'" decoration-success="x_status=='completed'">
                    <field name="name"/>
                    <field name="contract_id"/>
                    <field name="partner_id"/>
                    <field name="x_request_type"/>
                    <field name="priority"/>
                    <field name="request_date"/>
                    <field name="x_status" widget="badge" decoration-success="x_status=='closed'" decoration-danger="x_status=='cancelled'"/>
                </list>
            </field>
        </record>

        <!-- ======================== SEARCH VIEW ======================== -->
        <record id="rental_maintenance_request_view_search" model="ir.ui.view">
            <field name="name">rental.maintenance.request.view.search</field>
            <field name="model">rental.maintenance.request</field>
            <field name="arch" type="xml">
                <search string="Search Maintenance Requests">
                    <field name="name" string="Request Reference"/>
                    <field name="contract_id" string="Contract"/>
                    <field name="partner_id" string="Tenant"/>
                    <field name="x_unit_area" string="Unit"/>
                    <separator/>
                    <filter name="draft" string="Draft" domain="[('x_status', '=', 'draft')]"/>
                    <filter name="submitted" string="Submitted" domain="[('x_status', '=', 'submitted')]"/>
                    <filter name="under_review" string="Under Review" domain="[('x_status', '=', 'under_review')]"/>
                    <filter name="job_ordered" string="Job Ordered" domain="[('x_status', '=', 'job_ordered')]"/>
                    <filter name="in_progress" string="In Progress" domain="[('x_status', '=', 'in_progress')]"/>
                    <filter name="completed" string="Completed" domain="[('x_status', '=', 'completed')]"/>
                    <filter name="closed" string="Closed" domain="[('x_status', '=', 'closed')]"/>
                    <filter name="cancelled" string="Cancelled" domain="[('x_status', '=', 'cancelled')]"/>
                    <separator/>
                    <filter name="urgent" string="Urgent" domain="[('priority', '=', 'urgent')]"/>
                    <filter name="high" string="High Priority" domain="[('priority', '=', 'high')]"/>
                    <separator/>
                    <filter name="electrical" string="Electrical" domain="[('x_request_type', '=', 'electrical')]"/>
                    <filter name="mechanical" string="Mechanical" domain="[('x_request_type', '=', 'mechanical')]"/>
                    <filter name="civil" string="Civil" domain="[('x_request_type', '=', 'civil')]"/>
                    <separator/>
                    <group string="Group By" expand="0">
                        <filter name="group_by_status" string="Status" context="{'group_by': 'x_status'}"/>
                        <filter name="group_by_priority" string="Priority" context="{'group_by': 'priority'}"/>
                        <filter name="group_by_type" string="Request Type" context="{'group_by': 'x_request_type'}"/>
                        <filter name="group_by_tenant" string="Tenant" context="{'group_by': 'partner_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ======================== WINDOW ACTION ======================== -->
        <record id="action_rental_maintenance_request" model="ir.actions.act_window">
            <field name="name">Maintenance Requests</field>
            <field name="res_model">rental.maintenance.request</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="rental_maintenance_request_view_search"/>
            <field name="context">{'search_default_draft': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No maintenance requests found. Let's create one!
                </p>
            </field>
        </record>

    </data>
</odoo>