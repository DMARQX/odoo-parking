<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="0">

    <!-- ==================== APPLICATION CATEGORY ==================== -->
    <record id="module_category_parking" model="ir.module.category">
        <field name="name">Parking</field>
        <field name="description">Parking Management System - Control permissions for each parking feature</field>
        <field name="sequence">100</field>
    </record>

    <!-- ================================================================ -->
    <!-- BASE: READ-ONLY ACCESS (Visible in Settings → Users → Access Rights) -->
    <!-- ================================================================ -->
    <record id="group_parking_user" model="res.groups">
        <field name="name">User</field>
        <field name="comment">Read-only access to all parking data. Users can view contracts, spots, vehicles, inspections, and configuration.</field>
        <field name="category_id" ref="module_category_parking"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- ================================================================ -->
    <!-- CONTRACTS PERMISSIONS -->
    <!-- ================================================================ -->
    <record id="group_parking_contract" model="res.groups">
        <field name="name">Contracts: Create / Edit</field>
        <field name="comment">Can create and modify parking contracts and view contract history.</field>
        <field name="category_id" ref="module_category_parking"/>
        <field name="implied_ids" eval="[(4, ref('group_parking_user'))]"/>
    </record>

    <record id="group_parking_contract_delete" model="res.groups">
        <field name="name">Contracts: Delete</field>
        <field name="comment">Can delete contracts and contract history records.</field>
        <field name="category_id" ref="module_category_parking"/>
        <field name="implied_ids" eval="[(4, ref('group_parking_contract'))]"/>
    </record>

    <!-- ================================================================ -->
    <!-- INVOICING -->
    <!-- ================================================================ -->
    <record id="group_parking_invoicing" model="res.groups">
        <field name="name">Invoicing</field>
        <field name="comment">Can create invoices from parking contracts.</field>
        <field name="category_id" ref="module_category_parking"/>
        <field name="implied_ids" eval="[(4, ref('group_parking_user'))]"/>
    </record>

    <!-- ================================================================ -->
    <!-- CHECK IN / CHECK OUT -->
    <!-- ================================================================ -->
    <record id="group_parking_checkinout" model="res.groups">
        <field name="name">Check In / Check Out</field>
        <field name="comment">Can register check-in and check-out operations for vehicles.</field>
        <field name="category_id" ref="module_category_parking"/>
        <field name="implied_ids" eval="[(4, ref('group_parking_user'))]"/>
    </record>

