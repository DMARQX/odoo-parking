<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_inspection_pdf">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page o_pm_doc">
                        <t t-call="parking_management.pm_title">
                            <t t-set="title">Vehicle Inspection Report</t>
                            <t t-set="ref" t-value="o.name"/>
                        </t>

                        <div class="o_pm_section">
                            <div class="o_pm_section_title">Inspection Details</div>
                            <table class="o_pm_kv o_pm_kv4 o_ignore_layout_styling">
                                <tr>
                                    <td class="o_pm_k">Vehicle</td><td class="fw-bold" t-esc="o.vehicle_id.display_name"/>
                                    <td class="o_pm_k">Date</td><td><span t-field="o.date"/></td>
                                </tr>
                                <tr>
                                    <td class="o_pm_k">Owner</td><td t-esc="o.vehicle_id.owner_id.display_name or '—'"/>
                                    <td class="o_pm_k">Inspector</td><td t-esc="o.inspector_id.name"/>
                                </tr>
                                <tr>
                                    <td class="o_pm_k">Status</td><td><span t-field="o.state"/></td>
                                    <td class="o_pm_k">Result</td>
                                    <td>
                                        <t t-set="failed" t-value="o.line_ids.filtered(lambda l: l.result == 'fail')"/>
                                        <t t-set="unchecked" t-value="o.line_ids.filtered(lambda l: not l.result)"/>
                                        <span t-if="failed" class="o_pm_fail"><t t-esc="len(failed)"/> item(s) failed</span>
                                        <span t-elif="unchecked" class="text-muted"><t t-esc="len(unchecked)"/> item(s) not checked</span>
                                        <span t-else="" class="o_pm_pass">All items passed</span>
                                    </td>
                                </tr>
                            </table>
                        </div>

                        <div class="o_pm_section">
                            <div class="o_pm_section_title">Checklist</div>
                            <table class="o_pm_table o_ignore_layout_styling">
                                <thead>
                                    <tr><th>Category</th><th>Checkpoint</th><th>Result</th><th>Notes</th></tr>
                                </thead>
                                <tbody>
                                    <tr t-foreach="o.line_ids.sorted(lambda l: (l.category or '', l.id))" t-as="line">
                                        <td><span t-field="line.category"/></td>
                                        <td t-esc="line.checkpoint_id.name"/>
                                        <td class="text-nowrap">
                                            <span t-if="line.result == 'pass'" class="o_pm_pass">✓ <span t-field="line.result"/></span>
                                            <span t-elif="line.result == 'fail'" class="o_pm_fail">✗ <span t-field="line.result"/></span>
                                            <span t-elif="line.result" class="text-muted" t-field="line.result"/>
                                            <span t-else="" class="text-muted">—</span>
                                        </td>
                                        <td t-esc="line.notes or ''"/>
                                    </tr>
                                    <tr t-if="not o.line_ids"><td colspan="4" class="o_pm_empty">No records.</td></tr>
                                </tbody>
                            </table>
                        </div>

                        <div t-if="o.notes" class="o_pm_section">
                            <div class="o_pm_section_title">General Notes</div>
                            <div class="o_pm_section_body" t-field="o.notes"/>
                        </div>

                        <t t-set="photo_lines" t-value="o.line_ids.filtered(lambda l: l.image)"/>
                        <div t-if="photo_lines" class="o_pm_section">
                            <div class="o_pm_section_title">Photos</div>
                            <table class="o_pm_photos o_ignore_layout_styling">
                                <t t-foreach="range(0, len(photo_lines), 3)" t-as="start">
                                    <tr>
                                        <td t-foreach="photo_lines[start:start + 3]" t-as="line">
                                            <img t-att-src="image_data_uri(line.image)"/>
                                            <div class="o_pm_sign_name" t-esc="line.checkpoint_id.name"/>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                        </div>

                        <table class="o_pm_signatures o_ignore_layout_styling">
                            <tr>
                                <td>
                                    <div class="o_pm_sign_line"/>
                                    <div class="o_pm_sign_label">Inspector Signature</div>
                                    <div class="o_pm_sign_name" t-esc="o.inspector_id.name"/>
                                </td>
                                <td>
                                    <div class="o_pm_sign_line"/>
                                    <div class="o_pm_sign_label">Customer Signature</div>
                                    <div class="o_pm_sign_name" t-esc="o.vehicle_id.owner_id.display_name or ''"/>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_report_inspection" model="ir.actions.report">
        <field name="name">Inspection Report</field>
        <field name="model">parking.vehicle.inspection</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">parking_management.report_inspection_pdf</field>
        <field name="report_file">parking_management.report_inspection_pdf</field>
        <field name="binding_model_id" ref="model_parking_vehicle_inspection"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Inspection_%s' % (object.name or '')</field>
    </record>
</odoo>
