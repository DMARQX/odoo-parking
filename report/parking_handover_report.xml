<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_vehicle_handover" model="ir.actions.report">
        <field name="name">Vehicle Handover Record</field>
        <field name="model">parking.vehicle.movement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">parking_management.report_vehicle_handover</field>
        <field name="report_file">parking_management.report_vehicle_handover</field>
        <field name="print_report_name">'Handover - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_parking_vehicle_movement"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_vehicle_handover">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page o_pm_doc">
                        <t t-call="parking_management.pm_title">
                            <t t-set="title">Vehicle Handover Record</t>
                            <t t-set="ref" t-value="o.name"/>
                        </t>

                        <div class="o_pm_section">
                            <div class="o_pm_section_title">Details</div>
                            <table class="o_pm_kv o_pm_kv4 o_ignore_layout_styling">
                                <tr>
                                    <td class="o_pm_k">Customer</td><td class="fw-bold" t-esc="o.partner_id.display_name or '—'"/>
                                    <td class="o_pm_k">Status</td><td><span t-field="o.state"/></td>
                                </tr>
                                <tr>
                                    <td class="o_pm_k">Vehicle</td><td t-esc="o.vehicle_id.display_name"/>
                                    <td class="o_pm_k">Contract</td><td t-esc="o.contract_id.name or '—'"/>
                                </tr>
                                <tr>
                                    <td class="o_pm_k">Branch</td><td t-esc="o.location_id.name or '—'"/>
                                    <td class="o_pm_k">Spot</td><td t-esc="o.spot_id.name or '—'"/>
                                </tr>
                                <tr>
                                    <td class="o_pm_k">Key Tag No.</td><td t-esc="o.vehicle_id.key_tag or '—'"/>
                                    <td class="o_pm_k">Key Box Slot</td><td t-esc="o.key_slot or o.vehicle_id.key_slot or '—'"/>
                                </tr>
                            </table>
                        </div>

                        <table class="o_pm_table o_ignore_layout_styling">
                            <thead>
                                <tr><th style="width: 26%;"/><th>Delivery to Customer</th><th>Return</th></tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-bold">Date</td>
                                    <td><span t-if="o.check_out_time" t-field="o.check_out_time"/><t t-else="">—</t></td>
                                    <td><span t-if="o.check_in_time" t-field="o.check_in_time"/><t t-else="">—</t></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Staff</td>
                                    <td t-esc="o.operator_out_id.name or '—'"/>
                                    <td t-esc="o.operator_in_id.name or '—'"/>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Handed To / Received From</td>
                                    <td t-esc="o.out_handover_to or '—'"/>
                                    <td t-esc="o.in_received_from or '—'"/>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Odometer (km)</td>
                                    <td t-esc="o.out_odometer or '—'"/>
                                    <td t-esc="o.in_odometer or '—'"/>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Fuel Level</td>
                                    <td><span t-if="o.out_fuel" t-field="o.out_fuel"/><t t-else="">—</t></td>
                                    <td><span t-if="o.in_fuel" t-field="o.in_fuel"/><t t-else="">—</t></td>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Customer Signature</td>
                                    <td><div class="o_pm_sign_line"><img t-if="o.out_signature" t-att-src="image_data_uri(o.out_signature)"/></div></td>
                                    <td><div class="o_pm_sign_line"><img t-if="o.in_signature" t-att-src="image_data_uri(o.in_signature)"/></div></td>
                                </tr>
                            </tbody>
                        </table>

                        <p t-if="o.distance_km or round(o.duration_hours, 1)" class="o_pm_note">
                            <span t-if="o.distance_km">Distance: <t t-esc="o.distance_km"/> km.</span>
                            <span t-if="round(o.duration_hours, 1)">Time out: <t t-esc="round(o.duration_hours, 1)"/> h.</span>
                        </p>

                        <div t-if="o.notes" class="o_pm_section">
                            <div class="o_pm_section_title">Notes</div>
                            <div class="o_pm_section_body" t-field="o.notes"/>
                        </div>

                        <t t-set="photos" t-value="(o.out_attachment_ids | o.in_attachment_ids).filtered(lambda a: (a.mimetype or '').startswith('image/'))"/>
                        <div t-if="photos" class="o_pm_section">
                            <div class="o_pm_section_title">Photos</div>
                            <table class="o_pm_photos o_ignore_layout_styling">
                                <t t-foreach="range(0, len(photos), 3)" t-as="start">
                                    <tr>
                                        <td t-foreach="photos[start:start + 3]" t-as="photo">
                                            <img t-att-src="image_data_uri(photo.datas)"/>
                                            <div class="o_pm_sign_name" t-esc="photo.name"/>
                                        </td>
                                    </tr>
                                </t>
                            </table>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
