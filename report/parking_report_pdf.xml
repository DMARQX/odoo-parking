<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="action_report_parking_spots_summary" model="ir.actions.report">
        <field name="name">Spots Summary Report</field>
        <field name="model">parking.spot</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">parking_management.report_parking_spots_summary</field>
        <field name="report_file">parking_spots_summary</field>
        <field name="binding_model_id" ref="model_parking_spot"/>
        <field name="binding_type">report</field>
        <field name="multi">True</field>
        <field name="paperformat_id" ref="paperformat_parking_a4_landscape"/>
        <field name="print_report_name">'Spots-Summary'</field>
    </record>

    <record id="action_report_parking_contracts_summary" model="ir.actions.report">
        <field name="name">Contracts Summary Report</field>
        <field name="model">parking.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">parking_management.report_parking_contracts_summary</field>
        <field name="report_file">parking_contracts_summary</field>
        <field name="binding_model_id" ref="model_parking_contract"/>
        <field name="binding_type">report</field>
        <field name="multi">True</field>
        <field name="paperformat_id" ref="paperformat_parking_a4_landscape"/>
        <field name="print_report_name">'Contracts-Summary'</field>
    </record>

    <record id="action_report_parking_vehicles_registry" model="ir.actions.report">
        <field name="name">Vehicles Registry Report</field>
        <field name="model">parking.vehicle</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">parking_management.report_parking_vehicles_registry</field>
        <field name="report_file">parking_vehicles_registry</field>
        <field name="binding_model_id" ref="model_parking_vehicle"/>
        <field name="binding_type">report</field>
        <field name="multi">True</field>
        <field name="paperformat_id" ref="paperformat_parking_a4_landscape"/>
        <field name="print_report_name">'Vehicles-Registry'</field>
    </record>

    <record id="action_report_parking_services" model="ir.actions.report">
        <field name="name">Additional Services Report</field>
        <field name="model">parking.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">parking_management.report_parking_services</field>
        <field name="report_file">parking_services_report</field>
        <field name="binding_model_id" ref="model_parking_contract"/>
        <field name="binding_type">report</field>
        <field name="multi">True</field>
        <field name="paperformat_id" ref="paperformat_parking_a4_landscape"/>
        <field name="print_report_name">'Services-Report'</field>
    </record>

    <record id="action_report_parking_vehicle_movement" model="ir.actions.report">
        <field name="name">Vehicle Movement Report</field>
        <field name="model">parking.vehicle.movement</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">parking_management.report_parking_vehicle_movement_report</field>
        <field name="report_file">vehicle_movement_report</field>
        <field name="binding_model_id" ref="model_parking_vehicle_movement"/>
        <field name="binding_type">report</field>
        <field name="multi">True</field>
        <field name="paperformat_id" ref="paperformat_parking_a4_landscape"/>
        <field name="print_report_name">'Vehicle-Movements'</field>
    </record>

    <record id="action_report_parking_vehicle_movement_from_vehicle" model="ir.actions.report">
        <field name="name">Vehicle Movement Report</field>
        <field name="model">parking.vehicle</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">parking_management.report_parking_vehicle_movement_by_vehicle</field>
        <field name="report_file">vehicle_movement</field>
        <field name="binding_model_id" ref="model_parking_vehicle"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_parking_a4_landscape"/>
        <field name="print_report_name">'Vehicle-Movement-%s' % (object.license_plate or object.id)</field>
    </record>

    <delete id="action_report_parking_invoice" model="ir.actions.report"/>
    <delete id="report_parking_invoice" model="ir.ui.view"/>

    <!-- ============================================================ -->
    <!-- SPOTS SUMMARY (all selected spots on one report)             -->
    <!-- ============================================================ -->
    <template id="report_parking_spots_summary">
        <t t-call="web.html_container">
            <t t-set="o" t-value="docs[:1]"/>
            <t t-set="company" t-value="env.company"/>
            <t t-call="web.external_layout">
                <div class="page o_pm_doc">
                    <t t-call="parking_management.pm_title">
                        <t t-set="title">Parking Spots Summary</t>
                    </t>
                    <table class="o_pm_kpis o_ignore_layout_styling">
                        <tr>
                            <t t-call="parking_management.pm_kpi">
                                <t t-set="label">Available</t>
                                <t t-set="value" t-value="len(docs.filtered(lambda s: s.status == 'available'))"/>
                            </t>
                            <t t-call="parking_management.pm_kpi">
                                <t t-set="label">Reserved</t>
                                <t t-set="value" t-value="len(docs.filtered(lambda s: s.status == 'reserved'))"/>
                            </t>
                            <t t-call="parking_management.pm_kpi">
                                <t t-set="label">Occupied</t>
                                <t t-set="value" t-value="len(docs.filtered(lambda s: s.status == 'occupied'))"/>
                            </t>
                            <t t-call="parking_management.pm_kpi">
                                <t t-set="label">Total</t>
                                <t t-set="value" t-value="len(docs)"/>
                            </t>
                        </tr>
                    </table>
                    <t t-call="parking_management.pm_spots_table">
                        <t t-set="spots" t-value="docs"/>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- CONTRACTS SUMMARY                                            -->
    <!-- ============================================================ -->
    <template id="report_parking_contracts_summary">
        <t t-call="web.html_container">
            <t t-set="o" t-value="docs[:1]"/>
            <t t-set="company" t-value="env.company"/>
            <t t-call="web.external_layout">
                <div class="page o_pm_doc">
                    <t t-call="parking_management.pm_title">
                        <t t-set="title">Contracts Summary</t>
                    </t>
                    <t t-set="today" t-value="context_timestamp(datetime.datetime.now()).date()"/>
                    <table class="o_pm_kpis o_ignore_layout_styling">
                        <tr>
                            <t t-call="parking_management.pm_kpi">
                                <t t-set="label">Active</t>
                                <t t-set="value" t-value="len(docs.filtered(lambda c: c.state == 'active'))"/>
                            </t>
                            <t t-call="parking_management.pm_kpi">
                                <t t-set="label">Expiring within 30 days</t>
                                <t t-set="value" t-value="len(docs.filtered(lambda c: c.state == 'active' and c.end_date and 0 &lt;= (c.end_date - today).days &lt;= 30))"/>
                            </t>
                            <t t-call="parking_management.pm_kpi">
                                <t t-set="label">Expired</t>
                                <t t-set="value" t-value="len(docs.filtered(lambda c: c.state == 'expired'))"/>
                            </t>
                            <t t-call="parking_management.pm_kpi">
                                <t t-set="label">Total</t>
                                <t t-set="value" t-value="len(docs)"/>
                            </t>
                        </tr>
                    </table>
                    <t t-call="parking_management.pm_contracts_table">
                        <t t-set="contracts" t-value="docs"/>
                    </t>
                    <div class="o_pm_note">Amounts are per month (per booking for daily contracts); they exclude VAT and one-time services.</div>
                </div>
            </t>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- VEHICLES REGISTRY                                            -->
    <!-- ============================================================ -->
    <template id="report_parking_vehicles_registry">
        <t t-call="web.html_container">
            <t t-set="o" t-value="docs[:1]"/>
            <t t-set="company" t-value="env.company"/>
            <t t-call="web.external_layout">
                <div class="page o_pm_doc">
                    <t t-call="parking_management.pm_title">
                        <t t-set="title">Vehicles Registry</t>
                        <t t-set="subtitle"><t t-esc="len(docs)"/> vehicle(s)</t>
                    </t>
                    <t t-call="parking_management.pm_vehicles_table">
                        <t t-set="vehicles" t-value="docs"/>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- ADDITIONAL SERVICES                                          -->
    <!-- ============================================================ -->
    <template id="report_parking_services">
        <t t-call="web.html_container">
            <t t-set="o" t-value="docs[:1]"/>
            <t t-set="company" t-value="env.company"/>
            <t t-call="web.external_layout">
                <div class="page o_pm_doc">
                    <t t-call="parking_management.pm_title">
                        <t t-set="title">Additional Services</t>
                    </t>
                    <t t-call="parking_management.pm_services_table">
                        <t t-set="contracts" t-value="docs"/>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- ============================================================ -->
    <!-- VEHICLE MOVEMENTS (trips: delivered to the customer, returned) -->
    <!-- ============================================================ -->
    <template id="pm_movements_table">
        <table class="o_pm_table o_ignore_layout_styling">
            <thead>
                <tr>
                    <th>#</th><th>Reference</th>
                    <th t-if="show_vehicle">Vehicle</th><th t-if="show_vehicle">Customer</th>
                    <th>Type</th><th>Status</th><th>Spot</th>
                    <th>Delivered At</th><th>Delivered By</th>
                    <th>Returned At</th><th>Received By</th>
                    <th class="text-end">Duration</th><th class="text-end">Distance (km)</th>
                </tr>
            </thead>
            <tbody>
                <tr t-foreach="movements" t-as="m">
                    <td class="text-muted" t-esc="m_index + 1"/>
                    <td class="text-nowrap" t-esc="m.name"/>
                    <td t-if="show_vehicle" t-esc="m.vehicle_id.license_plate or '—'"/>
                    <td t-if="show_vehicle" t-esc="m.partner_id.display_name or '—'"/>
                    <td><span t-field="m.movement_type"/></td>
                    <td><span t-field="m.state"/></td>
                    <td t-esc="m.spot_id.name or '—'"/>
                    <td class="text-nowrap"><span t-if="m.check_out_time" t-field="m.check_out_time"/><t t-else="">—</t></td>
                    <td t-esc="m.operator_out_id.name or '—'"/>
                    <td class="text-nowrap"><span t-if="m.check_in_time" t-field="m.check_in_time"/><t t-else="">—</t></td>
                    <td t-esc="m.operator_in_id.name or '—'"/>
                    <td class="text-end text-nowrap">
                        <t t-if="m.duration_hours" t-esc="'%d:%02d' % (int(m.duration_hours), round((m.duration_hours % 1) * 60) % 60)"/>
                        <t t-else="">—</t>
                    </td>
                    <td class="text-end" t-esc="m.distance_km or '—'"/>
                </tr>
                <tr t-if="not movements"><td colspan="13" class="o_pm_empty">No movements recorded.</td></tr>
            </tbody>
        </table>
    </template>

    <template id="report_parking_vehicle_movement_report">
        <t t-call="web.html_container">
            <t t-set="o" t-value="docs[:1]"/>
            <t t-set="company" t-value="env.company"/>
            <t t-call="web.external_layout">
                <div class="page o_pm_doc">
                    <t t-call="parking_management.pm_title">
                        <t t-set="title">Vehicle Movements</t>
                        <t t-set="subtitle"><t t-esc="len(docs)"/> movement(s)</t>
                    </t>
                    <t t-call="parking_management.pm_movements_table">
                        <t t-set="movements" t-value="docs.sorted(lambda m: m.check_out_time or m.check_in_time or m.create_date)"/>
                        <t t-set="show_vehicle" t-value="True"/>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <template id="report_parking_vehicle_movement_by_vehicle">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page o_pm_doc">
                        <t t-call="parking_management.pm_title">
                            <t t-set="title">Vehicle Movements</t>
                            <t t-set="ref" t-value="o.license_plate"/>
                        </t>
                        <div class="o_pm_section">
                            <div class="o_pm_section_title">Vehicle</div>
                            <table class="o_pm_kv o_pm_kv4 o_ignore_layout_styling">
                                <tr>
                                    <td class="o_pm_k">License Plate</td><td class="fw-bold" t-esc="o.license_plate or '—'"/>
                                    <td class="o_pm_k">Owner</td><td t-esc="o.owner_id.display_name or '—'"/>
                                </tr>
                                <tr>
                                    <td class="o_pm_k">Brand / Model</td><td><t t-esc="o.brand or '—'"/> <t t-esc="o.model or ''"/></td>
                                    <td class="o_pm_k">Key Tag No.</td><td t-esc="o.key_tag or '—'"/>
                                </tr>
                            </table>
                        </div>
                        <t t-call="parking_management.pm_movements_table">
                            <t t-set="movements" t-value="o.movement_ids.sorted(lambda m: m.check_out_time or m.check_in_time or m.create_date)"/>
                            <t t-set="show_vehicle" t-value="False"/>
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
