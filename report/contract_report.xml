<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_parking_contract" model="ir.actions.report">
        <field name="name">Parking Contract</field>
        <field name="model">parking.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">parking_management.report_parking_contract</field>
        <field name="report_file">parking_management.report_parking_contract</field>
        <field name="binding_model_id" ref="model_parking_contract"/>
        <field name="binding_type">report</field>
        <field name="multi">False</field>
        <field name="print_report_name">'Parking-Contract-%s' % (object.name)</field>
    </record>

    <template id="report_parking_contract_document">
        <t t-call="web.external_layout">
            <t t-set="currency" t-value="o.company_currency_id"/>
            <div class="page o_pm_doc">
                <t t-call="parking_management.pm_title">
                    <t t-set="title">Parking Contract</t>
                    <t t-set="ref" t-value="o.name"/>
                </t>

                <table class="o_pm_cols o_ignore_layout_styling">
                    <tr>
                        <td>
                            <div class="o_pm_section">
                                <div class="o_pm_section_title">Customer</div>
                                <table class="o_pm_kv o_ignore_layout_styling">
                                    <tr><td class="o_pm_k">Name</td><td class="fw-bold" t-esc="o.partner_id.display_name"/></tr>
                                    <tr><td class="o_pm_k">ID / VAT Number</td>
                                        <td t-esc="o.partner_id.l10n_sa_additional_identification_number or o.partner_id.vat or '—'"/></tr>
                                    <tr><td class="o_pm_k">Phone</td><td><span class="o_force_ltr" t-esc="o.partner_id.phone or o.partner_id.mobile or '—'"/></td></tr>
                                    <tr><td class="o_pm_k">Email</td><td t-esc="o.partner_id.email or '—'"/></tr>
                                    <tr><td class="o_pm_k">Address</td>
                                        <td t-esc="', '.join(p for p in [o.partner_id.street, o.partner_id.city, o.partner_id.country_id.name] if p) or '—'"/></tr>
                                </table>
                            </div>
                        </td>
                        <td>
                            <div class="o_pm_section">
                                <div class="o_pm_section_title">Contract</div>
                                <table class="o_pm_kv o_ignore_layout_styling">
                                    <tr><td class="o_pm_k">Status</td><td><span t-field="o.state"/></td></tr>
                                    <tr><td class="o_pm_k">Subscription</td><td><span t-field="o.subscription_type"/></td></tr>
                                    <tr><td class="o_pm_k">From</td><td><span t-field="o.start_date"/></td></tr>
                                    <tr><td class="o_pm_k">To</td><td><span t-field="o.end_date"/></td></tr>
                                    <tr t-if="o.subscription_type != 'daily'"><td class="o_pm_k">Invoicing</td><td><span t-field="o.invoice_period"/></td></tr>
                                    <tr><td class="o_pm_k">Employee</td><td t-esc="o.user_id.name or '—'"/></tr>
                                </table>
                            </div>
                        </td>
                    </tr>
                </table>

                <div class="o_pm_section">
                    <div class="o_pm_section_title">Parking Spot and Vehicles</div>
                    <table class="o_pm_kv o_pm_kv4 o_ignore_layout_styling">
                        <tr>
                            <td class="o_pm_k">Branch</td><td t-esc="o.location_id.display_name or '—'"/>
                            <td class="o_pm_k">Spot</td><td class="fw-bold" t-esc="o.spot_id.name or '—'"/>
                        </tr>
                        <tr>
                            <td class="o_pm_k">Spot Type</td><td t-esc="o.spot_id.spot_type_id.name or '—'"/>
                            <td class="o_pm_k">Floor / Zone</td><td t-esc="o.spot_id.floor or '—'"/>
                        </tr>
                    </table>
                    <t t-call="parking_management.pm_vehicles_table">
                        <t t-set="vehicles" t-value="o.vehicle_ids"/>
                    </t>
                </div>

                <div class="o_pm_section">
                    <div class="o_pm_section_title">Fees</div>
                    <t t-set="daily" t-value="o.subscription_type == 'daily'"/>
                    <t t-set="rent" t-value="o._get_day_price() * o.booking_days if daily else o._get_month_price()"/>
                    <t t-set="recurring_lines" t-value="o.service_line_ids.filtered(lambda l: l.billing_type == 'recurring')"/>
                    <t t-set="once_lines" t-value="o.service_line_ids - recurring_lines"/>
                    <table class="o_pm_table o_ignore_layout_styling">
                        <thead>
                            <tr>
                                <th>Description</th><th>Billing</th>
                                <th class="text-end">Qty</th><th class="text-end">Unit Price</th><th class="text-end">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>
                                    <t t-if="daily">Parking rent (<t t-esc="o.booking_days"/> days)</t>
                                    <t t-else="">Parking rent</t>
                                </td>
                                <td>
                                    <t t-if="daily">Once</t>
                                    <t t-else="">Per month</t>
                                </td>
                                <td class="text-end" t-esc="o.booking_days if daily else 1"/>
                                <td class="text-end text-nowrap" t-esc="o._get_day_price() if daily else rent"
                                    t-options='{"widget": "monetary", "display_currency": currency}'/>
                                <td class="text-end text-nowrap" t-esc="rent"
                                    t-options='{"widget": "monetary", "display_currency": currency}'/>
                            </tr>
                            <tr t-foreach="recurring_lines" t-as="line">
                                <td t-esc="line.name"/>
                                <td>Per month</td>
                                <td class="text-end" t-esc="'%g' % line.quantity"/>
                                <td class="text-end text-nowrap"><span t-field="line.price_unit"
                                    t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                <td class="text-end text-nowrap"><span t-field="line.price_subtotal"/></td>
                            </tr>
                            <tr class="o_pm_subtotal">
                                <td colspan="4">
                                    <t t-if="daily">Booking total</t>
                                    <t t-else="">Monthly total</t>
                                </td>
                                <td class="text-end text-nowrap" t-esc="rent + sum(recurring_lines.mapped('price_subtotal'))"
                                    t-options='{"widget": "monetary", "display_currency": currency}'/>
                            </tr>
                            <t t-if="once_lines">
                                <tr t-foreach="once_lines" t-as="line">
                                    <td>
                                        <t t-esc="line.name"/>
                                        <span t-if="line.invoice_id" class="text-muted">(invoiced: <t t-esc="line.invoice_id.name"/>)</span>
                                    </td>
                                    <td>Once</td>
                                    <td class="text-end" t-esc="'%g' % line.quantity"/>
                                    <td class="text-end text-nowrap"><span t-field="line.price_unit"
                                        t-options='{"widget": "monetary", "display_currency": currency}'/></td>
                                    <td class="text-end text-nowrap"><span t-field="line.price_subtotal"/></td>
                                </tr>
                                <tr class="o_pm_subtotal">
                                    <td colspan="4">One-time charges</td>
                                    <td class="text-end text-nowrap" t-esc="sum(once_lines.mapped('price_subtotal'))"
                                        t-options='{"widget": "monetary", "display_currency": currency}'/>
                                </tr>
                            </t>
                            <tr t-if="o.deposit_amount">
                                <td colspan="4">Refundable deposit</td>
                                <td class="text-end text-nowrap"><span t-field="o.deposit_amount"/></td>
                            </tr>
                            <tr t-if="o.prepaid_until" class="o_pm_subtotal">
                                <td colspan="5">Remaining term paid in advance until <span t-field="o.prepaid_until"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <t t-set="taxes" t-value="o.tax_ids or o.company_id.account_sale_tax_id"/>
                    <div class="o_pm_section_body o_pm_note">
                        Amounts exclude VAT<t t-if="taxes"> (<t t-esc="', '.join(taxes.mapped('name'))"/>)</t>,
                        which is added on each invoice.
                    </div>
                </div>

                <div t-if="not is_html_empty(o.terms_conditions)" class="o_pm_section">
                    <div class="o_pm_section_title">Terms and Conditions</div>
                    <div class="o_pm_section_body o_pm_terms" t-field="o.terms_conditions"/>
                </div>

                <table class="o_pm_signatures o_ignore_layout_styling">
                    <tr>
                        <td>
                            <div class="o_pm_sign_line">
                                <img t-if="o.customer_signature" t-att-src="image_data_uri(o.customer_signature)"/>
                            </div>
                            <div class="o_pm_sign_label">Customer Signature</div>
                            <div class="o_pm_sign_name" t-esc="o.partner_id.display_name"/>
                            <div t-if="o.signature_date" class="o_pm_sign_name"><span t-field="o.signature_date"/></div>
                        </td>
                        <td>
                            <div class="o_pm_sign_line">
                                <img t-if="o.authorized_signature" t-att-src="image_data_uri(o.authorized_signature)"/>
                            </div>
                            <div class="o_pm_sign_label">Authorized Signature</div>
                            <div class="o_pm_sign_name" t-esc="o.company_id.name"/>
                        </td>
                    </tr>
                </table>
            </div>
        </t>
    </template>

    <template id="report_parking_contract">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="parking_management.report_parking_contract_document"/>
            </t>
        </t>
    </template>
</odoo>
