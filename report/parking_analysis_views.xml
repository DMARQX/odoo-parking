<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Analysis reports: every report opens on a pivot/graph and can switch to
         the underlying list, so users can drill down from a total to the records. -->

    <!-- ================= Contracts ================= -->
    <record id="parking_contract_analysis_pivot" model="ir.ui.view">
        <field name="name">parking.contract.analysis.pivot</field>
        <field name="model">parking.contract</field>
        <field name="arch" type="xml">
            <pivot string="Contract Analysis" sample="1">
                <field name="location_id" type="row"/>
                <field name="state" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="services_total" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="parking_contract_analysis_graph" model="ir.ui.view">
        <field name="name">parking.contract.analysis.graph</field>
        <field name="model">parking.contract</field>
        <field name="arch" type="xml">
            <graph string="Contract Analysis" type="bar" stacked="1" sample="1">
                <field name="start_date" interval="month"/>
                <field name="state"/>
                <field name="amount_total" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_parking_contract_analysis" model="ir.actions.act_window">
        <field name="name">Contract Analysis</field>
        <field name="res_model">parking.contract</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('parking_contract_analysis_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('parking_contract_analysis_graph')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No contracts yet</p>
            <p>Contract values by branch, status and month.</p>
        </field>
    </record>

    <record id="action_parking_contract_expiring" model="ir.actions.act_window">
        <field name="name">Expiring Contracts</field>
        <field name="res_model">parking.contract</field>
        <field name="view_mode">list,kanban,form</field>
        <field name="context">{'search_default_expiring_30': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No contract ends in the next 30 days</p>
            <p>Active and confirmed contracts that end soon, so they can be renewed in time.</p>
        </field>
    </record>

    <record id="action_parking_contract_unpaid" model="ir.actions.act_window">
        <field name="name">Contracts to Collect</field>
        <field name="res_model">parking.contract</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_unpaid_filter': 1, 'search_default_group_partner': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing to collect</p>
            <p>Contracts that still have something to invoice or an unpaid invoice.</p>
        </field>
    </record>

    <!-- ================= Revenue ================= -->
    <record id="parking_revenue_pivot" model="ir.ui.view">
        <field name="name">parking.revenue.pivot</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <pivot string="Parking Revenue" sample="1">
                <field name="parking_location_id" type="row"/>
                <field name="invoice_date" interval="month" type="col"/>
                <field name="amount_untaxed_signed" type="measure"/>
                <field name="amount_total_signed" type="measure"/>
                <field name="amount_residual_signed" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="parking_revenue_graph" model="ir.ui.view">
        <field name="name">parking.revenue.graph</field>
        <field name="model">account.move</field>
        <field name="arch" type="xml">
            <graph string="Parking Revenue" type="line" sample="1">
                <field name="invoice_date" interval="month"/>
                <field name="amount_total_signed" type="measure"/>
            </graph>
        </field>
    </record>
    <record id="action_parking_revenue_analysis" model="ir.actions.act_window">
        <field name="name">Revenue &amp; Collections</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="domain">[('parking_contract_id', '!=', False), ('move_type', 'in', ('out_invoice', 'out_refund')), ('state', '=', 'posted')]</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('parking_revenue_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('parking_revenue_graph')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No posted parking invoices yet</p>
            <p>Invoiced, collected and outstanding amounts by branch and month.</p>
        </field>
    </record>

    <!-- ================= Movements ================= -->
    <record id="parking_movement_analysis_pivot" model="ir.ui.view">
        <field name="name">parking.vehicle.movement.analysis.pivot</field>
        <field name="model">parking.vehicle.movement</field>
        <field name="arch" type="xml">
            <pivot string="Movement Analysis" sample="1">
                <field name="location_id" type="row"/>
                <field name="check_out_time" interval="month" type="col"/>
                <field name="duration_hours" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="parking_movement_analysis_graph" model="ir.ui.view">
        <field name="name">parking.vehicle.movement.analysis.graph</field>
        <field name="model">parking.vehicle.movement</field>
        <field name="arch" type="xml">
            <graph string="Movement Analysis" type="line" sample="1">
                <field name="check_out_time" interval="day"/>
                <field name="location_id"/>
            </graph>
        </field>
    </record>
    <record id="action_parking_movement_analysis" model="ir.actions.act_window">
        <field name="name">Movement Analysis</field>
        <field name="res_model">parking.vehicle.movement</field>
        <field name="view_mode">graph,pivot,list,form</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('parking_movement_analysis_graph')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('parking_movement_analysis_pivot')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No vehicle movements yet</p>
            <p>Daily check-outs and returns per branch, and how long vehicles stay out.</p>
        </field>
    </record>

    <!-- ================= Spot status history ================= -->
    <record id="parking_status_log_list" model="ir.ui.view">
        <field name="name">parking.spot.status.log.list</field>
        <field name="model">parking.spot.status.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="change_date"/>
                <field name="spot_id"/>
                <field name="location_id"/>
                <field name="old_status" widget="badge"/>
                <field name="new_status" widget="badge"/>
                <field name="operator_id" widget="many2one_avatar_user"/>
                <field name="contract_id" optional="show"/>
                <field name="reason" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="parking_status_log_search" model="ir.ui.view">
        <field name="name">parking.spot.status.log.search</field>
        <field name="model">parking.spot.status.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="spot_id"/>
                <field name="location_id"/>
                <field name="operator_id"/>
                <filter name="filter_change_date" string="Date" date="change_date"/>
                <group expand="0" string="Group By">
                    <filter name="group_location" string="Branch" context="{'group_by': 'location_id'}"/>
                    <filter name="group_new_status" string="New Status" context="{'group_by': 'new_status'}"/>
                    <filter name="group_operator" string="Operator" context="{'group_by': 'operator_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'change_date:day'}"/>
                </group>
            </search>
        </field>
    </record>
    <record id="parking_status_log_pivot" model="ir.ui.view">
        <field name="name">parking.spot.status.log.pivot</field>
        <field name="model">parking.spot.status.log</field>
        <field name="arch" type="xml">
            <pivot string="Spot Status History" sample="1">
                <field name="location_id" type="row"/>
                <field name="new_status" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="action_parking_status_log_analysis" model="ir.actions.act_window">
        <field name="name">Spot Status History</field>
        <field name="res_model">parking.spot.status.log</field>
        <field name="view_mode">list,pivot</field>
        <field name="search_view_id" ref="parking_status_log_search"/>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('parking_status_log_list')}),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('parking_status_log_pivot')})]"/>
    </record>

    <!-- ================= Car washes ================= -->
    <record id="parking_wash_analysis_pivot" model="ir.ui.view">
        <field name="name">parking.contract.wash.analysis.pivot</field>
        <field name="model">parking.contract.wash</field>
        <field name="arch" type="xml">
            <pivot string="Car Wash Analysis" sample="1">
                <field name="location_id" type="row"/>
                <field name="wash_date" interval="month" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="parking_wash_analysis_graph" model="ir.ui.view">
        <field name="name">parking.contract.wash.analysis.graph</field>
        <field name="model">parking.contract.wash</field>
        <field name="arch" type="xml">
            <graph string="Car Wash Analysis" type="bar" sample="1">
                <field name="washed_by"/>
                <field name="state"/>
            </graph>
        </field>
    </record>
    <record id="action_parking_wash_analysis" model="ir.actions.act_window">
        <field name="name">Car Wash Analysis</field>
        <field name="res_model">parking.contract.wash</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('parking_wash_analysis_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('parking_wash_analysis_graph')})]"/>
    </record>

    <!-- ================= Inspections ================= -->
    <record id="parking_inspection_line_analysis_pivot" model="ir.ui.view">
        <field name="name">parking.vehicle.inspection.line.analysis.pivot</field>
        <field name="model">parking.vehicle.inspection.line</field>
        <field name="arch" type="xml">
            <pivot string="Inspection Results" sample="1">
                <field name="checkpoint_id" type="row"/>
                <field name="result" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="parking_inspection_line_analysis_graph" model="ir.ui.view">
        <field name="name">parking.vehicle.inspection.line.analysis.graph</field>
        <field name="model">parking.vehicle.inspection.line</field>
        <field name="arch" type="xml">
            <graph string="Inspection Results" type="bar" stacked="1" sample="1">
                <field name="category"/>
                <field name="result"/>
            </graph>
        </field>
    </record>
    <record id="parking_inspection_line_analysis_list" model="ir.ui.view">
        <field name="name">parking.vehicle.inspection.line.analysis.list</field>
        <field name="model">parking.vehicle.inspection.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0">
                <field name="inspection_date"/>
                <field name="inspection_id"/>
                <field name="vehicle_id"/>
                <field name="checkpoint_id"/>
                <field name="category"/>
                <field name="result" widget="badge"
                       decoration-success="result == 'pass'" decoration-danger="result == 'fail'"/>
                <field name="notes" optional="show"/>
            </list>
        </field>
    </record>
    <record id="action_parking_inspection_analysis" model="ir.actions.act_window">
        <field name="name">Inspection Results</field>
        <field name="res_model">parking.vehicle.inspection.line</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('parking_inspection_line_analysis_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('parking_inspection_line_analysis_graph')}),
            (0, 0, {'view_mode': 'list', 'view_id': ref('parking_inspection_line_analysis_list')})]"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">No inspections recorded yet</p>
            <p>Which checkpoints fail most often, to spot recurring vehicle issues.</p>
        </field>
    </record>

    <!-- ================= Transfers ================= -->
    <record id="parking_transfer_analysis_pivot" model="ir.ui.view">
        <field name="name">parking.vehicle.transfer.analysis.pivot</field>
        <field name="model">parking.vehicle.transfer</field>
        <field name="arch" type="xml">
            <pivot string="Transfer Analysis" sample="1">
                <field name="transfer_type_id" type="row"/>
                <field name="state" type="col"/>
            </pivot>
        </field>
    </record>
    <record id="parking_transfer_analysis_graph" model="ir.ui.view">
        <field name="name">parking.vehicle.transfer.analysis.graph</field>
        <field name="model">parking.vehicle.transfer</field>
        <field name="arch" type="xml">
            <graph string="Transfer Analysis" type="bar" sample="1">
                <field name="driver_id"/>
                <field name="state"/>
            </graph>
        </field>
    </record>
    <record id="action_parking_transfer_analysis" model="ir.actions.act_window">
        <field name="name">Transfer Analysis</field>
        <field name="res_model">parking.vehicle.transfer</field>
        <field name="view_mode">pivot,graph,list,form</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('parking_transfer_analysis_pivot')}),
            (0, 0, {'view_mode': 'graph', 'view_id': ref('parking_transfer_analysis_graph')})]"/>
    </record>

    <!-- ================= Supplies ================= -->
    <record id="parking_stock_move_analysis_pivot" model="ir.ui.view">
        <field name="name">parking.branch.stock.move.analysis.pivot</field>
        <field name="model">parking.branch.stock.move</field>
        <field name="arch" type="xml">
            <pivot string="Supplies Consumption" sample="1">
                <field name="product_id" type="row"/>
                <field name="location_id" type="col"/>
                <field name="quantity" type="measure"/>
            </pivot>
        </field>
    </record>
    <record id="action_parking_stock_move_analysis" model="ir.actions.act_window">
        <field name="name">Supplies Consumption</field>
        <field name="res_model">parking.branch.stock.move</field>
        <field name="view_mode">pivot,list</field>
        <field name="context">{'create': False}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'pivot', 'view_id': ref('parking_stock_move_analysis_pivot')})]"/>
    </record>

    <!-- ================= Menus ================= -->
    <menuitem id="menu_parking_reports_operations" name="Operations Analysis" parent="menu_parking_reports" sequence="1"/>
    <menuitem id="menu_parking_report_contract_analysis" name="Contract Analysis" parent="menu_parking_reports_operations"
              action="action_parking_contract_analysis" sequence="10"/>
    <menuitem id="menu_parking_report_expiring" name="Expiring Contracts" parent="menu_parking_reports_operations"
              action="action_parking_contract_expiring" sequence="15"/>
    <menuitem id="menu_parking_report_movements" name="Movement Analysis" parent="menu_parking_reports_operations"
              action="action_parking_movement_analysis" sequence="20"/>
    <menuitem id="menu_parking_report_status_log" name="Spot Status History" parent="menu_parking_reports_operations"
              action="action_parking_status_log_analysis" sequence="25"/>
    <menuitem id="menu_parking_report_washes" name="Car Wash Analysis" parent="menu_parking_reports_operations"
              action="action_parking_wash_analysis" sequence="30"/>
    <menuitem id="menu_parking_report_inspections" name="Inspection Results" parent="menu_parking_reports_operations"
              action="action_parking_inspection_analysis" sequence="35"/>
    <menuitem id="menu_parking_report_transfers" name="Transfer Analysis" parent="menu_parking_reports_operations"
              action="action_parking_transfer_analysis" sequence="40"/>
    <menuitem id="menu_parking_report_supplies" name="Supplies Consumption" parent="menu_parking_reports_operations"
              action="action_parking_stock_move_analysis" sequence="45"
              groups="parking_management.group_parking_checkinout,parking_management.group_parking_config_pricing"/>

    <menuitem id="menu_parking_reports_finance" name="Finance" parent="menu_parking_reports" sequence="2"
              groups="parking_management.group_parking_invoicing"/>
    <menuitem id="menu_parking_report_revenue" name="Revenue &amp; Collections" parent="menu_parking_reports_finance"
              action="action_parking_revenue_analysis" sequence="10"/>
    <menuitem id="menu_parking_report_unpaid" name="Contracts to Collect" parent="menu_parking_reports_finance"
              action="action_parking_contract_unpaid" sequence="20"/>
</odoo>
