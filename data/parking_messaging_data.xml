<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Default customer messages. Off until a gateway is set up and the rule is switched on. -->
    <record id="notification_rule_vehicle_received" model="parking.notification.rule">
        <field name="name">Vehicle received</field>
        <field name="event">vehicle_received</field>
        <field name="active" eval="False"/>
        <field name="body">Dear {customer}, we received your vehicle {plate} at {branch}, spot {spot}. Thank you.</field>
    </record>
    <record id="notification_rule_vehicle_delivered" model="parking.notification.rule">
        <field name="name">Vehicle delivered</field>
        <field name="event">vehicle_delivered</field>
        <field name="active" eval="False"/>
        <field name="body">Dear {customer}, your vehicle {plate} has been delivered from {branch}. Drive safely.</field>
    </record>
    <record id="notification_rule_contract_activated" model="parking.notification.rule">
        <field name="name">Contract activated</field>
        <field name="event">contract_activated</field>
        <field name="active" eval="False"/>
        <field name="body">Dear {customer}, your parking contract {contract} is active until {end_date}. Spot: {spot}.</field>
    </record>
    <record id="notification_rule_contract_expiring" model="parking.notification.rule">
        <field name="name">Contract expiring</field>
        <field name="event">contract_expiring</field>
        <field name="active" eval="False"/>
        <field name="body">Dear {customer}, your parking contract {contract} ends in {days} day(s) on {end_date}. Contact us to renew.</field>
    </record>
    <record id="notification_rule_contract_expired" model="parking.notification.rule">
        <field name="name">Contract expired</field>
        <field name="event">contract_expired</field>
        <field name="active" eval="False"/>
        <field name="body">Dear {customer}, your parking contract {contract} ended on {end_date}. Contact us to renew.</field>
    </record>
    <record id="notification_rule_invoice_created" model="parking.notification.rule">
        <field name="name">Invoice issued</field>
        <field name="event">invoice_created</field>
        <field name="active" eval="False"/>
        <field name="body">Dear {customer}, invoice {invoice} of {amount} has been issued for contract {contract}.</field>
    </record>
    <record id="notification_rule_wash_done" model="parking.notification.rule">
        <field name="name">Car wash done</field>
        <field name="event">wash_done</field>
        <field name="active" eval="False"/>
        <field name="body">Dear {customer}, the car wash of your vehicle {plate} is done.</field>
    </record>

    <record id="ir_cron_parking_send_messages" model="ir.cron">
        <field name="name">Parking: Send Customer Messages</field>
        <field name="model_id" ref="model_parking_message_log"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_queued()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
