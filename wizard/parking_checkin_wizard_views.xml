<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="parking_checkin_checkout_wizard_form" model="ir.ui.view">
        <field name="name">parking.checkin.checkout.wizard.form</field>
        <field name="model">parking.checkin.checkout.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="operation" widget="radio" options="{'horizontal': True}"/>
                </group>
                <group string="Search" name="search_group">
                    <group>
                        <field name="partner_id" placeholder="Select owner..."
                               options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="vehicle_id" placeholder="Search license plate..."
                               options="{'no_create': True, 'no_create_edit': True}"/>
                    </group>
                </group>
                <div>
                    <button name="action_search" string="Search" type="object" class="btn-primary" icon="fa-search"/>
                </div>
                <group invisible="not search_done">
                    <field name="search_message" nolabel="1" invisible="vehicle_found"/>
                </group>
                <group string="Vehicles" invisible="not vehicle_found">
                    <field name="vehicle_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="license_plate"/>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="owner_id"/>
                        </list>
                    </field>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-success"
                            invisible="not vehicle_found"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_parking_checkin_wizard" model="ir.actions.act_window">
        <field name="name">Check In</field>
        <field name="res_model">parking.checkin.checkout.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_operation': 'check_in'}</field>
    </record>

    <record id="action_parking_checkout_wizard" model="ir.actions.act_window">
        <field name="name">Check Out</field>
        <field name="res_model">parking.checkin.checkout.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_operation': 'check_out'}</field>
    </record>


</odoo>
