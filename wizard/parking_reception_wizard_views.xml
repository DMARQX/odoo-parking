<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="parking_reception_wizard_form" model="ir.ui.view">
        <field name="name">parking.reception.wizard.form</field>
        <field name="model">parking.reception.wizard</field>
        <field name="arch" type="xml">
            <form string="Vehicle Reception / Delivery">
                <group>
                    <field name="step" readonly="1"/>
                </group>

                <!-- Step 1: Operation -->
                <group invisible="step != '1'">
                    <h3>Step 1: Operation</h3>
                    <field name="operation" widget="radio" options="{'horizontal': True}"/>
                </group>

                <!-- Step 2: Customer &amp; Vehicle -->
                <group invisible="step != '2'">
                    <h3>Step 2: Customer &amp; Vehicle</h3>
                    <group>
                        <field name="partner_id" options="{'no_create': True}"/>
                        <field name="vehicle_id" options="{'no_create_edit': True}"/>
                        <field name="contract_id" options="{'no_create': True}"/>
                        <field name="contract_found" invisible="1"/>
                    </group>
                </group>

                <!-- Step 3: Inspection -->
                <group invisible="step != '3'">
                    <h3>Step 3: Inspection</h3>
                    <group>
                        <field name="do_inspection"/>
                        <field name="inspection_notes" placeholder="Add inspection notes..."/>
                    </group>
                </group>

                <!-- Step 4: Spot -->
                <group invisible="step != '4'">
                    <h3>Step 4: Spot</h3>
                    <group>
                        <field name="spot_id" options="{'no_create': True}"/>
                    </group>
                </group>

                <!-- Step 5: Services -->
                <group invisible="step != '5'">
                    <h3>Step 5: Additional Services</h3>
                    <field name="service_line_ids" nolabel="1">
                        <list editable="bottom" create="1">
                            <field name="service_id" options="{'no_create': True}"/>
                            <field name="quantity"/>
                            <field name="price_unit"/>
                            <field name="price_subtotal" sum="Services Total"/>
                        </list>
                    </field>
                    <field name="services_total"/>
                </group>

                <!-- Step 6: Summary -->
                <group invisible="step != '6'">
                    <h3>Step 6: Summary</h3>
                    <group>
                        <field name="operation" readonly="1"/>
                        <field name="vehicle_id" readonly="1"/>
                        <field name="contract_id" readonly="1"/>
                        <field name="spot_id" readonly="1"/>
                        <field name="do_inspection" readonly="1"/>
                        <field name="services_total" readonly="1"/>
                    </group>
                </group>

                <footer>
                    <button name="action_back" string="Back" type="object" class="btn-secondary"
                            invisible="step == '1'"/>
                    <button name="action_next" string="Next" type="object" class="btn-primary"
                            invisible="step == '6'"/>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-success"
                            invisible="step != '6'"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_parking_reception_wizard" model="ir.actions.act_window">
        <field name="name">Vehicle Reception / Delivery</field>
        <field name="res_model">parking.reception.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="action_parking_checkin_wizard" model="ir.actions.act_window">
        <field name="name">Check In</field>
        <field name="res_model">parking.reception.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_operation': 'check_in'}</field>
    </record>

    <record id="action_parking_checkout_wizard" model="ir.actions.act_window">
        <field name="name">Check Out</field>
        <field name="res_model">parking.reception.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_operation': 'check_out'}</field>
    </record>

    <menuitem id="menu_parking_reception"
              name="Vehicle Reception / Delivery"
              parent="parking_management.menu_parking_operations"
              action="action_parking_reception_wizard"
              sequence="5"
              groups="base.group_user"/>

</odoo>