<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Wizard Form View -->
    <record id="parking_report_wizard_form" model="ir.ui.view">
        <field name="name">parking.report.wizard.form</field>
        <field name="model">parking.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Detailed Report">
                <group>
                    <group string="Filters">
                        <field name="branch_id"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                        <field name="contract_status"/>
                    </group>
                    <group string="Report Sections">
                        <field name="include_spots"/>
                        <field name="include_contracts"/>
                        <field name="include_vehicles"/>
                        <field name="include_services"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_comprehensive_report" string="Generate PDF Report" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_parking_detailed_report_wizard" model="ir.actions.act_window">
        <field name="name">Comprehensive Report</field>
        <field name="res_model">parking.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_parking_detailed_report" name="Comprehensive Report" parent="menu_parking_reports" action="action_parking_detailed_report_wizard" sequence="50"/>

    <record id="action_report_parking_comprehensive" model="ir.actions.report">
        <field name="name">Comprehensive Parking Report</field>
        <field name="model">parking.report.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">parking_management.report_parking_comprehensive</field>
        <field name="report_file">parking_comprehensive_report</field>
        <field name="binding_model_id" ref="model_parking_report_wizard"/>
        <field name="binding_type">report</field>
        <field name="multi">False</field>
        <field name="paperformat_id" ref="paperformat_parking_a4_landscape"/>
        <field name="print_report_name">'Comprehensive-Report'</field>
    </record>

    <!-- ============================================================ -->
    <!-- COMPREHENSIVE REPORT QWEB TEMPLATE -->
    <!-- ============================================================ -->

    <template id="report_parking_comprehensive">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-set="data" t-value="wizard._get_report_data()"/>
                <t t-set="o" t-value="wizard"/>
                <t t-set="company" t-value="env.company"/>
                <t t-call="web.external_layout">
                    <div class="page o_pm_doc">
                        <t t-call="parking_management.pm_title">
                            <t t-set="title">Comprehensive Parking Report</t>
                            <t t-set="subtitle">
                                <t t-esc="wizard.branch_id.display_name or ''"/><t t-if="not wizard.branch_id">All Branches</t>
                                <t t-if="wizard.date_from or wizard.date_to">
                                    · <span>From</span> <span t-if="wizard.date_from" t-field="wizard.date_from"/><t t-else="">—</t>
                                    <span>To</span> <span t-if="wizard.date_to" t-field="wizard.date_to"/><t t-else="">—</t>
                                </t>
                            </t>
                        </t>

                        <div t-if="data['include_spots']" class="o_pm_section">
                            <div class="o_pm_section_title">1. Parking Spots</div>
                            <div class="o_pm_section_body">
                                <table class="o_pm_kpis o_ignore_layout_styling">
                                    <tr>
                                        <t t-call="parking_management.pm_kpi">
                                            <t t-set="label">Available</t>
                                            <t t-set="value" t-value="data['available_count']"/>
                                        </t>
                                        <t t-call="parking_management.pm_kpi">
                                            <t t-set="label">Reserved</t>
                                            <t t-set="value" t-value="data['reserved_count']"/>
                                        </t>
                                        <t t-call="parking_management.pm_kpi">
                                            <t t-set="label">Occupied</t>
                                            <t t-set="value" t-value="data['occupied_count']"/>
                                        </t>
                                        <t t-call="parking_management.pm_kpi">
                                            <t t-set="label">Total</t>
                                            <t t-set="value" t-value="len(data['spots'])"/>
                                        </t>
                                    </tr>
                                </table>
                            </div>
                            <t t-call="parking_management.pm_spots_table">
                                <t t-set="spots" t-value="data['spots']"/>
                            </t>
                        </div>

                        <div t-if="data['include_contracts']" class="o_pm_section">
                            <div class="o_pm_section_title">2. Contracts</div>
                            <div class="o_pm_section_body">
                                <table class="o_pm_kpis o_ignore_layout_styling">
                                    <tr>
                                        <t t-call="parking_management.pm_kpi">
                                            <t t-set="label">Active</t>
                                            <t t-set="value" t-value="data['active_count']"/>
                                        </t>
                                        <t t-call="parking_management.pm_kpi">
                                            <t t-set="label">Expiring within 30 days</t>
                                            <t t-set="value" t-value="data['near_expiry_count']"/>
                                        </t>
                                        <t t-call="parking_management.pm_kpi">
                                            <t t-set="label">Expired</t>
                                            <t t-set="value" t-value="data['expired_count']"/>
                                        </t>
                                        <t t-call="parking_management.pm_kpi">
                                            <t t-set="label">Total</t>
                                            <t t-set="value" t-value="len(data['contracts'])"/>
                                        </t>
                                    </tr>
                                </table>
                            </div>
                            <t t-call="parking_management.pm_contracts_table">
                                <t t-set="contracts" t-value="data['contracts']"/>
                            </t>
                        </div>

                        <div t-if="data['include_vehicles']" class="o_pm_section">
                            <div class="o_pm_section_title">3. Vehicles (<t t-esc="data['total_vehicles']"/>)</div>
                            <t t-call="parking_management.pm_vehicles_table">
                                <t t-set="vehicles" t-value="data['vehicles']"/>
                            </t>
                        </div>

                        <div t-if="data['include_services']" class="o_pm_section">
                            <div class="o_pm_section_title">4. Additional Services</div>
                            <t t-call="parking_management.pm_services_table">
                                <t t-set="contracts" t-value="data['services_contracts']"/>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>