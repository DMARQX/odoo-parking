#: model:mail.template,body_html:parking_management.email_template_invoice_created
msgid ""
"<p>Dear {{ object.partner_id.name }},</p>\n"
"<p>An invoice has been generated for your parking contract.</p>\n"
"<p><b>Invoice:</b> {{ object.name }}</p>\n"
"<p><b>Date:</b> {{ object.invoice_date }}</p>\n"
"<p><b>Amount:</b> {{ object.amount_total }}</p>\n"
"<br/>\n"
"<p>Please make the payment at your earliest convenience.</p>\n"
"<p>Best regards,<br/>Parking Management</p>\n"
"        "
msgstr "<p>عزيزنا {{ object.partner_id.name }}،</p>\n<p>تم إصدار فاتورة لعقد المواقف الخاص بك.</p>\n<p><b>الفاتورة:</b> {{ object.name }}</p>\n<p><b>التاريخ:</b> {{ object.invoice_date }}</p>\n<p><b>المبلغ:</b> {{ object.amount_total }}</p>\n<br/>\n<p>نرجو السداد في أقرب وقت ممكن.</p>\n<p>مع أطيب التحيات،<br/>إدارة المواقف</p>\n        "

#. module: parking_management
#: model:mail.template,body_html:parking_management.email_template_contract_expiry
msgid ""
"<p>Dear {{ object.partner_id.name }},</p>\n"
"<p>This is a reminder that your parking contract <b>{{ object.name }}</b> will expire on <b>{{ object.end_date }}</b>.</p>\n"
"<p><b>Spot:</b> {{ object.spot_id.full_name }}</p>\n"
"<p><b>Subscription:</b> {{ object.subscription_type }}</p>\n"
"<p><b>Amount:</b> {{ object.amount_total }}</p>\n"
"<br/>\n"
"<p>Please contact us to renew your contract.</p>\n"
"<p>Best regards,<br/>Parking Management</p>\n"
"        "
msgstr "<p>عزيزنا {{ object.partner_id.name }}،</p>\n<p>نذكّرك بأن عقد المواقف الخاص بك <b>{{ object.name }}</b> سينتهي بتاريخ <b>{{ object.end_date }}</b>.</p>\n<p><b>الموقف:</b> {{ object.spot_id.full_name }}</p>\n<p><b>الاشتراك:</b> {{ object.subscription_type }}</p>\n<p><b>المبلغ:</b> {{ object.amount_total }}</p>\n<br/>\n<p>يرجى التواصل معنا لتجديد عقدك.</p>\n<p>مع أطيب التحيات،<br/>إدارة المواقف</p>\n        "

#. module: parking_management
#: model:mail.template,body_html:parking_management.email_template_contract_expired
msgid ""
"<p>Dear {{ object.partner_id.name }},</p>\n"
"<p>Your parking contract <b>{{ object.name }}</b> has expired on <b>{{ object.end_date }}</b>.</p>\n"
"<p>Please contact us immediately to renew or vacate the spot.</p>\n"
"<p>Best regards,<br/>Parking Management</p>\n"
"        "
msgstr "<p>عزيزنا {{ object.partner_id.name }}،</p>\n<p>انتهى عقد المواقف الخاص بك <b>{{ object.name }}</b> بتاريخ <b>{{ object.end_date }}</b>.</p>\n<p>يرجى التواصل معنا فوراً لتجديد العقد أو إخلاء الموقف.</p>\n<p>مع أطيب التحيات،<br/>إدارة المواقف</p>\n        "

