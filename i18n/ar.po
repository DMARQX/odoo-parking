"<p>Dear {{ object.partner_id.name }},</p>\n"
"<p>An invoice has been generated for your parking contract.</p>\n"
"<p><b>Invoice:</b> {{ object.name }}</p>\n"
"<p><b>Date:</b> {{ object.invoice_date }}</p>\n"
"<p><b>Amount:</b> {{ object.amount_total }}</p>\n"
"<br/>\n"
"<p>Please make the payment at your earliest convenience.</p>\n"
"<p>Best regards,<br/>Parking Management</p>\n"
"        "
msgstr ""
"<p>عزيزنا {{ object.partner_id.name }}،</p>\n"
"<p>تم إصدار فاتورة لعقد المواقف الخاص بك.</p>\n"
"<p><b>الفاتورة:</b> {{ object.name }}</p>\n"
"<p><b>التاريخ:</b> {{ object.invoice_date }}</p>\n"
"<p><b>المبلغ:</b> {{ object.amount_total }}</p>\n"
"<br/>\n"
"<p>نرجو السداد في أقرب وقت ممكن.</p>\n"
"<p>مع أطيب التحيات،<br/>إدارة المواقف</p>\n"
"        "

#. module: parking_management
